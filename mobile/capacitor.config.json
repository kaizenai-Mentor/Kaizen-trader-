{
  "appId": "com.kaizentrader.app",
  "appName": "KAIZEN",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "allowNavigation": [
      "localhost",
      "127.0.0.1",
      "10.0.2.2",
      "*.kaizentrader.xyz",
      "*.onrender.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0A0A0A",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0A"
    }
  }
}

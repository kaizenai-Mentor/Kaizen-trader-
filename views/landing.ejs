      Every trading session is an opportunity to improve. KAIZEN helps you make the most of it.
    </p>

    <!-- Early-User Beta Pipeline Card -->
    <div class="kl-mockup" style="max-width:560px;margin:0 auto;text-align:left;">
      <% if (typeof joined !== 'undefined' && joined) { %>
        <div style="text-align:center;padding:12px 0;">
          <div class="kl-eyebrow" style="margin-bottom:10px;">You're in the Beta Pipeline</div>
          <h3 style="font-size:1.35rem;margin:0 0 10px;">Welcome to KAIZEN Early Access<%= typeof joinedName !== 'undefined' && joinedName ? ', ' + joinedName : '' %>.</h3>
          <p style="font-size:0.94rem;line-height:1.7;color:rgba(244,248,251,0.78);margin:0 0 24px;">
            Your spot in our early-user testing cohort is recorded. Step straight inside to create your tester workspace and test KAIZEN.
          </p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/auth/register?username=<%= encodeURIComponent((typeof joinedName !== 'undefined' && joinedName) || '') %>&email=<%= encodeURIComponent((typeof joinedEmail !== 'undefined' && joinedEmail) || '') %>" class="kl-btn-gold kl-btn-lg">Start Testing KAIZEN Now &rarr;</a>
            <a href="/" class="kl-btn-blue kl-btn-lg">Visit Welcome Page</a>
          </div>
        </div>
      <% } else { %>
        <div class="kl-mockup-head" style="margin-bottom:18px;">
          <div>
            <div class="kl-mini-label" style="color:#F5C518;margin-bottom:4px;">Early Access Pipeline</div>
            <div style="font-family:'Sora',sans-serif;font-size:1.08rem;font-weight:600;">Join the KAIZEN Beta Cohort</div>
          </div>
          <span class="kl-beta-badge">Open for Testers</span>
        </div>

        <form action="/beta/join" method="POST" style="display:flex;flex-direction:column;gap:14px;">
          <div>
            <label for="beta-name" style="display:block;font-size:0.78rem;color:rgba(244,248,251,0.72);margin-bottom:6px;">Your Name or Trader Handle</label>
            <input id="beta-name" name="name" type="text" class="k-input" required placeholder="e.g. AlexTrader" style="border-radius:10px;">
          </div>

          <div>
            <label for="beta-email" style="display:block;font-size:0.78rem;color:rgba(244,248,251,0.72);margin-bottom:6px;">Email Address</label>
            <input id="beta-email" name="email" type="email" class="k-input" required placeholder="you@example.com" style="border-radius:10px;">
          </div>

          <div class="kl-mockup-grid">
            <div>
              <label for="beta-market" style="display:block;font-size:0.78rem;color:rgba(244,248,251,0.72);margin-bottom:6px;">Primary Market</label>
              <select id="beta-market" name="primaryMarket" class="k-input">
                <option value="Forex">Forex</option>
                <option value="Futures / Indices">Futures / Indices</option>
                <option value="Crypto">Crypto</option>
                <option value="Stocks / Options">Stocks / Options</option>
              </select>
            </div>
            <div>
              <label for="beta-stage" style="display:block;font-size:0.78rem;color:rgba(244,248,251,0.72);margin-bottom:6px;">Current Stage</label>
              <select id="beta-stage" name="stage" class="k-input">
                <option value="Starting Trader">Starting Trader</option>
                <option value="Learning Trader" selected>Learning Trader</option>
                <option value="Disciplined Trader">Disciplined Trader</option>
                <option value="Consistent Trader">Consistent Trader</option>
                <option value="Prop Firm Trader">Prop Firm Trader</option>
              </select>
            </div>
          </div>

          <button type="submit" class="kl-btn-gold kl-btn-lg" style="width:100%;margin-top:6px;cursor:pointer;">
            Join Beta
          </button>
        </form>
      <% } %>
    </div>
  </section>


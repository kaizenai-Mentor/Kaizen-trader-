  <script src="/js/app.js"></script>
  <script>
    if (window.feather) feather.replace();

    // Interactive Dashboard Showcase Tabs
    (function () {
      var tabs = document.querySelectorAll('[data-showcase-tab]');
      var panels = document.querySelectorAll('[data-showcase-panel]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-showcase-tab');
          tabs.forEach(function (t) {
            var active = t.getAttribute('data-showcase-tab') === target;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.classList.toggle('is-active', p.getAttribute('data-showcase-panel') === target);
          });
        });
      });

      // FAQ Accordion
      var faqBtns = document.querySelectorAll('[data-faq-toggle]');
      faqBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.kl-faq-item');
          if (!item) return;
          item.classList.toggle('is-open');
        });
      });
    })();
  </script>

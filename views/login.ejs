<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Sign In</title>
</head>
<body class="welcome-page" style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#080808;color:#F5F3EF;">

  <!-- Background glow -->
  <div style="position:fixed;top:20%;left:50%;transform:translateX(-50%);width:600px;height:400px;background:radial-gradient(ellipse,rgba(201,168,76,0.05),transparent 70%);pointer-events:none;"></div>

  <div style="width:100%;max-width:420px;position:relative;z-index:1;">

    <!-- Logo -->
    <div style="text-align:center;margin-bottom:40px;">
      <a href="/" style="text-decoration:none;display:inline-flex;flex-direction:column;align-items:center;gap:8px;">
        <div style="font-family:'DM Mono',monospace;font-size:2.5rem;color:var(--gold);font-weight:700;line-height:1;">改</div>
        <div style="font-family:'DM Mono',monospace;font-size:0.75rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--ash);">KAIZEN</div>
      </a>
      <p style="font-size:0.82rem;color:var(--ash);margin-top:12px;font-style:italic;">Trade Better. Every Day.</p>
    </div>

    <!-- Card -->
    <div style="background:var(--bg-card);border:1px solid rgba(201,168,76,0.18);padding:36px;">

      <div style="text-align:center;margin-bottom:28px;">
        <h1 style="font-size:1.3rem;font-weight:700;color:var(--text-primary);margin-bottom:6px;">Welcome back</h1>
        <p style="font-size:0.82rem;color:var(--ash);">Your discipline record is waiting.</p>
      </div>

      <!-- Google Login -->
      <a href="/auth/google" style="
        display:flex;align-items:center;justify-content:center;gap:10px;
        background:var(--bg-surface);
        border:1px solid var(--border);
        color:var(--text-primary);
        font-family:'DM Mono',monospace;
        font-size:0.65rem;
        letter-spacing:0.1em;
        text-transform:uppercase;
        padding:14px;
        text-decoration:none;
        margin-bottom:20px;
        transition:all 0.2s;
        width:100%;
        box-sizing:border-box;
      " onmouseover="this.style.borderColor='rgba(201,168,76,0.3)';this.style.color='var(--gold)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-primary)'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </a>

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="flex:1;height:1px;background:var(--border);"></div>
        <span style="font-family:'DM Mono',monospace;font-size:0.55rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);">or email</span>
        <div style="flex:1;height:1px;background:var(--border);"></div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="padding:12px 14px;background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.2);border-left:2px solid #F87171;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
          <i data-feather="alert-circle" width="13" height="13" style="color:#F87171;flex-shrink:0;"></i>
          <span style="font-size:0.82rem;color:#F87171;"><%= error %></span>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" style="display:flex;flex-direction:column;gap:14px;">

        <div>
          <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">
            <i data-feather="mail" width="10" height="10" style="display:inline;margin-right:4px;"></i>
            Email
          </label>
          <input type="email" name="email" required style="
            width:100%;background:var(--bg-surface);
            border:1px solid var(--border);color:var(--text-primary);
            font-family:'Outfit',sans-serif;font-size:0.9rem;
            padding:12px 14px;outline:none;box-sizing:border-box;
            transition:border-color 0.2s;
          " placeholder="your@email.com"
          onfocus="this.style.borderColor='rgba(201,168,76,0.4)'"
          onblur="this.style.borderColor='var(--border)'">
        </div>

        <div>
          <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">
            <i data-feather="lock" width="10" height="10" style="display:inline;margin-right:4px;"></i>
            Password
          </label>
          <input type="password" name="password" required style="
            width:100%;background:var(--bg-surface);
            border:1px solid var(--border);color:var(--text-primary);
            font-family:'Outfit',sans-serif;font-size:0.9rem;
            padding:12px 14px;outline:none;box-sizing:border-box;
            transition:border-color 0.2s;
          " placeholder="••••••••"
          onfocus="this.style.borderColor='rgba(201,168,76,0.4)'"
          onblur="this.style.borderColor='var(--border)'">
        </div>

        <button type="submit" style="
          width:100%;background:var(--gold);color:#000;
          border:none;font-family:'DM Mono',monospace;
          font-size:0.7rem;letter-spacing:0.15em;
          text-transform:uppercase;font-weight:700;
          padding:14px;cursor:pointer;
          display:flex;align-items:center;justify-content:center;gap:6px;
          transition:background 0.2s;margin-top:4px;
        " onmouseover="this.style.background='#E2C46A'" onmouseout="this.style.background='var(--gold)'">
          <i data-feather="arrow-right" width="13" height="13"></i>
          Sign In
        </button>

      </form>

      <div style="text-align:center;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
        <span style="font-size:0.82rem;color:var(--ash);">No account? </span>
        <a href="/auth/register" style="font-size:0.82rem;color:var(--gold);text-decoration:none;font-weight:600;">Create one free</a>
      </div>

    </div>

<!-- Theme toggle -->
<div style="position:fixed;top:16px;right:16px;z-index:100;">
  <button onclick="toggleTheme()" style="
    background:rgba(201,168,76,0.08);
    border:1px solid rgba(201,168,76,0.2);
    color:var(--gold);
    width:36px;height:36px;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;
  ">
    <i data-feather="sun" width="14" height="14" id="theme-icon"></i>
  </button>
</div>

    <!-- Bottom note -->
    <div style="text-align:center;margin-top:20px;">
      <p style="font-family:'DM Mono',monospace;font-size:0.55rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(168,160,154,0.35);">
        改善 · Discipline is the edge
      </p>
    </div>

  </div>

  <script>feather.replace();</script>
<script src="/js/app.js"></script>

</script>
</body>
</html>

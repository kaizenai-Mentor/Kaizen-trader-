<%
  // Dimension meters — V2 component (config/Design.js §7.2)
  // Usage: include('partials/k-meters', { meters: [['Process', 91], ['Risk', 89], ...] })
  var kItems = typeof meters !== 'undefined' ? meters : [];
%>
<div class="k-meters">
  <% kItems.forEach(function (m) { %>
    <div class="k-meter" data-meter="<%= m[1] %>">
      <span class="k-meter-label"><%= m[0] %></span>
      <span class="k-meter-track"><span class="k-meter-fill"></span></span>
      <span class="k-meter-value"><%= m[1] %></span>
    </div>
  <% }); %>
</div>

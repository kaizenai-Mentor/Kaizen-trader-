<footer class="footer">
  <div class="footer-inner">
    <span class="footer-logo">改 KAIZEN</span>
    <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:center;">
      <a href="/privacy" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('footer.privacy') %></a>
      <a href="/terms" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('footer.terms') %></a>
      <a href="/about" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('nav.about') %></a>
      <a href="/whitepaper" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('nav.whitepaper') %></a>
      <a href="/help" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('nav.helpCenter') %></a>
      <a href="/support" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--ash)'"><%= t('nav.support') %></a>
    </div>
    <span class="footer-right"><%= t('footer.rights') %></span>
  </div>
</footer>
<script>if (window.feather) feather.replace();</script>

<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/images/kaizen-icon.png" type="image/png">
<link rel="apple-touch-icon" href="/images/kaizen-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<script src="/js/feather.min.js"></script>
<script>
  // KAIZEN custom icon: "brain" for Psychology. Feather ships no brain glyph,
  // so it is registered here in the same stroke style as the rest of the set
  // (paths from the ISC-licensed lucide brain icon) and renders through the
  // normal data-feather="brain" mechanism. Must run before feather.replace().
  (function () {
    try {
      if (!window.feather || !feather.icons || !feather.icons.activity) return;
      var Icon = feather.icons.activity.constructor;
      feather.icons.brain = new Icon('brain',
        '<path d="M12 18V5"/>' +
        '<path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"/>' +
        '<path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"/>' +
        '<path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"/>' +
        '<path d="M18 18a4 4 0 0 0 2-7.464"/>' +
        '<path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"/>' +
        '<path d="M6 18a4 4 0 0 1-2-7.464"/>' +
        '<path d="M6.003 5.125a4 4 0 0 0-2.526 5.77"/>');
    } catch (e) { /* brain icon unavailable: Psychology links still work */ }
  })();
</script>
<script>
  // Apply saved theme BEFORE first paint to avoid a flash of the wrong theme
  (function () {
    try {
      var t = localStorage.getItem('kaizen-theme');
      if (!t) {
        t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)
          ? 'light' : 'dark';
      }
      if (t !== 'dark' && t !== 'light') t = 'dark';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>

<script>
(function(){try{var u=new URL(window.location.href);if(u.searchParams.has('wallet')){u.searchParams.delete('wallet');window.history.replaceState({},document.title,u.toString());}}catch(e){}})();
</script>

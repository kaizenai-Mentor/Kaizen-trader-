<!-- POPUP OVERLAY -->
<div class="popup-overlay" id="popupOverlay" onclick="closePopup()"></div>

<!-- SIDE POPUP MENU -->
<div class="nav-popup" id="navPopup">
  <div class="popup-header">
    <span class="popup-logo">改 KAIZEN</span>
    <button class="popup-close" onclick="closePopup()">×</button>
  </div>

  <% if (user) { %>
    <!-- IMPROVE -->
    <div class="popup-section">
      <div class="popup-section-label">Improve</div>
      <a href="/dashboard" class="popup-item"><span class="popup-item-icon"><i data-feather="activity" width="14" height="14"></i></span> Cockpit</a>
      <a href="/dashboard/sessions" class="popup-item"><span class="popup-item-icon"><i data-feather="list" width="14" height="14"></i></span> Sessions</a>
      <a href="/leaderboard" class="popup-item"><span class="popup-item-icon"><i data-feather="trending-up" width="14" height="14"></i></span> My Progress</a>
    </div>

    <!-- COACH -->
    <div class="popup-section">
      <div class="popup-section-label">Coach</div>
      <a href="/kaizen-ai" class="popup-item"><span class="popup-item-icon"><i data-feather="message-circle" width="14" height="14"></i></span> KAIZEN AI</a>
      <a href="/psychology" class="popup-item"><span class="popup-item-icon"><i data-feather="heart" width="14" height="14"></i></span> Psychology</a>
      <a href="/memories" class="popup-item"><span class="popup-item-icon"><i data-feather="book-open" width="14" height="14"></i></span> Memories</a>
    </div>

    <!-- TOOLS -->
    <div class="popup-section">
      <div class="popup-section-label">Tools</div>
      <a href="/chart" class="popup-item"><span class="popup-item-icon"><i data-feather="bar-chart-2" width="14" height="14"></i></span> Chart</a>
      <a href="/weekly-summary" class="popup-item"><span class="popup-item-icon"><i data-feather="file-text" width="14" height="14"></i></span> Weekly Report</a>
      <a href="/news" class="popup-item"><span class="popup-item-icon"><i data-feather="globe" width="14" height="14"></i></span> Market News</a>
    </div>

    <!-- IDENTITY -->
    <div class="popup-section">
      <div class="popup-section-label">Identity</div>
      <a href="/za/reputation/<%= user.id %>" class="popup-item"><span class="popup-item-icon"><i data-feather="link" width="14" height="14"></i></span> Wallets &amp; Verification</a>
    </div>

    <!-- SETTINGS -->
    <div class="popup-section">
      <div class="popup-section-label">Settings</div>
      <a href="/settings/trading-system" class="popup-item"><span class="popup-item-icon"><i data-feather="sliders" width="14" height="14"></i></span> My Trading System</a>
    </div>

    <!-- INFO -->
    <div class="popup-section">
      <div class="popup-section-label">Info</div>
      <a href="/support" class="popup-item">
        <span class="popup-item-icon"><i data-feather="life-buoy" width="14" height="14"></i></span> Support
      </a>
      <a href="/about" class="popup-item">
        <span class="popup-item-icon"><i data-feather="info" width="14" height="14"></i></span> About Kaizen
      </a>
      <a href="/whitepaper" class="popup-item">
        <span class="popup-item-icon"><i data-feather="book" width="14" height="14"></i></span> Whitepaper
      </a>
      <a href="/services" class="popup-item">
        <span class="popup-item-icon"><i data-feather="grid" width="14" height="14"></i></span> Services
      </a>
      <a href="/help" class="popup-item">
        <span class="popup-item-icon"><i data-feather="help-circle" width="14" height="14"></i></span> Help Center
      </a>
    </div>

    <div class="popup-section">
      <a href="/auth/logout" class="popup-item" style="color:var(--red);">
        <span class="popup-item-icon"><i data-feather="log-out" width="14" height="14"></i></span> Log Out
      </a>
    </div>

    <!-- USER FOOTER -->
    <div class="popup-footer">
      <div class="popup-user">
        <div class="popup-avatar">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="popup-username"><%= user.username %></div>
          <div class="popup-user-email"><%= user.email %></div>
        </div>
      </div>
      <div class="popup-socials">
        <a href="https://x.com/kaizenaibot"
          target="_blank" class="popup-social-link" title="X (Twitter)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

  <% } else { %>
    <!-- NOT LOGGED IN -->
    <div class="popup-section">
      <div class="popup-section-label">Get Started</div>
    </div>
    <div class="popup-auth-btns">
      <a href="/auth/login" class="btn-primary btn-full">Log In</a>
      <a href="/auth/register" class="btn-outline btn-full">Sign Up</a>
    </div>

    <div class="popup-section">
      <div class="popup-section-label">Info</div>
      <a href="/about" class="popup-item">
        <span class="popup-item-icon"><i data-feather="info" width="14" height="14"></i></span> About Kaizen
      </a>
      <a href="/whitepaper" class="popup-item">
        <span class="popup-item-icon"><i data-feather="book" width="14" height="14"></i></span> Whitepaper
      </a>
      <a href="/services" class="popup-item">
        <span class="popup-item-icon"><i data-feather="grid" width="14" height="14"></i></span> Services
      </a>
      <a href="/help" class="popup-item">
        <span class="popup-item-icon"><i data-feather="help-circle" width="14" height="14"></i></span> Help Center
      </a>
    </div>
  <% } %>
</div>

<!-- MAIN NAVBAR -->
<nav class="navbar">
  <a href="<%= user ? '/dashboard' : '/' %>" class="nav-logo">改 KAIZEN</a>
  <div class="nav-right">
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
      <span id="themeIcon">◐</span>
    </button>
    <button class="three-dot-btn" onclick="togglePopup()" title="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<%- include('ticker') %>

<!-- SECURITY MODAL -->
<div class="modal-overlay" id="securityModal">
  <div class="modal">
    <div class="modal-header">
      <h3>Security</h3>
      <button class="modal-close" onclick="closeModal('securityModal')">×</button>
    </div>
    <div class="modal-body">
      <div class="security-section">
        <h4>Change Password</h4>
        <form action="/auth/change-password" method="POST"
          style="display:flex;flex-direction:column;gap:12px;">
          <div class="form-group">
            <label class="form-label">Current Password</label>
            <input type="password" name="currentPassword"
              class="form-input" placeholder="Enter current Password">
          </div>
          <div class="form-group">
            <label class="form-label">New Password</label>
            <input type="password" name="newPassword"
              class="form-input" placeholder="Enter New Password">
          </div>
          <div class="form-group">
            <label class="form-label">Confirm Password</label>
            <input type="password" name="confirmPassword"
              class="form-input" placeholder="Confirm New Password">
          </div>
          <button type="submit" class="btn-primary">Update Password</button>
        </form>
      </div>
      <div class="security-section" style="margin-top:24px;padding-top:24px;border-top:1px solid var(--border);">
        <h4>Two-Factor Authentication</h4>
        <p style="font-size:0.85rem;color:var(--ash);margin-bottom:14px;">
          Add an extra layer of security to your account.
        </p>
        <button class="btn-outline btn-full">Enable 2FA — Coming Soon</button>
      </div>
    </div>
  </div>
</div>

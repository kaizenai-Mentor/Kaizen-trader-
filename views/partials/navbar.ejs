<!-- POPUP OVERLAY -->
<div class="popup-overlay" id="popupOverlay" onclick="closePopup()"></div>

<!-- SIDE POPUP MENU -->
<div class="nav-popup" id="navPopup">
  <div class="popup-header">
    <span class="popup-logo">改 KAIZEN</span>
    <button class="popup-close" onclick="closePopup()">×</button>
  </div>

  <% if (user) { %>
    <!-- IMPROVE -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.improve') %></div>
      <a href="/dashboard" class="popup-item"><span class="popup-item-icon"><i data-feather="activity" width="14" height="14"></i></span> <%= t('nav.cockpit') %></a>
      <a href="/dashboard/sessions" class="popup-item"><span class="popup-item-icon"><i data-feather="list" width="14" height="14"></i></span> <%= t('nav.sessions') %></a>
      <a href="/leaderboard" class="popup-item"><span class="popup-item-icon"><i data-feather="trending-up" width="14" height="14"></i></span> <%= t('nav.myProgress') %></a>
    </div>

    <!-- COACH -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.coach') %></div>
      <a href="/kaizen-ai" class="popup-item"><span class="popup-item-icon"><i data-feather="message-circle" width="14" height="14"></i></span> <%= t('nav.kaizenAI') %></a>
      <a href="/psychology" class="popup-item"><span class="popup-item-icon"><i data-feather="brain" width="14" height="14"></i></span> <%= t('nav.psychology') %></a>
      <a href="/improve" class="popup-item"><span class="popup-item-icon"><i data-feather="target" width="14" height="14"></i></span> <%= t('nav.improve') %></a>
      <a href="/goals" class="popup-item"><span class="popup-item-icon"><i data-feather="check-circle" width="14" height="14"></i></span> <%= t('nav.goals') %></a>
      <a href="/memories" class="popup-item"><span class="popup-item-icon"><i data-feather="book-open" width="14" height="14"></i></span> <%= t('nav.memories') %></a>
    </div>

    <!-- TOOLS -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.tools') %></div>
      <a href="/chart" class="popup-item"><span class="popup-item-icon"><i data-feather="bar-chart-2" width="14" height="14"></i></span> <%= t('nav.chart') %></a>
      <a href="/weekly-summary" class="popup-item"><span class="popup-item-icon"><i data-feather="file-text" width="14" height="14"></i></span> <%= t('nav.weekly') %></a>
      <a href="/news" class="popup-item"><span class="popup-item-icon"><i data-feather="globe" width="14" height="14"></i></span> <%= t('nav.news') %></a>
    </div>

    <!-- IDENTITY -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.identity') %></div>
      <a href="/za/reputation/<%= user.id %>" class="popup-item"><span class="popup-item-icon"><i data-feather="award" width="14" height="14"></i></span> <%= t('nav.reputation') %></a>
    </div>

    <!-- SETTINGS -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.settings') %></div>
      <a href="/settings/trading-system" class="popup-item"><span class="popup-item-icon"><i data-feather="sliders" width="14" height="14"></i></span> <%= t('nav.system') %></a>
    </div>

    <!-- INFO -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.info') %></div>
      <a href="/support" class="popup-item">
        <span class="popup-item-icon"><i data-feather="life-buoy" width="14" height="14"></i></span> <%= t('nav.support') %>
      </a>
      <a href="/about" class="popup-item">
        <span class="popup-item-icon"><i data-feather="info" width="14" height="14"></i></span> <%= t('nav.about') %>
      </a>
      <a href="/whitepaper" class="popup-item">
        <span class="popup-item-icon"><i data-feather="book" width="14" height="14"></i></span> <%= t('nav.whitepaper') %>
      </a>
      <a href="/services" class="popup-item">
        <span class="popup-item-icon"><i data-feather="grid" width="14" height="14"></i></span> <%= t('nav.services') %>
      </a>
      <a href="/help" class="popup-item">
        <span class="popup-item-icon"><i data-feather="help-circle" width="14" height="14"></i></span> <%= t('nav.helpCenter') %>
      </a>
    </div>

    <!-- LANGUAGE (owner directive 13 Oct 2026) -->
    <div class="popup-section">
      <div style="padding:4px 14px 10px;">
      </div>
    </div>

    <div class="popup-section">
      <a href="/auth/logout" class="popup-item" style="color:var(--red);">
        <span class="popup-item-icon"><i data-feather="log-out" width="14" height="14"></i></span> <%= t('nav.logout') %>
      </a>
    </div>

    <!-- USER FOOTER -->
    <div class="popup-footer">
      <div class="popup-user">
        <div class="popup-avatar">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="popup-username"><%= user.username %></div>
          <div class="popup-user-email"><%= user.email %></div>
        </div>
      </div>
      <div class="popup-socials">
        <a href="https://x.com/kaizenaibot"
          target="_blank" class="popup-social-link" title="X (Twitter)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

  <% } else { %>
    <!-- NOT LOGGED IN -->
    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.getStarted') %></div>
    </div>
    <div class="popup-auth-btns">
      <a href="/auth/login" class="btn-primary btn-full"><%= t('nav.login') %></a>
      <a href="/auth/register" class="btn-outline btn-full"><%= t('nav.signup') %></a>
    </div>

    <!-- LANGUAGE (owner directive 13 Oct 2026) -->
    <div class="popup-section">
      <div style="padding:4px 14px 10px;">
      </div>
    </div>

    <div class="popup-section">
      <div class="popup-section-label"><%= t('nav.info') %></div>
      <a href="/about" class="popup-item">
        <span class="popup-item-icon"><i data-feather="info" width="14" height="14"></i></span> <%= t('nav.about') %>
      </a>
      <a href="/whitepaper" class="popup-item">
        <span class="popup-item-icon"><i data-feather="book" width="14" height="14"></i></span> <%= t('nav.whitepaper') %>
      </a>
      <a href="/services" class="popup-item">
        <span class="popup-item-icon"><i data-feather="grid" width="14" height="14"></i></span> <%= t('nav.services') %>
      </a>
      <a href="/help" class="popup-item">
        <span class="popup-item-icon"><i data-feather="help-circle" width="14" height="14"></i></span> <%= t('nav.helpCenter') %>
      </a>
    </div>
  <% } %>
</div>

<!-- MAIN NAVBAR -->
<nav class="navbar">
  <a href="<%= user ? '/dashboard' : '/' %>" class="nav-logo">改 KAIZEN</a>
  <div class="nav-right">
    <div class="nav-lang" style="margin-right:6px;display:flex;align-items:center;">
    </div>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
      <span id="themeIcon">◐</span>
    </button>
    <button class="three-dot-btn" onclick="togglePopup()" title="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<%- include('ticker') %>

<!-- SECURITY MODAL -->
<div class="modal-overlay" id="securityModal">
  <div class="modal">
    <div class="modal-header">
      <h3><%= t('nav.security') %></h3>
      <button class="modal-close" onclick="closeModal('securityModal')">×</button>
    </div>
    <div class="modal-body">
      <div class="security-section">
        <h4><%= t('nav.changePassword') %></h4>
        <form action="/auth/change-password" method="POST"
          style="display:flex;flex-direction:column;gap:12px;">
          <div class="form-group">
            <label class="form-label"><%= t('nav.currentPassword') %></label>
            <input type="password" name="currentPassword"
              class="form-input" placeholder="<%= t('nav.enterCurrentPassword') %>">
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('nav.newPassword') %></label>
            <input type="password" name="newPassword"
              class="form-input" placeholder="<%= t('nav.enterNewPassword') %>">
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('nav.confirmPassword') %></label>
            <input type="password" name="confirmPassword"
              class="form-input" placeholder="<%= t('nav.confirmNewPassword') %>">
          </div>
          <button type="submit" class="btn-primary"><%= t('nav.updatePassword') %></button>
        </form>
      </div>
      <div class="security-section" style="margin-top:24px;padding-top:24px;border-top:1px solid var(--border);">
        <h4><%= t('nav.twoFactor') %></h4>
        <p style="font-size:0.85rem;color:var(--ash);margin-bottom:14px;">
          <%= t('nav.2faBlurb') %>
        </p>
        <button class="btn-outline btn-full"><%= t('nav.enable2FA') %></button>
      </div>
    </div>
  </div>
</div>

<!-- Language switcher (owner directive 13 Oct 2026): on every page in the
     navbar, and on the onboarding bar. Sticky via cookie; stored values
     never change language. -->
<select class="k-input lang-switch" style="width:auto;padding:6px 30px 6px 10px;font-size:0.78rem;" onchange="document.cookie='kaizen_lang='+this.value+'; Path=/; Max-Age=31536000; SameSite=Lax'; location.reload();">
  <option value="en" <%= lang === 'en' ? 'selected' : '' %>>English</option>
  <option value="fr" <%= lang === 'fr' ? 'selected' : '' %>>Français</option>
  <option value="zh" <%= lang === 'zh' ? 'selected' : '' %>>中文</option>
  <option value="ja" <%= lang === 'ja' ? 'selected' : '' %>>日本語</option>
  <option value="af" <%= lang === 'af' ? 'selected' : '' %>>Afrikaans</option>
</select>

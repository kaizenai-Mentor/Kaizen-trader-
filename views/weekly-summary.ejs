<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Weekly Report</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow k-flow--wide">

    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow">TOOLS · 改</div>
        <h1 class="k-page-title">Weekly Report</h1>
        <p class="k-page-sub">Your week in one honest page — the last seven days, ending today.</p>
      </div>
      <div class="k-streakchip" title="Practice consistency — never trading performance">
        <span class="k-streak-flame">◆</span>
        <span class="k-streak-num"><%= streak %></span>
        <span class="k-streak-label">day streak</span>
      </div>
    </div>

    <!-- ═══ THE COACH'S LETTER ═══ -->
    <section class="k-card k-card--featured">
      <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span> THE WEEK, IN WORDS</div>
      <div class="k-legacyai"><%= letter %></div>
      <% if (!letterCached) { %>
        <div class="k-fieldhint">Written for this week — it updates when your week changes shape.</div>
      <% } %>
    </section>

    <% if (stats.total === 0) { %>

    <!-- ═══ HONEST EMPTY STATE ═══ -->
    <section class="k-card">
      <div class="k-panel-title">THIS WEEK'S SESSIONS</div>
      <div class="k-building">
        <span class="k-buildnum">改</span>
        <div>
          <div class="k-buildtitle">Zero sessions this week</div>
          <p class="k-buildtext">The record notices — without judging. A week without a session is information too. When you come back, start with a plan: even one.</p>
          <a class="k-btn k-btn-primary k-btn-sm" style="margin-top:10px;" href="/dashboard/sessions/new">Plan a session</a>
        </div>
      </div>
    </section>

    <% } else { %>

    <!-- ═══ SESSIONS THIS WEEK ═══ -->
    <section class="k-card">
      <div class="k-panel-title">THIS WEEK'S SESSIONS</div>
      <div class="k-typerow">
        <% ['LIVE','BACKTEST','STUDY'].forEach(function(t){ %>
          <div class="k-typecard-stat">
            <span class="k-type-tag k-type-<%= t.toLowerCase() %>"><%= t %></span>
            <span class="k-typecard-num"><%= stats.byType[t] %></span>
            <span class="k-typecard-cap">session<%= stats.byType[t] === 1 ? '' : 's' %></span>
          </div>
        <% }); %>
      </div>
      <div class="k-weekmeta">
        <span><%= stats.loopCompleted %> through the full loop</span>
        <span>·</span>
        <span><%= stats.loopOpen %> still open</span>
        <% if (stats.complianceRate != null) { %>
          <span>·</span>
          <span><%= stats.compliant %> of <%= stats.checked %> inside their rules</span>
        <% } %>
      </div>
      <div class="k-fieldhint">Compliance here is practice consistency — never trading performance.</div>
    </section>

    <% } %>

    <!-- ═══ SCORE MOVEMENT ═══ -->
    <% if (move) { %>
    <section class="k-card">
      <div class="k-panel-title">SCORE MOVEMENT — VS PRE-WEEK</div>
      <div class="k-scorerow">
        <span class="k-scorenum"><%= move.overall.now %></span>
        <div class="k-scoremeta">
          <% if (move.overall.same) { %>
            <span class="k-deltachip is-flat">first reading</span>
          <% } else if (move.overall.delta > 0) { %>
            <span class="k-deltachip is-up">▲ +<%= move.overall.delta %> this week</span>
          <% } else if (move.overall.delta < 0) { %>
            <span class="k-deltachip is-down">▼ <%= move.overall.delta %> this week</span>
          <% } else { %>
            <span class="k-deltachip is-flat">± 0 this week</span>
          <% } %>
          <span class="k-scoresub">From your score snapshots — measured, not re-guessed.</span>
        </div>
      </div>
      <div class="k-dimrows">
        <% ['process','risk','execution','behavior','learning'].forEach(function(k){ %>
          <% var d = move.dimensions[k]; %>
          <div class="k-dimrow">
            <span class="k-dimlabel"><%= dimensionLabels[k] %></span>
            <span class="k-dimval"><%= d.now != null ? d.now : '—' %></span>
            <% if (d.delta == null) { %>
              <span class="k-dimdelta is-flat">building</span>
            <% } else if (d.delta > 0) { %>
              <span class="k-dimdelta is-up">▲ +<%= d.delta %></span>
            <% } else if (d.delta < 0) { %>
              <span class="k-dimdelta is-down">▼ <%= d.delta %></span>
            <% } else { %>
              <span class="k-dimdelta is-flat">± 0</span>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
    <% } else { %>
    <section class="k-card">
      <div class="k-panel-title">SCORE MOVEMENT</div>
      <p class="k-emptyhint">No computed scores yet — the movement appears after your first sessions complete the loop.</p>
    </section>
    <% } %>

    <!-- ═══ MILESTONES THIS WEEK ═══ -->
    <section class="k-card">
      <div class="k-panel-title">MILESTONES THIS WEEK</div>
      <% if (earned.length) { %>
        <div class="k-badgegrid">
          <% earned.forEach(function(b){ %>
            <div class="k-badgecell">
              <span class="k-badgename"><%= b.name %></span>
              <span class="k-badgedate"><%= b.earnedAt ? new Date(b.earnedAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="k-emptyhint">No new milestones this week. They arrive with the work, not the clock.</p>
      <% } %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/v2-reveal.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.weekly') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow k-flow--wide">

    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow"><%= t('wk.eyebrow') %></div>
        <h1 class="k-page-title"><%= t('weekly.title') %></h1>
        <p class="k-page-sub"><%= t('wk.sub') %></p>
      </div>
      <div class="k-streakchip" title="Practice consistency — never trading performance">
        <span class="k-streak-flame">◆</span>
        <span class="k-streak-num"><%= streak %></span>
        <span class="k-streak-label"><%= t('dash.dayStreak') %></span>
      </div>
    </div>

    <!-- ═══ THE COACH'S LETTER ═══ -->
    <section class="k-card k-card--featured">
      <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span><%= t('wk.weekWords') %></div>
      <div class="k-legacyai"><%= letter %></div>
      <% if (!letterCached) { %>
        <div class="k-fieldhint"><%= t('wk.writtenFor') %></div>
      <% } %>
    </section>

    <% if (stats.total === 0) { %>

    <!-- ═══ HONEST EMPTY STATE ═══ -->
    <section class="k-card">
      <div class="k-panel-title"><%= t('wk.weekSessions') %></div>
      <div class="k-building">
        <span class="k-buildnum">改</span>
        <div>
          <div class="k-buildtitle"><%= t('wk.zero') %></div>
          <p class="k-buildtext"><%= t('wk.zeroNote') %></p>
          <a class="k-btn k-btn-primary k-btn-sm" style="margin-top:10px;" href="/dashboard/sessions/new"><%= t('dash.planSession') %></a>
        </div>
      </div>
    </section>

    <% } else { %>

    <!-- ═══ SESSIONS THIS WEEK ═══ -->
    <section class="k-card">
      <div class="k-panel-title"><%= t('wk.weekSessions') %></div>
      <div class="k-typerow">
        <% ['LIVE','BACKTEST','STUDY'].forEach(function(t){ %>
          <div class="k-typecard-stat">
            <span class="k-type-tag k-type-<%= t.toLowerCase() %>"><%= t %></span>
            <span class="k-typecard-num"><%= stats.byType[t] %></span>
            <span class="k-typecard-cap"><%= t('word.session') %><%= stats.byType[t] === 1 ? '' : 's' %></span>
          </div>
        <% }); %>
      </div>
      <div class="k-weekmeta">
        <span><%= stats.loopCompleted %><%= t('wk.throughLoop') %></span>
        <span>·</span>
        <span><%= stats.loopOpen %><%= t('wk.stillOpen') %></span>
        <% if (stats.complianceRate != null) { %>
          <span>·</span>
          <span><%= stats.compliant %><%= t('wk.of') %><%= stats.checked %><%= t('wk.insideRules') %></span>
        <% } %>
      </div>
      <div class="k-fieldhint"><%= t('wk.complianceNote') %></div>
    </section>

    <% } %>

    <!-- ═══ SCORE MOVEMENT ═══ -->
    <% if (move) { %>
    <section class="k-card">
      <div class="k-panel-title"><%= t('wk.scoreMove') %></div>
      <div class="k-scorerow">
        <span class="k-scorenum"><%= move.overall.now %></span>
        <div class="k-scoremeta">
          <% if (move.overall.same) { %>
            <span class="k-deltachip is-flat"><%= t('prog.firstReading') %></span>
          <% } else if (move.overall.delta > 0) { %>
            <span class="k-deltachip is-up">▲ +<%= move.overall.delta %><%= t('wk.thisWeek') %></span>
          <% } else if (move.overall.delta < 0) { %>
            <span class="k-deltachip is-down">▼ <%= move.overall.delta %><%= t('wk.thisWeek') %></span>
          <% } else { %>
            <span class="k-deltachip is-flat"><%= t('wk.flatWeek') %></span>
          <% } %>
          <span class="k-scoresub"><%= t('wk.snapshots') %></span>
        </div>
      </div>
      <div class="k-dimrows">
        <% ['process','risk','execution','behavior','learning'].forEach(function(k){ %>
          <% var d = move.dimensions[k]; %>
          <div class="k-dimrow">
            <span class="k-dimlabel"><%= dimensionLabels[k] %></span>
            <span class="k-dimval"><%= d.now != null ? d.now : '—' %></span>
            <% if (d.delta == null) { %>
              <span class="k-dimdelta is-flat"><%= t('prog.building') %></span>
            <% } else if (d.delta > 0) { %>
              <span class="k-dimdelta is-up">▲ +<%= d.delta %></span>
            <% } else if (d.delta < 0) { %>
              <span class="k-dimdelta is-down">▼ <%= d.delta %></span>
            <% } else { %>
              <span class="k-dimdelta is-flat">± 0</span>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
    <% } else { %>
    <section class="k-card">
      <div class="k-panel-title"><%= t('wk.scoreMove2') %></div>
      <p class="k-emptyhint"><%= t('wk.noScores') %></p>
    </section>
    <% } %>

    <!-- ═══ MILESTONES THIS WEEK ═══ -->
    <section class="k-card">
      <div class="k-panel-title"><%= t('wk.milestonesWeek') %></div>
      <% if (earned.length) { %>
        <div class="k-badgegrid">
          <% earned.forEach(function(b){ %>
            <div class="k-badgecell">
              <span class="k-badgename"><%= b.name %></span>
              <span class="k-badgedate"><%= b.earnedAt ? new Date(b.earnedAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="k-emptyhint"><%= t('wk.noMilestones') %></p>
      <% } %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/v2-reveal.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>

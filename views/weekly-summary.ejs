<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Weekly Summary</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <div>
        <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span>
          Weekly Review
        </div>
        <h1 style="font-size:1.6rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Weekly Summary</h1>
        <p style="font-size:0.82rem;color:var(--ash);font-style:italic;">Your discipline performance from the past 7 days.</p>
      </div>
      <a href="/dashboard" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);border:1px solid var(--border);padding:10px 16px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.color='var(--gold)';this.style.borderColor='rgba(201,168,76,0.3)'" onmouseout="this.style.color='var(--ash)';this.style.borderColor='var(--border)'">
        <i data-feather="arrow-left" width="12" height="12"></i>
        Dashboard
      </a>
    </div>

    <% if (typeof weekData !== 'undefined' && weekData) { %>

      <!-- WEEK SCORE HERO -->
      <div style="background:var(--bg-card);border:1px solid rgba(201,168,76,0.2);padding:28px;margin-bottom:16px;position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle,rgba(201,168,76,0.05),transparent 70%);pointer-events:none;"></div>

        <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);margin-bottom:16px;display:flex;align-items:center;gap:8px;">
          <i data-feather="calendar" width="12" height="12" style="color:var(--gold);"></i>
          Week of <%= weekData.weekStart || 'This Week' %>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:2px;margin-bottom:20px;">
          <div style="background:var(--bg-surface);border:1px solid rgba(201,168,76,0.15);padding:16px;text-align:center;">
            <div style="font-family:'DM Mono',monospace;font-size:2rem;font-weight:700;color:var(--gold);line-height:1;margin-bottom:4px;"><%= weekData.weekScore || 0 %>%</div>
            <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">Week Score</div>
          </div>
          <div style="background:var(--bg-surface);border:1px solid var(--border);padding:16px;text-align:center;">
            <div style="font-family:'DM Mono',monospace;font-size:2rem;font-weight:700;color:var(--text-primary);line-height:1;margin-bottom:4px;"><%= weekData.totalSessions || 0 %></div>
            <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">Sessions</div>
          </div>
          <div style="background:var(--bg-surface);border:1px solid var(--border);padding:16px;text-align:center;">
            <div style="font-family:'DM Mono',monospace;font-size:2rem;font-weight:700;color:#4ADE80;line-height:1;margin-bottom:4px;"><%= weekData.compliantSessions || 0 %></div>
            <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">Compliant</div>
          </div>
          <div style="background:var(--bg-surface);border:1px solid var(--border);padding:16px;text-align:center;">
            <div style="font-family:'DM Mono',monospace;font-size:2rem;font-weight:700;color:#F87171;line-height:1;margin-bottom:4px;"><%= weekData.violationSessions || 0 %></div>
            <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">Violations</div>
          </div>
        </div>

        <!-- Trend vs last week -->
        <% if (weekData.trendVsLastWeek !== undefined) { %>
          <div style="display:flex;align-items:center;gap:8px;padding:12px 14px;background:var(--bg-surface);border:1px solid var(--border);">
            <i data-feather="<%= weekData.trendVsLastWeek >= 0 ? 'trending-up' : 'trending-down' %>" width="14" height="14" style="color:<%= weekData.trendVsLastWeek >= 0 ? '#4ADE80' : '#F87171' %>;"></i>
            <span style="font-size:0.85rem;color:var(--text-primary);">
              <%= weekData.trendVsLastWeek >= 0 ? '+' : '' %><%= weekData.trendVsLastWeek %>% vs last week
            </span>
            <span style="font-family:'DM Mono',monospace;font-size:0.58rem;color:var(--ash);margin-left:auto;">
              <%= weekData.trendVsLastWeek >= 0 ? 'Improving' : 'Needs attention' %>
            </span>
          </div>
        <% } %>
      </div>

      <!-- WEEK SESSIONS -->
      <% if (weekData.sessions && weekData.sessions.length > 0) { %>
        <div style="margin-bottom:16px;">
          <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--ash);margin-bottom:12px;display:flex;align-items:center;gap:8px;">
            <i data-feather="list" width="12" height="12"></i>
            This Week's Sessions
          </div>
          <div style="display:flex;flex-direction:column;gap:2px;">
            <% weekData.sessions.forEach(function(session) { %>
              <div style="background:var(--bg-card);border:1px solid var(--border);border-left:2px solid <%= session.ruleCompliance ? 'rgba(52,211,153,0.4)' : 'rgba(248,113,113,0.4)' %>;padding:14px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:6px;min-width:100px;">
                  <i data-feather="<%= session.ruleCompliance ? 'check-circle' : 'x-circle' %>" width="13" height="13" style="color:<%= session.ruleCompliance ? '#4ADE80' : '#F87171' %>;"></i>
                  <span style="font-family:'DM Mono',monospace;font-size:0.72rem;font-weight:700;color:var(--text-primary);"><%= session.asset %></span>
                </div>
                <div style="flex:1;font-size:0.8rem;color:var(--ash);"><%= session.notes ? session.notes.substring(0,80) + '...' : '' %></div>
                <div style="display:flex;align-items:center;gap:10px;">
                  <span style="font-family:'DM Mono',monospace;font-size:0.65rem;font-weight:700;color:<%= session.sessionScore >= 70 ? '#4ADE80' : session.sessionScore >= 50 ? 'var(--gold)' : '#F87171' %>;"><%= session.sessionScore %>%</span>
                  <span style="font-family:'DM Mono',monospace;font-size:0.5rem;color:var(--ash);"><%= new Date(session.createdAt).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'}) %></span>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- AI WEEKLY INSIGHT -->
      <% if (weekData.aiInsight) { %>
        <div style="background:var(--bg-card);border:1px solid rgba(201,168,76,0.18);padding:24px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
            <div style="width:28px;height:28px;border:1px solid rgba(201,168,76,0.25);background:rgba(201,168,76,0.06);display:flex;align-items:center;justify-content:center;color:var(--gold);">
              <i data-feather="cpu" width="13" height="13"></i>
            </div>
            <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold);">改 KAIZEN Weekly Insight</div>
          </div>
          <div style="border-left:2px solid var(--gold);padding-left:16px;font-size:0.88rem;color:var(--ash-light);line-height:1.9;white-space:pre-wrap;"><%= weekData.aiInsight %></div>
        </div>
      <% } %>

    <% } else { %>

      <div style="background:var(--bg-card);border:1px solid var(--border);padding:80px 32px;text-align:center;">
        <div style="font-family:'DM Mono',monospace;font-size:4rem;color:rgba(201,168,76,0.1);margin-bottom:20px;">改</div>
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;">No weekly data yet</h2>
        <p style="font-size:0.88rem;color:var(--ash);max-width:380px;margin:0 auto 24px;line-height:1.8;">Log sessions throughout the week and your summary will appear here every Sunday.</p>
        <a href="/dashboard/journal" style="display:inline-flex;align-items:center;gap:6px;background:var(--gold);color:#000;font-family:'DM Mono',monospace;font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;padding:12px 24px;text-decoration:none;">
          <i data-feather="edit-3" width="13" height="13"></i>
          Log a Session
        </a>
      </div>

    <% } %>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>feather.replace();</script>
</body>
</html>

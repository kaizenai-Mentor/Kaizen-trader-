<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Market News</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>
  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Market News</h1>
        <p class="page-sub">Live financial news — Forex, Crypto, Stocks, Commodities</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <% if (news.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <p>News unavailable right now. Check back shortly.</p>
        </div>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:2px;">
        <% news.forEach(function(article) { %>
          <a href="<%= article.url %>" target="_blank" style="text-decoration:none;" rel="noopener">
            <div class="card" style="cursor:pointer;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.3)'" onmouseout="this.style.borderColor='var(--border)'">
              <div style="display:flex;gap:16px;align-items:flex-start;">

                <% if (article.image_url) { %>
                  <img src="<%= article.image_url %>"
                    style="width:80px;height:60px;object-fit:cover;flex-shrink:0;border:1px solid var(--border);"
                    onerror="this.style.display='none'">
                <% } %>

                <div style="flex:1;min-width:0;">
                  <div style="
                    display:flex;gap:8px;align-items:center;
                    margin-bottom:6px;flex-wrap:wrap;
                  ">
                    <% if (article.entities && article.entities.length > 0) { %>
                      <% article.entities.slice(0,3).forEach(function(entity) { %>
                        <span style="
                          font-family:'DM Mono',monospace;
                          font-size:0.55rem;letter-spacing:0.1em;
                          text-transform:uppercase;
                          padding:2px 7px;
                          background:rgba(59,130,246,0.08);
                          border:1px solid rgba(59,130,246,0.15);
                          color:var(--blue);
                        "><%= entity.symbol || entity.name %></span>
                      <% }); %>
                    <% } %>
                    <span style="
                      font-family:'DM Mono',monospace;
                      font-size:0.55rem;color:var(--ash);
                      letter-spacing:0.08em;
                    ">
                      <%= article.source || 'News' %>
                    </span>
                  </div>

                  <h3 style="
                    font-size:0.9rem;font-weight:700;
                    color:var(--text-primary);line-height:1.4;
                    margin-bottom:6px;
                  ">
                    <%= article.title %>
                  </h3>

                  <% if (article.description) { %>
                    <p style="
                      font-size:0.78rem;color:var(--text-secondary);
                      line-height:1.6;
                      display:-webkit-box;
                      -webkit-line-clamp:2;
                      -webkit-box-orient:vertical;
                      overflow:hidden;
                    ">
                      <%= article.description %>
                    </p>
                  <% } %>

                  <div style="
                    margin-top:8px;
                    font-family:'DM Mono',monospace;
                    font-size:0.58rem;color:var(--ash);
                    letter-spacing:0.08em;
                    display:flex;align-items:center;gap:8px;
                  ">
                    <%= article.published_at
                      ? new Date(article.published_at).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})
                      : '' %>
                    <span style="color:var(--gold);">Read →</span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>

  </main>
  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

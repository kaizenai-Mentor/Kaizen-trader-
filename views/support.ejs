<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Support</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>
  <main class="app-main">
    <div class="page-header">
      <div>
        <h1>Support</h1>
        <p class="page-sub">We are here to help</p>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;">
      <div class="card card-gold">
        <div class="card-header"><h2>Contact Us</h2></div>
        <form style="display:flex;flex-direction:column;gap:14px;">
          <div class="form-group">
            <label class="form-label">Your Name</label>
            <input type="text" class="form-input" placeholder="Dennis">
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" class="form-input" placeholder="you@example.com">
          </div>
          <div class="form-group">
            <label class="form-label">Issue</label>
            <select name="issue" class="form-input">
              <option value="Account issue">Account issue</option>
              <option value="Journal not loading">Journal not loading</option>
              <option value="Bounties not showing">Bounties not showing</option>
              <option value="Score not updating">Score not updating</option>
              <option value="Chart request">Chart request</option>
              <option value="Feature request">Feature request</option>
              <option value="Bug report">Bug report</option>
              <option value="Other">Other</option>
           </select>
          </div>
          <div class="form-group">
            <label class="form-label">Message</label>
            <textarea class="form-input form-textarea"
              placeholder="Describe your issue..."></textarea>
          </div>
          <button type="submit" class="btn-primary">Send Message</button>
        </form>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px;">
        <div class="card">
          <div class="card-header"><h2>FAQ</h2></div>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <div>
              <div style="font-weight:700;font-size:0.88rem;margin-bottom:4px;">How is my Discipline Score calculated?</div>
              <p style="font-size:0.82rem;color:var(--text-secondary);">Your score is based on rule compliance across all logged sessions. Each compliant session raises your score.</p>
            </div>
            <div style="border-top:1px solid var(--border);padding-top:14px;">
              <div style="font-weight:700;font-size:0.88rem;margin-bottom:4px;">What are ZA Bounties?</div>
              <p style="font-size:0.82rem;color:var(--text-secondary);">Zero Authority DAO bounties are on-chain challenges you can complete to earn STX rewards and reputation.</p>
            </div>
            <div style="border-top:1px solid var(--border);padding-top:14px;">
              <div style="font-weight:700;font-size:0.88rem;margin-bottom:4px;">When is the Chart module launching?</div>
              <p style="font-size:0.82rem;color:var(--text-secondary);">Chart analysis with real-time Bybit data is scheduled for Phase 2 development.</p>
            </div>
            <div style="border-top:1px solid var(--border);padding-top:14px;">
              <div style="font-weight:700;font-size:0.88rem;margin-bottom:4px;">How do I connect my ZA account?</div>
              <p style="font-size:0.82rem;color:var(--text-secondary);">Visit zeroauthoritydao.com to create your account, then use your ZA user ID in the Reputation section.</p>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h2>Community</h2></div>
          <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
            Join the Kaizen community on X for updates, tips, and announcements.
          </p>
          <a href="https://x.com/kaizenaibot" target="_blank" class="btn-primary btn-full">
             Follow on X
         </a>
        </div>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

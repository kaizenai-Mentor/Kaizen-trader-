<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Support</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <div>
        <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span>
          We're Here to Help
        </div>
        <h1 style="font-size:1.6rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Support</h1>
        <p style="font-size:0.82rem;color:var(--ash);font-style:italic;">Usually respond within 24 hours.</p>
      </div>
      <a href="/dashboard" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);border:1px solid var(--border);padding:10px 16px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.color='var(--gold)';this.style.borderColor='rgba(201,168,76,0.3)'" onmouseout="this.style.color='var(--ash)';this.style.borderColor='var(--border)'">
        <i data-feather="arrow-left" width="12" height="12"></i>
        Dashboard
      </a>
    </div>

    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:2px;" class="support-grid">

      <!-- CONTACT FORM -->
      <div style="background:var(--bg-card);border:1px solid rgba(201,168,76,0.18);padding:28px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
          <div style="width:28px;height:28px;border:1px solid rgba(201,168,76,0.25);background:rgba(201,168,76,0.06);display:flex;align-items:center;justify-content:center;color:var(--gold);">
            <i data-feather="mail" width="13" height="13"></i>
          </div>
          <div style="font-weight:700;font-size:0.95rem;color:var(--text-primary);">Send a Message</div>
        </div>

        <form style="display:flex;flex-direction:column;gap:16px;">
          <div>
            <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">Your Name</label>
            <input type="text" style="width:100%;background:var(--bg-surface);border:1px solid var(--border);color:var(--text-primary);font-family:'Outfit',sans-serif;font-size:0.9rem;padding:12px 14px;outline:none;box-sizing:border-box;transition:border-color 0.2s;" placeholder="Your name" onfocus="this.style.borderColor='rgba(201,168,76,0.4)'" onblur="this.style.borderColor='var(--border)'">
          </div>
          <div>
            <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">Email</label>
            <input type="email" style="width:100%;background:var(--bg-surface);border:1px solid var(--border);color:var(--text-primary);font-family:'Outfit',sans-serif;font-size:0.9rem;padding:12px 14px;outline:none;box-sizing:border-box;transition:border-color 0.2s;" placeholder="you@example.com" onfocus="this.style.borderColor='rgba(201,168,76,0.4)'" onblur="this.style.borderColor='var(--border)'">
          </div>
          <div>
            <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">Issue Type</label>
            <select style="width:100%;background:var(--bg-surface);border:1px solid var(--border);color:var(--text-primary);font-family:'Outfit',sans-serif;font-size:0.9rem;padding:12px 14px;outline:none;box-sizing:border-box;" onfocus="this.style.borderColor='rgba(201,168,76,0.4)'" onblur="this.style.borderColor='var(--border)'">
              <option>Account issue</option>
              <option>Journal not loading</option>
              <option>Bounties not showing</option>
              <option>Score not updating</option>
              <option>Chart request</option>
              <option>Feature request</option>
              <option>Bug report</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:6px;">Message</label>
            <textarea rows="5" style="width:100%;background:var(--bg-surface);border:1px solid var(--border);color:var(--text-primary);font-family:'Outfit',sans-serif;font-size:0.9rem;padding:12px 14px;outline:none;box-sizing:border-box;resize:none;line-height:1.6;transition:border-color 0.2s;" placeholder="Describe your issue..." onfocus="this.style.borderColor='rgba(201,168,76,0.4)'" onblur="this.style.borderColor='var(--border)'"></textarea>
          </div>
          <button type="submit" style="width:100%;background:var(--gold);color:#000;border:none;font-family:'DM Mono',monospace;font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;font-weight:700;padding:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background 0.2s;" onmouseover="this.style.background='#E2C46A'" onmouseout="this.style.background='var(--gold)'">
            <i data-feather="send" width="13" height="13"></i>
            Send Message
          </button>
        </form>
      </div>

      <!-- SIDEBAR -->
      <div style="display:flex;flex-direction:column;gap:2px;" class="support-sidebar">

        <div style="background:var(--bg-card);border:1px solid var(--border);padding:22px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <i data-feather="twitter" width="14" height="14" style="color:var(--gold);"></i>
            <span style="font-weight:700;font-size:0.85rem;color:var(--text-primary);">Direct on X</span>
          </div>
          <p style="font-size:0.8rem;color:var(--ash);line-height:1.7;margin-bottom:14px;">Fastest way to reach us. We're active daily.</p>
          <a href="https://x.com/kaizenaibot" target="_blank" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,168,76,0.25);padding:9px 16px;text-decoration:none;">
            @kaizenaibot
            <i data-feather="external-link" width="10" height="10"></i>
          </a>
        </div>

        <div style="background:var(--bg-card);border:1px solid var(--border);padding:22px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <i data-feather="help-circle" width="14" height="14" style="color:var(--gold);"></i>
            <span style="font-weight:700;font-size:0.85rem;color:var(--text-primary);">Help Center</span>
          </div>
          <p style="font-size:0.8rem;color:var(--ash);line-height:1.7;margin-bottom:14px;">Common questions answered instantly.</p>
          <a href="/help" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);border:1px solid var(--border);padding:9px 16px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.color='var(--gold)';this.style.borderColor='rgba(201,168,76,0.3)'" onmouseout="this.style.color='var(--ash)';this.style.borderColor='var(--border)'">
            Browse FAQs
            <i data-feather="arrow-right" width="10" height="10"></i>
          </a>
        </div>

        <div style="background:var(--bg-card);border:1px solid var(--border);padding:22px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <i data-feather="clock" width="14" height="14" style="color:var(--gold);"></i>
            <span style="font-weight:700;font-size:0.85rem;color:var(--text-primary);">Response Time</span>
          </div>
          <p style="font-size:0.8rem;color:var(--ash);line-height:1.7;margin:0;">We typically respond within 24 hours. Urgent issues are prioritized.</p>
        </div>

      </div>

    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>feather.replace();</script>
  <style>
    @media (max-width:700px) {
      .support-grid { grid-template-columns:1fr !important; }
    }
  </style>
</body>
</html>

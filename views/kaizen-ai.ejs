<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN AI</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Kaizen AI</h1>
        <p class="page-sub">Your AI discipline mentor. Responses appear here after each session.</p>
      </div>
      <a href="/memories" class="btn-outline">View Memories →</a>
    </div>

    <!-- BACKGROUND TEXT -->
    <div style="position:relative;">
      <div style="
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        font-family:var(--font-mono);
        font-size:clamp(0.6rem,1.5vw,0.8rem);
        letter-spacing:0.2em;
        text-transform:uppercase;
        color:rgba(201,168,76,0.08);
        text-align:center;
        pointer-events:none;
        white-space:nowrap;
        z-index:0;
      ">
        Go to Memories to access previous responses
      </div>

      <div class="card" style="min-height:500px;position:relative;z-index:1;">
        <div id="ai-response-area" style="
          display:flex;
          flex-direction:column;
          align-items:center;
          justify-content:center;
          min-height:460px;
          text-align:center;
          gap:20px;
        ">

          <!-- Default empty state -->
          <div id="ai-empty-state">
            <div style="
              font-family:var(--font-mono);
              font-size:3rem;
              color:rgba(201,168,76,0.15);
              margin-bottom:16px;
              line-height:1;
            ">改</div>
            <p style="
              font-size:0.95rem;
              color:var(--ash);
              max-width:400px;
              line-height:1.8;
              margin-bottom:8px;
            ">
              Log a session in My Journal and Kaizen AI will analyze it here.
            </p>
            <p style="
              font-family:var(--font-mono);
              font-size:0.65rem;
              letter-spacing:0.15em;
              text-transform:uppercase;
              color:rgba(201,168,76,0.3);
            ">
              Go to Memories to access previous responses
            </p>
            <a href="/dashboard/journal" class="btn-primary"
              style="margin-top:24px;display:inline-block;">
              Log a Session
            </a>
          </div>

          <!-- Response display — shown after journal submission -->
          <div id="ai-response-display"
            style="display:none;width:100%;text-align:left;">
          </div>

        </div>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    // Read response from URL params (set by journal submission)
    const urlParams = new URLSearchParams(window.location.search);
    const responseParam = urlParams.get('response');
    const sessionParam = urlParams.get('session');

    if (responseParam) {
      const aiText = decodeURIComponent(responseParam);
      const sessionText = decodeURIComponent(sessionParam || '');

      document.getElementById('ai-empty-state').style.display = 'none';
      const display = document.getElementById('ai-response-display');
      display.style.display = 'block';

      display.innerHTML = `
        <div style="
          border-left:2px solid var(--gold);
          padding:0 24px;
          margin-bottom:32px;
        ">
          <div style="
            font-family:var(--font-mono);
            font-size:0.62rem;
            letter-spacing:0.15em;
            text-transform:uppercase;
            color:var(--gold);
            margin-bottom:16px;
          ">改 Kaizen AI · Session Analysis</div>
          <div id="streaming-text" style="
            font-size:0.95rem;
            color:var(--ash-light);
            line-height:1.9;
            white-space:pre-wrap;
          "></div>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href="/memories" class="btn-outline">View All Memories →</a>
          <a href="/dashboard/journal" class="btn-primary">
            <span>Log Another Session</span>
          </a>
        </div>
      `;

      // Stream text
      const el = document.getElementById('streaming-text');
      let i = 0;

      function streamChar() {
        if (i < aiText.length) {
          el.textContent += aiText[i];
          i++;
          setTimeout(streamChar, 14);
        } else {
          // Auto-save to memories
          saveToMemories(sessionText, aiText);
          // Clean URL
          window.history.replaceState({}, '', '/kaizen-ai');
        }
      }

      streamChar();
    }

    async function saveToMemories(sessionData, response) {
      try {
        await fetch('/memories/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionData, response })
        });
      } catch(e) {}
    }
  </script>
</body>
</html>

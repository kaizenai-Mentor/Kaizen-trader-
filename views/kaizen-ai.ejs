<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN AI</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Kaizen AI</h1>
        <p class="page-sub">
          Your AI discipline mentor. Responses appear
          here after each session is logged.
        </p>
      </div>
      <a href="/memories" class="btn-outline">Memories →</a>
    </div>

    <div class="card" style="min-height:500px;position:relative;">

      <!-- Watermark -->
      <div style="
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        font-family:'DM Mono',monospace;
        font-size:clamp(0.55rem,1.2vw,0.72rem);
        letter-spacing:0.18em;
        text-transform:uppercase;
        color:rgba(201,168,76,0.05);
        text-align:center;
        pointer-events:none;
        white-space:nowrap;
        z-index:0;
        width:100%;
      ">
        Go to Memories to access previous responses
      </div>

      <!-- Content -->
      <div style="position:relative;z-index:1;">

        <% if (aiResponse) { %>
          <!-- AI Response Section -->
          <div style="
            border-left:2px solid var(--gold);
            padding-left:24px;
            margin-bottom:32px;
          ">
            <div style="
              font-family:'DM Mono',monospace;
              font-size:0.62rem;
              letter-spacing:0.15em;
              text-transform:uppercase;
              color:var(--gold);
              margin-bottom:20px;
              display:flex;
              align-items:center;
              gap:10px;
            ">
              <span>改 Kaizen AI</span>
              <span style="color:rgba(201,168,76,0.3);">·</span>
              <span>Session Analysis</span>
            </div>

            <div id="streaming-text" style="
              font-size:0.92rem;
              color:var(--ash-light);
              line-height:1.95;
              white-space:pre-wrap;
            "></div>
          </div>

          <div style="
            display:flex;
            gap:12px;
            flex-wrap:wrap;
            padding-top:20px;
            border-top:1px solid var(--border);
          ">
            <a href="/memories" class="btn-outline">
              View All Memories →
            </a>
            <a href="/dashboard/journal" class="btn-primary">
              <span>Log Another Session</span>
            </a>
          </div>

          <script>
  const rawText = <%- JSON.stringify(aiResponse) %>;
  const el = document.getElementById('streaming-text');
  let i = 0;

  function stream() {
    if (i < rawText.length) {
      // Add one character at a time
      const char = rawText[i];
      el.textContent += char;
      i++;

      // Variable speed — faster for spaces, slower for punctuation
      let delay = 12;
      if (char === '.' || char === '\n') delay = 80;
      else if (char === ',' || char === ':') delay = 40;
      else if (char === ' ') delay = 8;

      setTimeout(stream, delay);
    }
  }

  // Start after 300ms delay
  setTimeout(stream, 300);
</script>

        <% } else { %>
          <!-- Empty State -->
          <div style="
            display:flex;
            flex-direction:column;
            align-items:center;
            justify-content:center;
            min-height:420px;
            text-align:center;
            gap:16px;
          ">
            <div style="
              font-family:'DM Mono',monospace;
              font-size:3.5rem;
              color:rgba(201,168,76,0.12);
              line-height:1;
            ">改</div>

            <p style="
              font-size:0.95rem;
              color:var(--ash);
              max-width:380px;
              line-height:1.85;
            ">
              Log a session in My Journal and Kaizen AI
              will analyze your discipline, strategy, and
              emotional patterns here.
            </p>

            <p style="
              font-family:'DM Mono',monospace;
              font-size:0.6rem;
              letter-spacing:0.15em;
              text-transform:uppercase;
              color:rgba(201,168,76,0.25);
            ">
              Go to Memories to access previous responses
            </p>

            <div style="
              display:flex;
              gap:12px;
              flex-wrap:wrap;
              justify-content:center;
              margin-top:8px;
            ">
              <a href="/dashboard/journal" class="btn-primary">
                <span>Log a Session</span>
              </a>
              <a href="/memories" class="btn-outline">
                View Memories
              </a>
            </div>
          </div>
        <% } %>

      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

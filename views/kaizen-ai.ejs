<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.ai') %></title>
</head>
<body class="app-page k-chatbody">
  <%- include('partials/navbar') %>

  <%
    function splitParas(str) {
      return String(str || '')
        .replace(/\r\n/g, '\n')
        .split(/\n{2,}|\n/)
        .map(function (p) { return p.trim(); })
        .filter(Boolean);
    }
  %>

  <% if (mode === 'index') { %>

  <!-- ═══ CONVERSATIONS: aligned cards + composer + thread list ═══ -->
  <main class="k-flow k-flow--wide k-ai-stack">
    <div class="k-cockpit-head" style="margin-bottom:4px;">
      <div>
        <div class="k-eyebrow"><%= t('ai.eyebrow') %></div>
        <h1 class="k-page-title"><%= t('ai.title') %></h1>
        <p class="k-page-sub"><%= t('ai.sub') %></p>
      </div>
    </div>

    <!-- Card 1: Your patterns — the emotional/behavioural layer, inside this room -->
    <section class="k-card k-ai-card">
      <div class="k-ai-cardhead">
        <div class="k-panel-title"><%= t('ai.patterns') %></div>
      </div>
      <% if (themes && themes.length) { %>
        <div class="k-chiprow" style="margin-bottom:10px;">
          <% themes.slice(0, 8).forEach(function(th) { %>
            <span class="k-chip<%= th.status === 'active' ? ' k-chip--warn' : (th.status === 'improving' ? ' k-chip--good' : '') %>"><%= th.name %> · <%= (typeof labels !== 'undefined' && labels.mindStatus && labels.mindStatus[th.status]) || th.status %></span>
          <% }); %>
        </div>
        <p class="k-fieldhint" style="margin:0;"><%= t('ai.patternsHint') %></p>
      <% } else { %>
        <p class="k-emptyhint" style="margin:0;"><%= t('ai.patternsNone') %></p>
      <% } %>
    </section>

    <% if (aiResponse) { %>
    <!-- Card 2 (optional): Latest session analysis -->
    <section class="k-card k-card--featured k-ai-card">
      <div class="k-ai-cardhead">
        <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span><%= t('ai.latestAnalysis') %></div>
      </div>
      <div class="k-legacyai">
        <% splitParas(aiResponse).forEach(function(p) { %>
          <p class="k-ai-para"><%= p %></p>
        <% }); %>
      </div>
      <div class="k-fieldhint" style="margin-top:14px;"><%= t('ai.fromLast') %><a class="k-link" href="/dashboard/sessions"><%= t('sessions.title') %></a>.</div>
    </section>
    <% } %>

    <!-- Card 3: Start a conversation -->
    <section class="k-card k-ai-card">
      <div class="k-ai-cardhead">
        <div class="k-panel-title"><%= t('ai.startConv') %></div>
      </div>
      <% if (openers && openers.length) { %>
        <div class="k-openerrow">
          <% openers.forEach(function(o){ %>
            <button type="button" class="k-opener" data-opener="<%= o %>"<% if (o.indexOf('Quiz') === 0) { %> data-quiz="1"<% } %>><%= o %></button>
          <% }); %>
        </div>
      <% } %>
      <div class="k-composer">
        <label class="k-attachbtn" title="<%= t('chat.attach') %>">
          📎<input type="file" id="chart-file" accept="image/png,image/jpeg,image/webp" hidden>
        </label>
        <textarea id="ai-input" rows="2" placeholder="<%= t('ai.placeholder') %>"></textarea>
        <button type="button" id="ai-send" class="k-btn k-btn-primary"><%= t('ai.send') %></button>
      </div>
      <div class="k-attachmeta" id="attach-meta" hidden></div>
    </section>

    <!-- Card 4: Past conversations -->
    <section class="k-card k-ai-card">
      <div class="k-ai-cardhead">
        <div class="k-panel-title"><%= t('ai.conversations') %></div>
      </div>
      <% if (threads && threads.length) { %>
        <div class="k-threadlist">
          <% threads.forEach(function(thr){ %>
            <a class="k-threadrow" href="/kaizen-ai/t/<%= thr._id %>">
              <div class="k-threadmain">
                <span class="k-threadtitle"><%= thr.title %></span>
                <span class="k-threadmeta">
                  <%= thr.messageCount %> <%= t('ai.messageWord') %><%= thr.messageCount === 1 ? '' : 's' %>
                  · <%= new Date(thr.lastMessageAt).toLocaleDateString(({en:'en-US',fr:'fr-FR',zh:'zh-CN',ja:'ja-JP',af:'af-ZA'})[lang]||'en-US',{month:'short',day:'numeric'}) %>
                </span>
              </div>
              <span class="k-threadarrow">→</span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="k-emptyhint" style="margin:0;"><%= t('ai.none') %></p>
      <% } %>
    </section>
  </main>

  <% } else { %>

  <!-- ═══ ONE CONVERSATION ═══ -->
  <main class="k-flow k-flow--wide k-chatmain">
    <div class="k-chathead">
      <a class="k-backlink" href="/kaizen-ai"><%= t('ai.back') %></a>
      <span class="k-chattitle"><%= thread.title %></span>
    </div>

    <div class="k-chatlog" id="chatlog">
      <% if (thread.messages && thread.messages.length) { %>
        <% thread.messages.forEach(function(m){ %>
          <% if (m.role === 'user') { %>
            <div class="k-msg k-msg-user">
              <div class="k-msg-bubble"><% if (m.hasImage) { %><span class="k-attachtag"><%= t('chat.chartChip') %></span> <% } %><%= m.text %></div>
            </div>
          <% } else { %>
            <div class="k-msg k-msg-kai">
              <span class="k-kanji k-kanji--sm">改</span>
              <div class="k-msg-text">
                <% splitParas(m.text).forEach(function(p) { %>
                  <p class="k-ai-para"><%= p %></p>
                <% }); %>
              </div>
            </div>
          <% } %>
        <% }); %>
      <% } %>
      <div class="k-typing" id="typing" hidden>
        <span class="k-kanji k-kanji--sm">改</span>
        <div class="k-msg-text k-typingdots"><span></span><span></span><span></span></div>
      </div>
    </div>

    <% if (openers && openers.length) { %>
      <div class="k-openerrow k-openerrow--inline">
        <% openers.forEach(function(o){ %>
          <button type="button" class="k-opener" data-opener="<%= o %>"<% if (o.indexOf('Quiz') === 0) { %> data-quiz="1"<% } %>><%= o %></button>
        <% }); %>
      </div>
    <% } %>

    <div class="k-composer k-composer--sticky">
      <label class="k-attachbtn" title="<%= t('chat.attach') %>">
        📎<input type="file" id="chart-file" accept="image/png,image/jpeg,image/webp" hidden>
      </label>
      <textarea id="ai-input" rows="2" placeholder="<%= t('ai.placeholder') %>"></textarea>
      <button type="button" id="ai-send" class="k-btn k-btn-primary"><%= t('ai.send') %></button>
    </div>
    <div class="k-attachmeta" id="attach-meta" hidden></div>
  </main>

  <% } %>

  <%- include('partials/footer') %>
  <script>
    (function () {
      var input = document.getElementById('ai-input');
      var sendBtn = document.getElementById('ai-send');
      var typing = document.getElementById('typing');
      var log = document.getElementById('chatlog');
      var fileInput = document.getElementById('chart-file');
      var attachMeta = document.getElementById('attach-meta');
      var threadId = <%- (mode === 'thread' && thread && thread._id) ? JSON.stringify(String(thread._id)) : 'null' %>;
      var imageData = null;

      function scrollBottom() { if (log) log.scrollTop = log.scrollHeight; }
      scrollBottom();

      function renderCoachParas(container, rawText) {
        if (!container) return;
        container.innerHTML = '';
        var paras = String(rawText || '')
          .replace(/\r\n/g, '\n')
          .split(/\n{2,}|\n/)
          .map(function (s) { return s.trim(); })
          .filter(Boolean);
        if (!paras.length) return;
        paras.forEach(function (pText) {
          var p = document.createElement('p');
          p.className = 'k-ai-para';
          p.textContent = pText;
          container.appendChild(p);
        });
      }

      document.querySelectorAll('.k-opener').forEach(function (b) {
        b.addEventListener('click', function () {
          if (b.hasAttribute('data-quiz')) { sendQuiz(); return; }
          input.value = b.getAttribute('data-opener');
          input.focus();
        });
      });

      fileInput.addEventListener('change', function () {
        var f = fileInput.files && fileInput.files[0];
        if (!f) return;
        if (f.size > 2 * 1024 * 1024) {
          attachMeta.hidden = false;
          attachMeta.textContent = <%- JSON.stringify(t('chat.tooLarge')) %>;
          fileInput.value = '';
          return;
        }
        var fr = new FileReader();
        fr.onload = function () {
          imageData = fr.result;
          attachMeta.hidden = false;
          attachMeta.textContent = '📎 ' + f.name + ' ' + <%- JSON.stringify(t('chat.attachedNote')) %>;
        };
        fr.readAsDataURL(f);
      });

      function addMsg(role, text, hasImage) {
        if (!log) return;
        var wrap = document.createElement('div');
        if (role === 'user') {
          wrap.className = 'k-msg k-msg-user';
          var b = document.createElement('div');
          b.className = 'k-msg-bubble';
          if (hasImage) {
            var tag = document.createElement('span');
            tag.className = 'k-attachtag';
            tag.textContent = <%- JSON.stringify(t('chat.chartChip')) %>;
            b.appendChild(tag);
          }
          b.appendChild(document.createTextNode(text));
          wrap.appendChild(b);
        } else {
          wrap.className = 'k-msg k-msg-kai';
          var k = document.createElement('span');
          k.className = 'k-kanji k-kanji--sm';
          k.textContent = '改';
          var t = document.createElement('div');
          t.className = 'k-msg-text';
          renderCoachParas(t, text);
          wrap.appendChild(k);
          wrap.appendChild(t);
        }
        log.appendChild(wrap);
        scrollBottom();
        return t;
      }

      var busy = false;
      function send(payload) {
        busy = true;
        sendBtn.disabled = true;
        if (threadId && payload.message) addMsg('user', payload.message, !!payload.image);
        if (!payload.message && payload.image && threadId) addMsg('user', '(chart attached)', true);
        input.value = '';
        imageData = null;
        attachMeta.hidden = true;
        if (typing) typing.hidden = false;
        scrollBottom();

        function finish() {
          busy = false;
          sendBtn.disabled = false;
          if (typing) typing.hidden = true;
          input.focus();
        }

        // Live streaming (thread view). The first message still lands via
        // redirect into its own thread page.
        if (threadId && window.kaizenStream) {
          var live = addMsg('kaizen', '');
          var streamBuf = '';
          window.kaizenStream('/kaizen-ai/ask', Object.assign({ threadId: threadId, stream: 1 }, payload), {
            onDelta: function (t) {
              if (typing) typing.hidden = true;
              streamBuf += t;
              if (live) renderCoachParas(live, streamBuf);
              scrollBottom();
            },
            onDone: function (ev) {
              // The server ships the final reply asterisk-free — swap it in.
              if (ev && ev.final != null && live) renderCoachParas(live, ev.final);
              finish();
            },
            onError: function (msg) {
              if (typing) typing.hidden = true;
              if (live && !live.textContent) {
                renderCoachParas(live, msg || 'KAIZEN could not respond. Try again in a moment.');
              }
              finish();
            },
            onJson: function (data) {
              if (typing) typing.hidden = true;
              if (data && data.error) addMsg('kaizen', data.error);
              else if (data && data.reply) addMsg('kaizen', data.reply);
              finish();
            }
          }).catch(function () {
            if (typing) typing.hidden = true;
            addMsg('kaizen', 'Connection dropped. Your message was sent — refresh in a moment.');
            finish();
          });
          return;
        }

        fetch('/kaizen-ai/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.assign({ threadId: threadId }, payload))
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.error) { addMsg('kaizen', data.error); return; }
            if (!threadId) { window.location = '/kaizen-ai/t/' + data.threadId; return; }
            addMsg('kaizen', data.reply);
          })
          .catch(function () {
            addMsg('kaizen', 'Connection dropped. Your message was sent — refresh in a moment.');
          })
          .finally(finish);
      }

      function sendMsg() {
        var text = input.value.trim();
        if (busy) return;
        if (!text && !imageData) return;
        send({ message: text, image: imageData });
      }
      function sendQuiz() { if (!busy) send({ message: 'Quiz me on my rules.', mode: 'quiz' }); }

      sendBtn.addEventListener('click', sendMsg);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey && window.innerWidth > 760) {
          e.preventDefault();
          sendMsg();
        }
      });
    })();
  </script>
  <script src="/js/app.js"></script>
</body>
</html>

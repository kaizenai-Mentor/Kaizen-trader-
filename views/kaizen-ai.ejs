<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — KAIZEN AI</title>
</head>
<body class="app-page k-chatbody">
  <%- include('partials/navbar') %>

  <% if (mode === 'index') { %>

  <!-- ═══ CONVERSATIONS: list + start + legacy analysis ─═ -->
  <main class="k-flow k-flow--wide">
    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow">COACH · 改</div>
        <h1 class="k-page-title">KAIZEN AI</h1>
        <p class="k-page-sub">The trading room. Talk setups, rules, charts — everything anchored to your own system. No signals, no predictions: process.</p>
      </div>
    </div>

    <% if (aiResponse) { %>
    <section class="k-card k-card--featured">
      <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span> YOUR LATEST SESSION ANALYSIS</div>
      <div class="k-legacyai"><%= aiResponse %></div>
      <div class="k-fieldhint">From your last logged session. New analyses now live on the session itself — <a class="k-link" href="/dashboard/sessions">Sessions</a>.</div>
    </section>
    <% } %>

    <section class="k-card">
      <div class="k-panel-title" style="margin-bottom:14px;">START A CONVERSATION</div>
      <% if (openers && openers.length) { %>
        <div class="k-openerrow">
          <% openers.forEach(function(o){ %>
            <button type="button" class="k-opener" data-opener="<%= o %>"<% if (o.indexOf('Quiz') === 0) { %> data-quiz="1"<% } %>><%= o %></button>
          <% }); %>
        </div>
      <% } %>
      <div class="k-composer">
        <label class="k-attachbtn" title="Attach a chart">
          📎<input type="file" id="chart-file" accept="image/png,image/jpeg,image/webp" hidden>
        </label>
        <textarea id="ai-input" rows="2" placeholder="Ask KAIZEN about a setup, a rule, a chart…"></textarea>
        <button type="button" id="ai-send" class="k-btn k-btn-primary">Send</button>
      </div>
      <div class="k-attachmeta" id="attach-meta" hidden></div>
    </section>

    <section class="k-card">
      <div class="k-panel-title" style="margin-bottom:6px;">CONVERSATIONS</div>
      <% if (threads && threads.length) { %>
        <div class="k-threadlist">
          <% threads.forEach(function(t){ %>
            <a class="k-threadrow" href="/kaizen-ai/t/<%= t._id %>">
              <div class="k-threadmain">
                <span class="k-threadtitle"><%= t.title %></span>
                <span class="k-threadmeta">
                  <%= t.messageCount %> message<%= t.messageCount === 1 ? '' : 's' %>
                  · <%= new Date(t.lastMessageAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
                </span>
              </div>
              <span class="k-threadarrow">→</span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="k-emptyhint">No conversations yet. Ask anything about your trading — it stays between you and KAIZEN.</p>
      <% } %>
    </section>
  </main>

  <% } else { %>

  <!-- ═══ ONE CONVERSATION ═══ -->
  <main class="k-flow k-flow--wide k-chatmain">
    <div class="k-chathead">
      <a class="k-backlink" href="/kaizen-ai">← KAIZEN AI</a>
      <span class="k-chattitle"><%= thread.title %></span>
    </div>

    <div class="k-chatlog" id="chatlog">
      <% if (thread.messages && thread.messages.length) { %>
        <% thread.messages.forEach(function(m){ %>
          <% if (m.role === 'user') { %>
            <div class="k-msg k-msg-user">
              <div class="k-msg-bubble"><% if (m.hasImage) { %><span class="k-attachtag">📎 chart</span> <% } %><%= m.text %></div>
            </div>
          <% } else { %>
            <div class="k-msg k-msg-kai">
              <span class="k-kanji k-kanji--sm">改</span>
              <div class="k-msg-text"><%= m.text %></div>
            </div>
          <% } %>
        <% }); %>
      <% } %>
      <div class="k-typing" id="typing" hidden>
        <span class="k-kanji k-kanji--sm">改</span>
        <div class="k-msg-text k-typingdots"><span></span><span></span><span></span></div>
      </div>
    </div>

    <% if (openers && openers.length) { %>
      <div class="k-openerrow k-openerrow--inline">
        <% openers.forEach(function(o){ %>
          <button type="button" class="k-opener" data-opener="<%= o %>"<% if (o.indexOf('Quiz') === 0) { %> data-quiz="1"<% } %>><%= o %></button>
        <% }); %>
      </div>
    <% } %>

    <div class="k-composer k-composer--sticky">
      <label class="k-attachbtn" title="Attach a chart">
        📎<input type="file" id="chart-file" accept="image/png,image/jpeg,image/webp" hidden>
      </label>
      <textarea id="ai-input" rows="2" placeholder="Reply to KAIZEN…"></textarea>
      <button type="button" id="ai-send" class="k-btn k-btn-primary">Send</button>
    </div>
    <div class="k-attachmeta" id="attach-meta" hidden></div>
  </main>

  <% } %>

  <%- include('partials/footer') %>
  <script>
    (function () {
      var input = document.getElementById('ai-input');
      var send = document.getElementById('ai-send');
      var typing = document.getElementById('typing');
      var log = document.getElementById('chatlog');
      var fileInput = document.getElementById('chart-file');
      var attachMeta = document.getElementById('attach-meta');
      var threadId = <%- (mode === 'thread' && thread && thread._id) ? JSON.stringify(String(thread._id)) : 'null' %>;
      var imageData = null;

      function scrollBottom() { if (log) log.scrollTop = log.scrollHeight; }
      scrollBottom();

      document.querySelectorAll('.k-opener').forEach(function (b) {
        b.addEventListener('click', function () {
          if (b.hasAttribute('data-quiz')) { sendQuiz(); return; }
          input.value = b.getAttribute('data-opener');
          input.focus();
        });
      });

      fileInput.addEventListener('change', function () {
        var f = fileInput.files && fileInput.files[0];
        if (!f) return;
        if (f.size > 2 * 1024 * 1024) {
          attachMeta.hidden = false;
          attachMeta.textContent = 'Chart too large — keep it under 2 MB.';
          fileInput.value = '';
          return;
        }
        var fr = new FileReader();
        fr.onload = function () {
          imageData = fr.result;
          attachMeta.hidden = false;
          attachMeta.textContent = '📎 ' + f.name + ' attached — describe what to check, or just send.';
        };
        fr.readAsDataURL(f);
      });

      function addMsg(role, text, hasImage) {
        if (!log) return;
        var wrap = document.createElement('div');
        if (role === 'user') {
          wrap.className = 'k-msg k-msg-user';
          var b = document.createElement('div');
          b.className = 'k-msg-bubble';
          if (hasImage) {
            var tag = document.createElement('span');
            tag.className = 'k-attachtag';
            tag.textContent = '📎 chart ';
            b.appendChild(tag);
          }
          b.appendChild(document.createTextNode(text));
          wrap.appendChild(b);
        } else {
          wrap.className = 'k-msg k-msg-kai';
          var k = document.createElement('span');
          k.className = 'k-kanji k-kanji--sm';
          k.textContent = '改';
          var t = document.createElement('div');
          t.className = 'k-msg-text';
          t.textContent = text;
          wrap.appendChild(k);
          wrap.appendChild(t);
        }
        log.appendChild(wrap);
        scrollBottom();
      }

      var busy = false;
      function send(payload) {
        busy = true;
        send.disabled = true;
        if (threadId && payload.message) addMsg('user', payload.message, !!payload.image);
        if (!payload.message && payload.image && threadId) addMsg('user', '(chart attached)', true);
        input.value = '';
        imageData = null;
        attachMeta.hidden = true;
        if (typing) typing.hidden = false;
        scrollBottom();

        fetch('/kaizen-ai/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.assign({ threadId: threadId }, payload))
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.error) { addMsg('kaizen', data.error); return; }
            if (!threadId) { window.location = '/kaizen-ai/t/' + data.threadId; return; }
            addMsg('kaizen', data.reply);
          })
          .catch(function () {
            addMsg('kaizen', 'Connection dropped. Your message was sent — refresh in a moment.');
          })
          .finally(function () {
            busy = false;
            send.disabled = false;
            if (typing) typing.hidden = true;
            input.focus();
          });
      }

      function sendMsg() {
        var text = input.value.trim();
        if (busy) return;
        if (!text && !imageData) return;
        send({ message: text, image: imageData });
      }
      function sendQuiz() { if (!busy) send({ message: 'Quiz me on my rules.', mode: 'quiz' }); }

      send.addEventListener('click', sendMsg);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey && window.innerWidth > 760) {
          e.preventDefault();
          sendMsg();
        }
      });
    })();
  </script>
  <script src="/js/app.js"></script>
</body>
</html>

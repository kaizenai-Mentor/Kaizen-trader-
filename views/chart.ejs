<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Chart</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #080808;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* TOP BAR */
    .chart-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
      background: #0A0A0A;
      border-bottom: 1px solid rgba(201,168,76,0.15);
      flex-shrink: 0;
      gap: 16px;
      flex-wrap: wrap;
      z-index: 10;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .back-link {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: #C9A84C;
      text-decoration: none;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.2s;
      flex-shrink: 0;
    }
    .back-link:hover { opacity: 0.7; }

    .chart-logo {
      font-family: 'DM Mono', monospace;
      font-size: 0.85rem;
      color: #C9A84C;
      letter-spacing: 0.1em;
      font-weight: 500;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .topbar-btn {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #A8A09A;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.08);
      padding: 6px 14px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .topbar-btn:hover { border-color: rgba(201,168,76,0.3); color: #C9A84C; }
    .topbar-btn-gold {
      background: rgba(201,168,76,0.1);
      border-color: rgba(201,168,76,0.3);
      color: #C9A84C;
    }

    /* CHART FRAME */
    .chart-frame {
      flex: 1;
      position: relative;
      overflow: hidden;
    }

    .chart-frame iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    /* KAIZEN OVERLAY — bottom strip */
    .kaizen-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, rgba(8,8,8,0.95), transparent);
      padding: 12px 20px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      pointer-events: none;
    }

    .overlay-left {
      display: flex;
      align-items: center;
      gap: 8px;
      pointer-events: all;
    }

    .overlay-btn {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(8,8,8,0.9);
      border: 1px solid rgba(201,168,76,0.3);
      color: #C9A84C;
      padding: 6px 14px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .overlay-btn:hover { background: rgba(201,168,76,0.1); }

    .discipline-pill {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      background: rgba(8,8,8,0.9);
      border: 1px solid rgba(201,168,76,0.2);
      color: #A8A09A;
      padding: 6px 14px;
      pointer-events: all;
    }

    .discipline-pill span {
      color: #C9A84C;
      font-weight: 600;
    }

    .overlay-right {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      color: rgba(201,168,76,0.25);
      text-transform: uppercase;
    }

    /* SESSION LOG MODAL */
    .log-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(4px);
    }

    .log-modal.open {
      opacity: 1;
      pointer-events: all;
    }

    .log-modal-card {
      background: #111;
      border: 1px solid rgba(201,168,76,0.25);
      width: 100%;
      max-width: 500px;
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
    }

    .log-modal-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #C9A84C, transparent);
    }

    .log-modal-header {
      padding: 20px 24px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .log-modal-header h3 {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #C9A84C;
    }

    .log-modal-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
      padding: 0 4px;
      transition: color 0.2s;
    }
    .log-modal-close:hover { color: #F5F3EF; }

    .log-modal-body { padding: 20px 24px; }

    .log-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .log-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #A8A09A;
      display: block;
      margin-bottom: 5px;
    }

    .log-input, .log-textarea, .log-select {
      width: 100%;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.08);
      color: #F5F3EF;
      font-family: 'Outfit', sans-serif;
      font-size: 0.88rem;
      padding: 10px 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    .log-input:focus,
    .log-textarea:focus,
    .log-select:focus { border-color: #C9A84C; }

    .log-textarea { min-height: 120px; resize: vertical; line-height: 1.7; }

    .log-compliance {
      display: flex;
      gap: 10px;
    }

    .compliance-opt {
      flex: 1;
      padding: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      background: #161616;
      cursor: pointer;
      text-align: center;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #A8A09A;
      transition: all 0.2s;
      position: relative;
    }

    .compliance-opt input {
      position: absolute;
      opacity: 0;
      width: 0; height: 0;
    }

    .compliance-opt:has(input:checked),
    .compliance-opt.selected {
      border-color: rgba(201,168,76,0.4);
      background: rgba(201,168,76,0.08);
      color: #C9A84C;
    }

    .compliance-opt-no:has(input:checked),
    .compliance-opt-no.selected {
      border-color: rgba(248,113,113,0.4);
      background: rgba(248,113,113,0.06);
      color: #F87171;
    }

    .log-submit {
      background: #C9A84C;
      color: #000;
      border: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 14px;
      width: 100%;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 4px;
    }
    .log-submit:hover { background: #E2C46A; }

    /* MOBILE */
    @media (max-width: 600px) {
      .chart-topbar { padding: 8px 14px; }
      .chart-logo { display: none; }
      .kaizen-overlay { padding: 10px 14px 8px; }
    }
  </style>
</head>

<body>

  <!-- TOP BAR -->
  <div class="chart-topbar">
    <div class="topbar-left">
      <a href="/dashboard" class="back-link">← 改</a>
      <span class="chart-logo">KAIZEN Chart</span>
    </div>
    <div class="topbar-right">
      <button class="topbar-btn topbar-btn-gold" onclick="openLogModal()">
        + Log Session
      </button>
      <a href="/dashboard/journal" class="topbar-btn">Journal</a>
      <a href="/za/bounties" class="topbar-btn">Bounties</a>
      <a href="/dashboard" class="topbar-btn">Dashboard</a>
    </div>
  </div>

  <!-- CHART FRAME -->
  <div class="chart-frame">

    <!-- TradingView Full Widget -->
    <iframe
      id="tv-widget"
      src="https://s.tradingview.com/widgetsnippets/embed/symbol-overview-full/?symbol=BINANCE%3ABTCUSDT&interval=60&theme=dark&style=1&locale=en&toolbar_bg=%23080808&enable_publishing=false&hide_top_toolbar=false&save_image=true&container_id=tv_chart"
      allowfullscreen>
    </iframe>

    <!-- KAIZEN Overlay Strip -->
    <div class="kaizen-overlay">
      <div class="overlay-left">
        <button class="overlay-btn" onclick="openLogModal()">
          + Log This Session
        </button>
        <div class="discipline-pill">
          Discipline Score: <span><%= user.disciplineScore || 0 %>/100</span>
        </div>
      </div>
      <div class="overlay-right">改 KAIZEN · Trade Better. Every Day.</div>
    </div>

  </div>

  <!-- SESSION LOG MODAL -->
  <div class="log-modal" id="logModal">
    <div class="log-modal-card">
      <div class="log-modal-header">
        <h3>Log This Session</h3>
        <button class="log-modal-close" onclick="closeLogModal()">×</button>
      </div>
      <div class="log-modal-body">
        <form action="/dashboard/journal" method="POST" class="log-form">

          <div>
            <label class="log-label">Asset Analyzed</label>
            <input type="text" name="asset" class="log-input"
              id="session-asset" placeholder="e.g. BTC/USDT, EUR/USD" required>
          </div>

          <div>
            <label class="log-label">Session Type</label>
            <div class="log-compliance">
              <label class="compliance-opt" id="opt-live">
                <input type="radio" name="direction" value="Live Trade" required>
                Live Trade
              </label>
              <label class="compliance-opt" id="opt-back">
                <input type="radio" name="direction" value="Backtesting">
                Backtesting
              </label>
            </div>
          </div>

          <div>
            <label class="log-label">Session Notes</label>
            <textarea name="notes" class="log-textarea"
              placeholder="What did you see? What did you do? What did you feel? Did you follow your rules? Write honestly — Kaizen AI reads this."
              required></textarea>
          </div>

          <div>
            <label class="log-label">Did you follow ALL your rules?</label>
            <div class="log-compliance">
              <label class="compliance-opt" id="opt-yes">
                <input type="radio" name="ruleCompliance" value="true" required>
                Yes — Compliant
              </label>
              <label class="compliance-opt compliance-opt-no" id="opt-no">
                <input type="radio" name="ruleCompliance" value="false">
                No — Violated
              </label>
            </div>
          </div>

          <input type="hidden" name="timeframe" value="Chart Session">
          <input type="hidden" name="outcome" value="Pending">
          <input type="hidden" name="emotion" value="Logged from Chart">
          <input type="hidden" name="sessionScore" value="50">

          <button type="submit" class="log-submit">Save Session Entry</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    function openLogModal() {
      document.getElementById('logModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeLogModal() {
      document.getElementById('logModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    // Close on overlay click
    document.getElementById('logModal').addEventListener('click', function(e) {
      if (e.target === this) closeLogModal();
    });

    // Style radio options
    document.querySelectorAll('.compliance-opt input').forEach(function(input) {
      input.addEventListener('change', function() {
        const name = this.getAttribute('name');
        document.querySelectorAll(`.compliance-opt input[name="${name}"]`).forEach(function(i) {
          i.closest('.compliance-opt').classList.remove('selected');
        });
        this.closest('.compliance-opt').classList.add('selected');
      });
    });
  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Chart</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #080808;
      overflow: hidden;
      height: 100vh;
      max-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: 'Outfit', sans-serif;
    }

    .chart-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      height: 48px;
      min-height: 48px;
      background: #0A0A0A;
      border-bottom: 1px solid rgba(201,168,76,0.18);
      gap: 10px;
      z-index: 20;
      flex-shrink: 0;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .back-link {
      font-family: 'DM Mono', monospace;
      font-size: 0.85rem;
      color: #C9A84C;
      text-decoration: none;
      letter-spacing: 0.08em;
      transition: opacity 0.2s;
    }
    .back-link:hover { opacity: 0.7; }

    .chart-title {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: #C9A84C;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .discipline-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: #A8A09A;
      background: rgba(201,168,76,0.06);
      border: 1px solid rgba(201,168,76,0.15);
      padding: 5px 12px;
      white-space: nowrap;
    }
    .discipline-badge span {
      color: #C9A84C;
      font-weight: 600;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .theme-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid rgba(255,255,255,0.07);
      color: #A8A09A;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .theme-btn:hover {
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
    }

    .three-dot-btn {
      width: 32px;
      height: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      background: none;
      border: 1px solid rgba(255,255,255,0.07);
      cursor: pointer;
      transition: all 0.2s;
      padding: 0;
    }
    .three-dot-btn span {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #A8A09A;
      display: block;
      transition: background 0.2s;
    }
    .three-dot-btn:hover {
      border-color: rgba(201,168,76,0.35);
    }
    .three-dot-btn:hover span { background: #C9A84C; }

    /* CHART FILLS REMAINING HEIGHT */
    .chart-frame {
      flex: 1;
      position: relative;
      overflow: hidden;
      min-height: 0;
    }

    #tv-chart-container {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
    }

    /* POPUP OVERLAY */
    .popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(2px);
    }
    .popup-overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    /* POPUP MENU */
    .nav-popup {
      position: fixed;
      top: 0; right: 0;
      width: 300px;
      height: 100vh;
      background: #131313;
      border-left: 1px solid rgba(255,255,255,0.07);
      z-index: 999;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      box-shadow: -8px 0 40px rgba(0,0,0,0.5);
      overflow-y: auto;
    }
    .nav-popup.open { transform: translateX(0); }

    .popup-header {
      padding: 18px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
    }
    .popup-logo {
      font-family: 'DM Mono', monospace;
      font-size: 1rem;
      color: #C9A84C;
      font-weight: 500;
      letter-spacing: 0.08em;
    }
    .popup-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
    }
    .popup-close:hover { color: #F5F3EF; }

    .popup-section {
      padding: 6px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .popup-section-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #A8A09A;
      padding: 6px 20px 3px;
    }

    .popup-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: #F5F3EF;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }
    .popup-item:hover {
      background: rgba(201,168,76,0.06);
      color: #C9A84C;
    }

    .popup-item-active {
      color: #C9A84C !important;
      background: rgba(201,168,76,0.05) !important;
    }

    .popup-footer {
      margin-top: auto;
      padding: 14px 20px;
      border-top: 1px solid rgba(255,255,255,0.06);
      flex-shrink: 0;
    }

    .popup-user {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .popup-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(201,168,76,0.1);
      border: 1px solid rgba(201,168,76,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #C9A84C;
      font-size: 0.88rem;
      flex-shrink: 0;
    }
    .popup-username {
      font-weight: 600;
      font-size: 0.88rem;
      color: #F5F3EF;
    }
    .popup-user-email {
      font-size: 0.72rem;
      color: #A8A09A;
    }

    .popup-socials {
      display: flex;
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    .popup-social-link {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,0.08);
      color: #A8A09A;
      transition: all 0.2s;
      text-decoration: none;
    }
    .popup-social-link:hover {
      border-color: #C9A84C;
      color: #C9A84C;
    }

    /* SECURITY MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(4px);
    }
    .modal-overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    .modal {
      background: #111;
      border: 1px solid rgba(255,255,255,0.08);
      width: 100%;
      max-width: 400px;
      position: relative;
    }
    .modal::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg,
        transparent, #C9A84C, transparent);
    }

    .modal-header {
      padding: 18px 22px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: #F5F3EF;
    }
    .modal-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
      transition: color 0.2s;
    }
    .modal-close:hover { color: #F5F3EF; }

    .modal-body { padding: 22px; }

    .m-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #A8A09A;
      display: block;
      margin-bottom: 6px;
    }
    .m-input {
      width: 100%;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.08);
      color: #F5F3EF;
      padding: 10px 14px;
      outline: none;
      font-family: 'Outfit', sans-serif;
      font-size: 0.88rem;
      margin-bottom: 14px;
      transition: border-color 0.2s;
    }
    .m-input:focus { border-color: #C9A84C; }
    .m-btn {
      background: #C9A84C;
      color: #000;
      border: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 12px;
      width: 100%;
      cursor: pointer;
      transition: background 0.2s;
    }
    .m-btn:hover { background: #E2C46A; }

    @media (max-width: 600px) {
      .chart-title { display: none; }
      .discipline-badge { display: none; }
      .nav-popup { width: 100%; }
    }
  </style>
</head>
<body>

  <!-- POPUP OVERLAY -->
  <div class="popup-overlay" id="popupOverlay"
    onclick="closePopup()"></div>

  <!-- POPUP MENU -->
  <div class="nav-popup" id="navPopup">
    <div class="popup-header">
      <span class="popup-logo">改 KAIZEN</span>
      <button class="popup-close" onclick="closePopup()">×</button>
    </div>

    <div class="popup-section">
      <div class="popup-section-label">Navigation</div>
      <a href="/dashboard" class="popup-item">▪ Dashboard</a>
      <a href="/chart" class="popup-item popup-item-active">▪ Chart</a>
      <a href="/journal" class="popup-item">▪ My Journal</a>
      <a href="/kaizen-ai" class="popup-item">▪ Kaizen AI</a>
      <a href="/memories" class="popup-item">▪ Memories</a>
      <a href="/za/bounties" class="popup-item">▪ Bounties</a>
      <a href="/za/reputation/<%= user.id %>" class="popup-item">▪ Reputation</a>
    </div>

    <div class="popup-section">
      <div class="popup-section-label">Settings</div>
      <button class="popup-item"
        onclick="toggleTheme();closePopup()">
        ▪ Dark / Light Mode
      </button>
      <button class="popup-item"
        onclick="openModal('securityModal');closePopup()">
        ▪ Security
      </button>
    </div>

    <div class="popup-section">
      <div class="popup-section-label">Info</div>
      <a href="/about" class="popup-item">▪ About KAIZEN</a>
      <a href="/help" class="popup-item">▪ Help Center</a>
      <a href="/support" class="popup-item">▪ Support</a>
      <a href="/privacy" class="popup-item">▪ Privacy Policy</a>
      <a href="/terms" class="popup-item">▪ Terms of Service</a>
    </div>

    <div class="popup-section">
      <a href="/auth/logout" class="popup-item"
        style="color:#F87171;">▪ Log Out</a>
    </div>

    <div class="popup-footer">
      <div class="popup-user">
        <div class="popup-avatar">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="popup-username"><%= user.username %></div>
          <div class="popup-user-email"><%= user.email %></div>
        </div>
      </div>
      <div class="popup-socials">
        <a href="https://x.com/kaizenaibot" target="_blank"
          class="popup-social-link" title="X (Twitter)">
          <svg width="12" height="12" viewBox="0 0 24 24"
            fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- SECURITY MODAL -->
  <div class="modal-overlay" id="securityModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Security</h3>
        <button class="modal-close"
          onclick="closeModal('securityModal')">×</button>
      </div>
      <div class="modal-body">
        <form action="/auth/change-password" method="POST">
          <label class="m-label">Current Password</label>
          <input type="password" name="currentPassword" class="m-input"
            placeholder="Enter current password">
          <label class="m-label">New Password</label>
          <input type="password" name="newPassword" class="m-input"
            placeholder="Enter new password">
          <label class="m-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="m-input"
            placeholder="Confirm new password">
          <button type="submit" class="m-btn">Update Password</button>
        </form>
        <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.06);">
          <p style="font-family:'DM Mono',monospace;font-size:0.65rem;letter-spacing:0.08em;color:#3A3530;text-align:center;">
            2FA — Coming in Phase 3
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- TOP BAR -->
  <div class="chart-topbar">
    <div class="topbar-left">
      <a href="/dashboard" class="back-link">← 改</a>
      <span class="chart-title">KAIZEN · Chart</span>
      <div class="discipline-badge">
        Score: <span><%= user.disciplineScore || 0 %>/100</span>
      </div>
    </div>
    <div class="topbar-right">
      <button class="theme-btn" onclick="toggleTheme()">
        <span id="chartThemeIcon">◑</span>
      </button>
      <button class="three-dot-btn" onclick="togglePopup()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- CHART -->
  <div class="chart-frame">
    <div id="tv-chart-container"></div>
  </div>

  <!-- TradingView Script -->
  <script type="text/javascript"
    src="https://s3.tradingview.com/tv.js"></script>

  <script>
    // Apply saved theme
    const savedTheme = localStorage.getItem('kaizen-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    const ti = document.getElementById('chartThemeIcon');
    if (ti) ti.textContent = savedTheme === 'dark' ? '◑' : '◐';

    // Init chart
    let tvWidget = null;

    function initChart() {
      const isDark = localStorage.getItem('kaizen-theme') !== 'light';
      if (tvWidget) {
        try { tvWidget.remove(); } catch(e) {}
      }
      tvWidget = new TradingView.widget({
        container_id: 'tv-chart-container',
        autosize: true,
        symbol: 'BINANCE:BTCUSDT',
        interval: '60',
        timezone: 'Etc/UTC',
        theme: isDark ? 'dark' : 'light',
        style: '1',
        locale: 'en',
        toolbar_bg: isDark ? '#0A0A0A' : '#f5f5f5',
        enable_publishing: false,
        allow_symbol_change: true,
        save_image: true,
        hide_top_toolbar: false,
        no_referral_id: true
      });
    }

    initChart();

    // Theme toggle
    function toggleTheme() {
      const current = document.documentElement
        .getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('kaizen-theme', next);
      const icon = document.getElementById('chartThemeIcon');
      if (icon) icon.textContent = next === 'dark' ? '◑' : '◐';
      initChart();
    }

    // Popup
    function togglePopup() {
      document.getElementById('navPopup').classList.toggle('open');
      document.getElementById('popupOverlay').classList.toggle('open');
    }

    function closePopup() {
      document.getElementById('navPopup').classList.remove('open');
      document.getElementById('popupOverlay').classList.remove('open');
    }

    // Modals
    function openModal(id) {
      closePopup();
      document.getElementById(id).classList.add('open');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    document.querySelectorAll('.modal-overlay').forEach(function(o) {
      o.addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('open');
      });
    });
  </script>

</body>
</html>

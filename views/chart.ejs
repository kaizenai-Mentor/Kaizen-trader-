<!-- CHART BODY -->
<div class="chart-body">

  <!-- WATCHLIST -->
  <div class="watchlist" id="watchlistPanel">
    <div class="watchlist-header">
      <span class="watchlist-title">Watchlist</span>
      <button class="watchlist-add" onclick="showAddModal()" title="Add symbol">+</button>
    </div>

    <div class="watchlist-categories">
      <div class="wl-cat-scroll">
        <button class="wl-cat active" onclick="filterWL(this,'all')">All</button>
        <button class="wl-cat" onclick="filterWL(this,'crypto')">Crypto</button>
        <button class="wl-cat" onclick="filterWL(this,'forex')">Forex</button>
        <button class="wl-cat" onclick="filterWL(this,'stocks')">Stocks</button>
        <button class="wl-cat" onclick="filterWL(this,'indices')">Indices</button>
        <button class="wl-cat" onclick="filterWL(this,'synthetic')">Synthetic</button>
        <button class="wl-cat" onclick="filterWL(this,'commodities')">Commodities</button>
      </div>
    </div>

    <div class="watchlist-search">
      <input type="text" placeholder="Search..." id="wl-search"
        oninput="searchWL(this.value)">
    </div>

    <div class="watchlist-list" id="wl-list">
      <!-- Populated by JS -->
    </div>
  </div>

  <!-- MAIN CHART -->
  <div class="chart-main">
    <div id="tv-chart-container"></div>

    <!-- JOURNAL QUICK PANEL -->
    <div class="journal-panel" id="journalPanel">
      <div class="panel-header">
        <span class="panel-title">改 Quick Journal</span>
        <button class="panel-close" onclick="closeJournalPanel()">×</button>
      </div>
      <div class="panel-body">
        <form action="/dashboard/journal" method="POST" class="quick-log-form">
          <div class="quick-row">
            <div style="flex:1;">
              <label class="quick-label">Asset</label>
              <input type="text" name="asset" class="quick-input"
                id="quick-asset" placeholder="BTC/USDT" required>
            </div>
            <div style="flex:1;">
              <label class="quick-label">Session Type</label>
              <select name="direction" class="quick-input quick-select">
                <option value="Live Trade">Live Trade</option>
                <option value="Backtesting">Backtesting</option>
              </select>
            </div>
          </div>

          <div>
            <label class="quick-label">Session Notes</label>
            <textarea name="notes" class="quick-input quick-textarea"
              placeholder="What did you see and do? Were you disciplined? Write honestly."
              required></textarea>
          </div>

          <div>
            <label class="quick-label">Followed your rules?</label>
            <div class="quick-compliance">
              <div class="quick-opt" onclick="pickQ(this,'ruleCompliance','true','g')">
                <input type="radio" name="ruleCompliance" value="true" required>
                Yes
              </div>
              <div class="quick-opt" onclick="pickQ(this,'ruleCompliance','false','r')">
                <input type="radio" name="ruleCompliance" value="false">
                No
              </div>
            </div>
          </div>

          <input type="hidden" name="timeframe" value="Chart Session">
          <input type="hidden" name="outcome" value="Pending">
          <input type="hidden" name="emotion" value="Logged from Chart">
          <input type="hidden" name="sessionScore" value="50">

          <button type="submit" class="quick-submit">Save Entry</button>
        </form>
      </div>
    </div>

    <!-- KAIZEN AI PANEL -->
    <div class="ai-panel" id="aiPanel">
      <div class="ai-panel-header">
        <span class="ai-panel-title">改 Kaizen AI</span>
        <button class="ai-panel-close" onclick="toggleAI()">×</button>
      </div>
      <div class="ai-messages" id="ai-messages">
        <div class="ai-msg">
          <div class="ai-msg-label">改 Kaizen</div>
          I am watching. Log a session and I will analyze your discipline patterns. Ask me anything about your trading behavior.
        </div>
        <% if (user.tradingStyle && user.tradingStyle.riskPerTrade) { %>
        <div class="ai-msg">
          <div class="ai-msg-label">改 Kaizen · Your Rules</div>
          Your max risk: <%= user.tradingStyle.riskPerTrade %>% per trade.
          Daily drawdown limit: <%= user.tradingStyle.dailyDrawdown %>%.
          Edge: <%= user.tradingStyle.tradingEdge %>.
          I will alert you if you deviate.
        </div>
        <% } %>
      </div>
      <div class="ai-input-area">
        <input type="text" class="ai-input" id="ai-input"
          placeholder="Ask Kaizen AI..."
          onkeydown="if(event.key==='Enter')sendAI()">
        <button class="ai-send" onclick="sendAI()">Send</button>
      </div>
    </div>

  </div>
</div>

<!-- ADD TO WATCHLIST MODAL -->
<div class="modal-overlay" id="addWLModal">
  <div class="modal">
    <div class="modal-header">
      <h3>Add to Watchlist</h3>
      <button class="modal-close" onclick="closeModal('addWLModal')">×</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;flex-direction:column;gap:12px;">
        <div>
          <label style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:#A8A09A;display:block;margin-bottom:6px;">Symbol</label>
          <input type="text" id="wl-add-input"
            placeholder="e.g. BTCUSDT, EURUSD, AAPL"
            style="width:100%;background:#161616;border:1px solid rgba(255,255,255,0.08);color:#F5F3EF;padding:10px 14px;outline:none;font-family:'DM Mono',monospace;font-size:0.82rem;">
        </div>
        <div>
          <label style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:#A8A09A;display:block;margin-bottom:6px;">Category</label>
          <select id="wl-add-cat"
            style="width:100%;background:#161616;border:1px solid rgba(255,255,255,0.08);color:#F5F3EF;padding:10px 14px;outline:none;font-family:'DM Mono',monospace;font-size:0.78rem;">
            <option value="crypto">Crypto</option>
            <option value="forex">Forex</option>
            <option value="stocks">Stocks</option>
            <option value="indices">Indices</option>
            <option value="synthetic">Synthetic</option>
            <option value="commodities">Commodities</option>
          </select>
        </div>
        <button onclick="addToWatchlist()"
          style="background:#C9A84C;color:#000;border:none;font-family:'DM Mono',monospace;font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;padding:12px;cursor:pointer;">
          Add to Watchlist
        </button>
      </div>
    </div>
  </div>
</div>

<!-- TradingView Widget -->
<script type="text/javascript"
  src="https://s3.tradingview.com/tv.js"></script>

<script src="/js/app.js"></script>
<script>
  // ── TRADINGVIEW CHART
  let tvWidget = null;
  let currentSymbol = 'BINANCE:BTCUSDT';

  function initChart(symbol) {
    if (tvWidget) {
      try { tvWidget.remove(); } catch(e) {}
    }
    currentSymbol = symbol || 'BINANCE:BTCUSDT';
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';

    tvWidget = new TradingView.widget({
      container_id: 'tv-chart-container',
      width: '100%',
      height: '100%',
      symbol: currentSymbol,
      interval: '60',
      timezone: 'Etc/UTC',
      theme: isDark ? 'dark' : 'light',
      style: '1',
      locale: 'en',
      toolbar_bg: isDark ? '#080808' : '#f5f5f5',
      enable_publishing: false,
      allow_symbol_change: true,
      hide_top_toolbar: false,
      hide_legend: false,
      save_image: true,
      no_referral_id: true,
      autosize: true
    });
  }

  initChart();

  // ── WATCHLIST DATA
  const DEFAULT_WL = [
    { symbol: 'BINANCE:BTCUSDT', label: 'BTC/USDT', cat: 'crypto' },
    { symbol: 'BINANCE:ETHUSDT', label: 'ETH/USDT', cat: 'crypto' },
    { symbol: 'BINANCE:SOLUSDT', label: 'SOL/USDT', cat: 'crypto' },
    { symbol: 'BINANCE:XRPUSDT', label: 'XRP/USDT', cat: 'crypto' },
    { symbol: 'FX:EURUSD', label: 'EUR/USD', cat: 'forex' },
    { symbol: 'FX:GBPUSD', label: 'GBP/USD', cat: 'forex' },
    { symbol: 'FX:USDJPY', label: 'USD/JPY', cat: 'forex' },
    { symbol: 'FX:AUDUSD', label: 'AUD/USD', cat: 'forex' },
    { symbol: 'NASDAQ:AAPL', label: 'Apple', cat: 'stocks' },
    { symbol: 'NASDAQ:TSLA', label: 'Tesla', cat: 'stocks' },
    { symbol: 'NASDAQ:NVDA', label: 'NVIDIA', cat: 'stocks' },
    { symbol: 'SP:SPX', label: 'S&P 500', cat: 'indices' },
    { symbol: 'NASDAQ:NDX', label: 'NASDAQ 100', cat: 'indices' },
    { symbol: 'CURRENCYCOM:XAUUSD', label: 'Gold', cat: 'commodities' },
    { symbol: 'CURRENCYCOM:XAGUSD', label: 'Silver', cat: 'commodities' },
    { symbol: 'CURRENCYCOM:OIL', label: 'Crude Oil', cat: 'commodities' }
  ];

  let watchlist = JSON.parse(localStorage.getItem('kaizen_watchlist') ||
    JSON.stringify(DEFAULT_WL));
  let currentCat = 'all';

  function saveWL() {
    localStorage.setItem('kaizen_watchlist', JSON.stringify(watchlist));
  }

  function renderWL(items) {
    const list = document.getElementById('wl-list');
    if (!list) return;
    list.innerHTML = '';

    items.forEach(function(item) {
      const el = document.createElement('div');
      el.className = 'watchlist-item' +
        (item.symbol === currentSymbol ? ' active' : '');
      el.innerHTML = `
        <div>
          <div class="wl-symbol">${item.label}</div>
          <div class="wl-price" style="font-size:0.58rem;color:#555;">${item.cat}</div>
        </div>
        <div style="display:flex;align-items:center;gap:4px;">
          <button class="wl-remove" onclick="removeWL(event,'${item.symbol}')">✕</button>
        </div>
      `;
      el.addEventListener('click', function() {
        loadSymbol(item.symbol, item.label);
      });
      list.appendChild(el);
    });
  }

  function filterWL(btn, cat) {
    document.querySelectorAll('.wl-cat').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');
    currentCat = cat;

    const filtered = cat === 'all'
      ? watchlist
      : watchlist.filter(function(i) { return i.cat === cat; });
    renderWL(filtered);
  }

  function searchWL(q) {
    const filtered = watchlist.filter(function(i) {
      return i.label.toLowerCase().includes(q.toLowerCase()) ||
             i.symbol.toLowerCase().includes(q.toLowerCase());
    });
    renderWL(filtered);
  }

  function loadSymbol(symbol, label) {
    currentSymbol = symbol;
    const quick = document.getElementById('quick-asset');
    if (quick) quick.value = label || symbol;
    initChart(symbol);
    renderWL(currentCat === 'all' ? watchlist :
      watchlist.filter(function(i) { return i.cat === currentCat; }));
  }

  function addToWatchlist() {
    const inp = document.getElementById('wl-add-input');
    const cat = document.getElementById('wl-add-cat');
    if (!inp || !inp.value.trim()) return;

    const sym = inp.value.trim().toUpperCase();
    const tvSym = cat.value === 'crypto'
      ? 'BINANCE:' + sym
      : cat.value === 'forex'
      ? 'FX:' + sym.replace('/', '')
      : cat.value === 'stocks'
      ? 'NASDAQ:' + sym
      : sym;

    watchlist.push({
      symbol: tvSym,
      label: sym,
      cat: cat.value
    });

    saveWL();
    closeModal('addWLModal');
    inp.value = '';
    renderWL(watchlist);
  }

  function removeWL(e, symbol) {
    e.stopPropagation();
    watchlist = watchlist.filter(function(i) { return i.symbol !== symbol; });
    saveWL();
    renderWL(currentCat === 'all' ? watchlist :
      watchlist.filter(function(i) { return i.cat === currentCat; }));
  }

  function showAddModal() { openModal('addWLModal'); }

  // Init watchlist
  renderWL(watchlist);

  // ── PANEL TOGGLES
  let wlVisible = true;

  function toggleWatchlist() {
    const panel = document.getElementById('watchlistPanel');
    const btn = document.getElementById('wl-btn');
    wlVisible = !wlVisible;
    panel.classList.toggle('collapsed', !wlVisible);
    btn.classList.toggle('active', wlVisible);
  }

  function openJournalPanel() {
    document.getElementById('journalPanel').classList.add('open');
    document.getElementById('journal-btn').classList.add('active');
  }

  function closeJournalPanel() {
    document.getElementById('journalPanel').classList.remove('open');
    document.getElementById('journal-btn').classList.remove('active');
  }

  let aiVisible = false;
  function toggleAI() {
    aiVisible = !aiVisible;
    document.getElementById('aiPanel').classList.toggle('open', aiVisible);
    document.getElementById('ai-btn').classList.toggle('active', aiVisible);
  }

  // ── POPUP MENU
  function toggleChartPopup() {
    document.getElementById('chartNavPopup').classList.toggle('open');
    document.getElementById('chartPopupOverlay').classList.toggle('open');
  }

  function closeChartPopup() {
    document.getElementById('chartNavPopup').classList.remove('open');
    document.getElementById('chartPopupOverlay').classList.remove('open');
  }

  // ── MODALS
  function openModal(id) {
    document.getElementById(id).classList.add('open');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
  }

  document.querySelectorAll('.modal-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === this) this.classList.remove('open');
    });
  });

  // ── QUICK OPTION SELECT
  function pickQ(el, name, value, color) {
    document.querySelectorAll('.quick-opt').forEach(function(o) {
      const inp = o.querySelector('input');
      if (inp && inp.name === name) {
        o.classList.remove('sel-g', 'sel-r');
        inp.checked = false;
      }
    });
    el.classList.add(color === 'g' ? 'sel-g' : 'sel-r');
    const inp = el.querySelector('input');
    if (inp) inp.checked = true;
  }

  // ── THEME (sync with main app)
  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('kaizen-theme', next);
    const icon = document.getElementById('chartThemeIcon');
    if (icon) icon.textContent = next === 'dark' ? '◑' : '◐';
    // Reinit chart with new theme
    initChart(currentSymbol);
  }

  // Apply saved theme
  const savedTheme = localStorage.getItem('kaizen-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', savedTheme);
  const themeIcon = document.getElementById('chartThemeIcon');
  if (themeIcon) themeIcon.textContent = savedTheme === 'dark' ? '◑' : '◐';

  // ── KAIZEN AI (basic — full AI in Phase 3)
  async function sendAI() {
    const input = document.getElementById('ai-input');
    const messages = document.getElementById('ai-messages');
    if (!input || !input.value.trim()) return;

    const userText = input.value.trim();
    input.value = '';

    // User message
    const userMsg = document.createElement('div');
    userMsg.style.cssText = 'font-size:0.82rem;color:#F5F3EF;line-height:1.6;padding:8px 10px;background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.12);text-align:right;';
    userMsg.textContent = userText;
    messages.appendChild(userMsg);

    // AI thinking
    const thinkMsg = document.createElement('div');
    thinkMsg.className = 'ai-msg';
    thinkMsg.innerHTML = '<div class="ai-msg-label">改 Kaizen</div>Analyzing your session data...';
    messages.appendChild(thinkMsg);
    messages.scrollTop = messages.scrollHeight;

    // Contextual responses based on user data
    setTimeout(function() {
      const responses = {
        default: [
          'Based on your trading profile, focus on following your defined rules before anything else. Consistency is the foundation.',
          'Your discipline score reflects your behavioral patterns. Every compliant session moves you toward Elite tier.',
          'Review your last journal entry. The patterns in your writing reveal more than the trade outcome itself.',
          'Kaizen AI is learning your style. Keep journaling consistently for more personalized insights.',
          'Remember your rule: max <%= user.tradingStyle ? user.tradingStyle.riskPerTrade : "1" %>% risk per trade. Stick to it regardless of conviction.'
        ],
        loss: [
          'A loss is data, not failure. What does your journal say about your rule compliance on this trade?',
          'Before trading again, review your entry criteria. Did this trade match your defined edge?',
          'Your profile shows you tend to break rules after losses. This is the moment to close the platform and journal instead.'
        ],
        win: [
          'Good result. Now check if you followed your rules or if you got lucky. Both look the same on the P&L but only one is repeatable.',
          'Winning trades can be dangerous if they came from breaking your rules. Verify your process first.'
        ]
      };

      const lowerText = userText.toLowerCase();
      let pool = responses.default;
      if (lowerText.includes('loss') || lowerText.includes('lost') || lowerText.includes('down')) {
        pool = responses.loss;
      } else if (lowerText.includes('win') || lowerText.includes('profit') || lowerText.includes('up')) {
        pool = responses.win;
      }

      const reply = pool[Math.floor(Math.random() * pool.length)];
      thinkMsg.innerHTML = '<div class="ai-msg-label">改 Kaizen</div>' + reply;
      messages.scrollTop = messages.scrollHeight;
    }, 1200);
  }

  // Enter key for AI
  document.getElementById('ai-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') sendAI();
  });

</script>

</body>
</html>

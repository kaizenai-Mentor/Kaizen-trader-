<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Chart</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #080808;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: 'Outfit', sans-serif;
    }

    /* ── TOP BAR ── */
    .chart-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      height: 48px;
      background: #0A0A0A;
      border-bottom: 1px solid rgba(201,168,76,0.18);
      flex-shrink: 0;
      gap: 10px;
      z-index: 20;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .back-link {
      font-family: 'DM Mono', monospace;
      font-size: 0.85rem;
      color: #C9A84C;
      text-decoration: none;
      letter-spacing: 0.08em;
      transition: opacity 0.2s;
    }
    .back-link:hover { opacity: 0.7; }

    .chart-title {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: #C9A84C;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .discipline-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: #A8A09A;
      background: rgba(201,168,76,0.06);
      border: 1px solid rgba(201,168,76,0.15);
      padding: 5px 12px;
      white-space: nowrap;
    }
    .discipline-badge span { color: #C9A84C; font-weight: 600; }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Icon buttons in topbar */
    .icon-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid rgba(255,255,255,0.07);
      color: #A8A09A;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s;
      text-decoration: none;
      flex-shrink: 0;
      position: relative;
    }
    .icon-btn:hover {
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
    }
    .icon-btn.active {
      background: rgba(201,168,76,0.1);
      border-color: rgba(201,168,76,0.4);
      color: #C9A84C;
    }

    .icon-btn-tooltip {
      position: absolute;
      bottom: -28px;
      left: 50%;
      transform: translateX(-50%);
      background: #1A1A1A;
      border: 1px solid rgba(255,255,255,0.08);
      color: #A8A09A;
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
      z-index: 100;
    }
    .icon-btn:hover .icon-btn-tooltip { opacity: 1; }

    .log-btn {
      background: rgba(201,168,76,0.1);
      border: 1px solid rgba(201,168,76,0.35);
      color: #C9A84C;
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 6px 14px;
      cursor: pointer;
      white-space: nowrap;
      height: 32px;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .log-btn:hover { background: rgba(201,168,76,0.18); }

    /* THREE DOT MENU (same as main site) */
    .chart-three-dot {
      display: flex;
      flex-direction: column;
      gap: 3px;
      width: 32px;
      height: 32px;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid rgba(255,255,255,0.07);
      cursor: pointer;
      transition: all 0.2s;
    }
    .chart-three-dot span {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #A8A09A;
      display: block;
    }
    .chart-three-dot:hover {
      border-color: rgba(201,168,76,0.35);
    }
    .chart-three-dot:hover span { background: #C9A84C; }

    /* THEME TOGGLE */
    .theme-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid rgba(255,255,255,0.07);
      color: #A8A09A;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .theme-btn:hover {
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
    }

    /* ── CHART BODY ── */
    .chart-body {
      display: flex;
      flex: 1;
      overflow: hidden;
      position: relative;
      min-height: 0;
    } 

    /* ── WATCHLIST SIDEBAR ── */
    .watchlist {
      width: 200px;
      background: #0A0A0A;
      border-right: 1px solid rgba(255,255,255,0.06);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow: hidden;
      transition: width 0.3s;
   }

    .watchlist.collapsed { width: 0; }

    .watchlist-header {
      padding: 10px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
    }

    .watchlist-title {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #C9A84C;
    }

    .watchlist-add {
      background: none;
      border: none;
      color: #C9A84C;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      transition: opacity 0.2s;
    }
    .watchlist-add:hover { opacity: 0.7; }

    .watchlist-search {
      padding: 8px 10px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      flex-shrink: 0;
    }

    .watchlist-search input {
      width: 100%;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.06);
      color: #F5F3EF;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      padding: 5px 8px;
      outline: none;
      letter-spacing: 0.05em;
    }
    .watchlist-search input:focus { border-color: rgba(201,168,76,0.3); }
    .watchlist-search input::placeholder { color: #3A3530; }

    .watchlist-list {
      flex: 1;
      overflow-y: auto;
    }

    .watchlist-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 14px;
      cursor: pointer;
      border-bottom: 1px solid rgba(255,255,255,0.03);
      transition: background 0.15s;
    }
    .watchlist-item:hover { background: rgba(201,168,76,0.05); }
    .watchlist-item.active { background: rgba(201,168,76,0.08); }

    .wl-symbol {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      font-weight: 600;
      color: #F5F3EF;
      letter-spacing: 0.04em;
    }

    .wl-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
    }

    .wl-price {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      color: #A8A09A;
    }

    .wl-change {
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
    }

    .wl-remove {
      opacity: 0;
      background: none;
      border: none;
      color: #F87171;
      font-size: 0.7rem;
      cursor: pointer;
      padding: 0 4px;
      transition: opacity 0.15s;
    }
    .watchlist-item:hover .wl-remove { opacity: 1; }

    .watchlist-categories {
      padding: 6px 10px;
      flex-shrink: 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .wl-cat-scroll {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      padding-bottom: 2px;
    }

    .wl-cat {
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border: 1px solid rgba(255,255,255,0.06);
      color: #A8A09A;
      cursor: pointer;
      white-space: nowrap;
      background: none;
      transition: all 0.15s;
    }
    .wl-cat:hover, .wl-cat.active {
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
      background: rgba(201,168,76,0.05);
    }

    /* ── MAIN CHART ── */
    .chart-main {
      flex: 1;
      position: relative;
      overflow: hidden;
      min-height: 0;
      min-width: 0;
    }

    #tv-chart-container {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    }

    /* ── JOURNAL PANEL (slides up) ── */
    .journal-panel {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: #0F0F0F;
      border-top: 1px solid rgba(201,168,76,0.2);
      height: 320px;
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      z-index: 30;
      display: flex;
      flex-direction: column;
    }

    .journal-panel.open { transform: translateY(0); }

    .panel-header {
      padding: 10px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
      background: #111;
    }

    .panel-title {
      font-family: 'DM Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #C9A84C;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.2rem;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
    }
    .panel-close:hover { color: #F5F3EF; }

    .panel-body {
      flex: 1;
      padding: 14px 16px;
      overflow-y: auto;
    }

    .quick-log-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      height: 100%;
    }

    .quick-row { display: flex; gap: 8px; }

    .quick-input, .quick-textarea, .quick-select {
      background: #161616;
      border: 1px solid rgba(255,255,255,0.07);
      color: #F5F3EF;
      font-family: 'Outfit', sans-serif;
      font-size: 0.82rem;
      padding: 8px 12px;
      outline: none;
      transition: border-color 0.2s;
      width: 100%;
    }
    .quick-input:focus,
    .quick-textarea:focus,
    .quick-select:focus { border-color: #C9A84C; }

    .quick-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #A8A09A;
      display: block;
      margin-bottom: 4px;
    }

    .quick-textarea { min-height: 70px; resize: none; flex: 1; }

    .quick-compliance {
      display: flex;
      gap: 8px;
    }

    .quick-opt {
      flex: 1;
      padding: 7px;
      border: 1px solid rgba(255,255,255,0.07);
      background: #161616;
      cursor: pointer;
      text-align: center;
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #A8A09A;
      transition: all 0.15s;
    }
    .quick-opt input { display: none; }
    .quick-opt.sel-g { border-color: rgba(201,168,76,0.4); background: rgba(201,168,76,0.07); color: #C9A84C; }
    .quick-opt.sel-r { border-color: rgba(248,113,113,0.35); background: rgba(248,113,113,0.05); color: #F87171; }

    .quick-submit {
      background: #C9A84C;
      color: #000;
      border: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 10px;
      width: 100%;
      cursor: pointer;
      transition: background 0.2s;
      flex-shrink: 0;
    }
    .quick-submit:hover { background: #E2C46A; }

    /* ── KAIZEN AI PANEL ── */
    .ai-panel {
      position: absolute;
      top: 48px;
      right: 0;
      width: 280px;
      height: calc(100% - 48px);
      background: #0A0A0A;
      border-left: 1px solid rgba(201,168,76,0.15);
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      z-index: 25;
      display: flex;
      flex-direction: column;
    }
    .ai-panel.open { transform: translateX(0); }

    .ai-panel-header {
      padding: 14px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #111;
      flex-shrink: 0;
    }

    .ai-panel-title {
      font-family: 'DM Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #C9A84C;
    }

    .ai-panel-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .ai-messages {
      flex: 1;
      overflow-y: auto;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ai-msg {
      font-size: 0.82rem;
      color: #A8A09A;
      line-height: 1.7;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.05);
      border-left: 2px solid #C9A84C;
      padding: 10px 12px;
    }

    .ai-msg-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #C9A84C;
      margin-bottom: 5px;
    }

    .ai-input-area {
      padding: 12px 14px;
      border-top: 1px solid rgba(255,255,255,0.06);
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .ai-input {
      flex: 1;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.07);
      color: #F5F3EF;
      font-family: 'Outfit', sans-serif;
      font-size: 0.8rem;
      padding: 8px 10px;
      outline: none;
    }
    .ai-input:focus { border-color: #C9A84C; }

    .ai-send {
      background: rgba(201,168,76,0.1);
      border: 1px solid rgba(201,168,76,0.3);
      color: #C9A84C;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      padding: 8px 12px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .ai-send:hover { background: rgba(201,168,76,0.2); }

    /* POPUP MENU (same as main site) */
    .popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(2px);
    }
    .popup-overlay.open { opacity: 1; pointer-events: all; }

    .nav-popup {
      position: fixed;
      top: 0; right: 0;
      width: 300px;
      height: 100vh;
      background: #131313;
      border-left: 1px solid rgba(255,255,255,0.07);
      z-index: 999;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      box-shadow: -8px 0 40px rgba(0,0,0,0.5);
      overflow-y: auto;
    }
    .nav-popup.open { transform: translateX(0); }

    .popup-header {
      padding: 18px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .popup-logo {
      font-family: 'DM Mono', monospace;
      font-size: 1rem;
      color: #C9A84C;
      font-weight: 500;
      letter-spacing: 0.08em;
    }
    .popup-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
    }

    .popup-section { padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }

    .popup-section-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #A8A09A;
      padding: 6px 20px 3px;
    }

    .popup-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: #F5F3EF;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }
    .popup-item:hover { background: rgba(201,168,76,0.06); color: #C9A84C; }

    .popup-footer {
      margin-top: auto;
      padding: 14px 20px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .popup-user {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .popup-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(201,168,76,0.1);
      border: 1px solid rgba(201,168,76,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #C9A84C;
      font-size: 0.88rem;
      flex-shrink: 0;
    }

    .popup-username { font-weight: 600; font-size: 0.88rem; color: #F5F3EF; }
    .popup-user-email { font-size: 0.72rem; color: #A8A09A; }

    .popup-socials {
      display: flex;
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    .popup-social-link {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,0.08);
      color: #A8A09A;
      transition: all 0.2s;
      text-decoration: none;
    }
    .popup-social-link:hover { border-color: #C9A84C; color: #C9A84C; }

    /* SECURITY MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      z-index: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(4px);
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal {
      background: #111;
      border: 1px solid rgba(255,255,255,0.08);
      width: 100%;
      max-width: 400px;
      position: relative;
    }
    .modal::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #C9A84C, transparent);
    }

    .modal-header {
      padding: 18px 22px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h3 { font-size: 0.95rem; font-weight: 700; color: #F5F3EF; }
    .modal-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
    }
    .modal-body { padding: 22px; }

    @media (max-width: 600px) {
      .chart-title { display: none; }
      .discipline-badge { display: none; }
      .watchlist { display: none; }
      .ai-panel { width: 100%; }
    }
  </style>
</head>
<body>

<!-- POPUP OVERLAY -->
<div class="popup-overlay" id="chartPopupOverlay"
  onclick="closeChartPopup()"></div>

<!-- CHART POPUP MENU -->
<div class="nav-popup" id="chartNavPopup">
  <div class="popup-header">
    <span class="popup-logo">改 KAIZEN</span>
    <button class="popup-close" onclick="closeChartPopup()">×</button>
  </div>

  <div class="popup-section">
    <div class="popup-section-label">Navigation</div>
    <a href="/dashboard" class="popup-item">▪ Dashboard</a>
    <a href="/chart" class="popup-item" style="color:#C9A84C;">▪ Chart</a>
    <a href="/dashboard/journal" class="popup-item">▪ Journal</a>
    <a href="/za/bounties" class="popup-item">▪ Bounties</a>
    <a href="/za/reputation/<%= user.id %>" class="popup-item">▪ Reputation</a>
  </div>

  <div class="popup-section">
    <div class="popup-section-label">Chart Tools</div>
    <button class="popup-item" onclick="toggleWatchlist();closeChartPopup()">
      ▪ Toggle Watchlist
    </button>
    <button class="popup-item" onclick="openJournalPanel();closeChartPopup()">
      ▪ Quick Journal
    </button>
    <button class="popup-item" onclick="toggleAI();closeChartPopup()">
      ▪ Kaizen AI
    </button>
  </div>

  <div class="popup-section">
    <div class="popup-section-label">Settings</div>
    <button class="popup-item" onclick="toggleTheme();closeChartPopup()">
      ▪ Dark / Light Mode
    </button>
    <button class="popup-item" onclick="openModal('securityModal');closeChartPopup()">
      ▪ Security
    </button>
  </div>

  <div class="popup-section">
    <div class="popup-section-label">Info</div>
    <a href="/about" class="popup-item">▪ About Kaizen</a>
    <a href="/help" class="popup-item">▪ Help Center</a>
    <a href="/support" class="popup-item">▪ Support</a>
  </div>


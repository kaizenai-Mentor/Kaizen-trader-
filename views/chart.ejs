<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Chart</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #080808;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: 'Outfit', sans-serif;
    }

    .chart-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
      background: #0A0A0A;
      border-bottom: 1px solid rgba(201,168,76,0.18);
      flex-shrink: 0;
      gap: 12px;
      flex-wrap: wrap;
      z-index: 10;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .back-link {
      font-family: 'DM Mono', monospace;
      font-size: 0.85rem;
      color: #C9A84C;
      text-decoration: none;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.2s;
    }
    .back-link:hover { opacity: 0.7; }

    .chart-logo {
      font-family: 'DM Mono', monospace;
      font-size: 0.82rem;
      color: rgba(201,168,76,0.6);
      letter-spacing: 0.1em;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .topbar-btn {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #A8A09A;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.07);
      padding: 7px 14px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .topbar-btn:hover {
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
    }
    .topbar-btn-gold {
      background: rgba(201,168,76,0.1);
      border-color: rgba(201,168,76,0.35);
      color: #C9A84C;
    }
    .topbar-btn-gold:hover {
      background: rgba(201,168,76,0.18);
    }

    .discipline-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      color: #A8A09A;
      background: #111;
      border: 1px solid rgba(201,168,76,0.15);
      padding: 7px 14px;
      white-space: nowrap;
    }
    .discipline-badge span {
      color: #C9A84C;
      font-weight: 600;
    }

    .chart-frame {
      flex: 1;
      overflow: hidden;
      position: relative;
    }

    .chart-frame iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    /* LOG MODAL */
    .log-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.88);
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      backdrop-filter: blur(6px);
    }
    .log-modal.open {
      opacity: 1;
      pointer-events: all;
    }

    .log-card {
      background: #111;
      border: 1px solid rgba(201,168,76,0.25);
      width: 100%;
      max-width: 480px;
      max-height: 88vh;
      overflow-y: auto;
      position: relative;
    }
    .log-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #C9A84C, transparent);
    }

    .log-header {
      padding: 18px 22px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .log-header h3 {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #C9A84C;
    }
    .log-close {
      background: none;
      border: none;
      color: #A8A09A;
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
    }
    .log-close:hover { color: #F5F3EF; }

    .log-body { padding: 20px 22px; }

    .log-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .log-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #A8A09A;
      display: block;
      margin-bottom: 6px;
    }

    .log-input, .log-textarea {
      width: 100%;
      background: #161616;
      border: 1px solid rgba(255,255,255,0.07);
      color: #F5F3EF;
      font-family: 'Outfit', sans-serif;
      font-size: 0.88rem;
      padding: 10px 14px;
      outline: none;
      transition: border-color 0.2s;
    }
    .log-input:focus, .log-textarea:focus { border-color: #C9A84C; }
    .log-textarea {
      min-height: 110px;
      resize: vertical;
      line-height: 1.7;
    }

    .log-row { display: flex; gap: 10px; }

    .log-opt {
      flex: 1;
      padding: 10px;
      border: 1px solid rgba(255,255,255,0.07);
      background: #161616;
      cursor: pointer;
      text-align: center;
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #A8A09A;
      transition: all 0.2s;
    }
    .log-opt:hover { border-color: rgba(201,168,76,0.3); color: #C9A84C; }
    .log-opt input { display: none; }
    .log-opt.selected-gold {
      border-color: rgba(201,168,76,0.45);
      background: rgba(201,168,76,0.08);
      color: #C9A84C;
    }
    .log-opt.selected-red {
      border-color: rgba(248,113,113,0.4);
      background: rgba(248,113,113,0.06);
      color: #F87171;
    }

    .log-submit {
      background: #C9A84C;
      color: #000;
      border: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 14px;
      width: 100%;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 4px;
    }
    .log-submit:hover { background: #E2C46A; }

    @media (max-width: 600px) {
      .chart-topbar { padding: 8px 12px; }
      .chart-logo { display: none; }
      .discipline-badge { display: none; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="chart-topbar">
    <div class="topbar-left">
      <a href="/dashboard" class="back-link">← 改</a>
      <span class="chart-logo">KAIZEN Chart</span>
    </div>
    <div class="topbar-right">
      <div class="discipline-badge">
        Score: <span><%= user.disciplineScore || 0 %>/100</span>
      </div>
      <button class="topbar-btn topbar-btn-gold" onclick="openLog()">
        + Log Session
      </button>
      <a href="/dashboard/journal" class="topbar-btn">Journal</a>
      <a href="/za/bounties" class="topbar-btn">Bounties</a>
      <a href="/dashboard" class="topbar-btn">Dashboard</a>
    </div>
  </div>

  <!-- TRADINGVIEW CHART -->
  <div class="chart-frame">
    <iframe
      src="https://s.tradingview.com/widgetsnippets/embed/advanced-chart/?symbol=BINANCE%3ABTCUSDT&interval=60&theme=dark&style=1&locale=en&enable_publishing=false&allow_symbol_change=true&save_image=true&hide_volume=false&support_host=https%3A%2F%2Fwww.tradingview.com"
      allowfullscreen
      allow="autoplay; fullscreen">
    </iframe>
  </div>

  <!-- LOG SESSION MODAL -->
  <div class="log-modal" id="logModal">
    <div class="log-card">
      <div class="log-header">
        <h3>Log This Session</h3>
        <button class="log-close" onclick="closeLog()">×</button>
      </div>
      <div class="log-body">
        <form action="/dashboard/journal" method="POST" class="log-form">

          <div>
            <label class="log-label">Asset Analyzed</label>
            <input type="text" name="asset" class="log-input"
              placeholder="e.g. BTC/USDT, EUR/USD, GOLD" required>
          </div>

          <div>
            <label class="log-label">Session Type</label>
            <div class="log-row">
              <div class="log-opt" id="opt-live" onclick="selectOpt(this,'direction','Live Trade','gold')">
                <input type="radio" name="direction" value="Live Trade" required>
                Live Trade
              </div>
              <div class="log-opt" id="opt-back" onclick="selectOpt(this,'direction','Backtesting','gold')">
                <input type="radio" name="direction" value="Backtesting">
                Backtesting
              </div>
            </div>
          </div>

          <div>
            <label class="log-label">Session Notes</label>
            <textarea name="notes" class="log-textarea"
              placeholder="What did you see? What trade did you take and why? How did you feel? Did you follow your rules? Be completely honest — Kaizen AI learns from this."
              required></textarea>
          </div>

          <div>
            <label class="log-label">Did you follow ALL your rules?</label>
            <div class="log-row">
              <div class="log-opt" id="opt-yes" onclick="selectOpt(this,'ruleCompliance','true','gold')">
                <input type="radio" name="ruleCompliance" value="true" required>
                Yes — Compliant
              </div>
              <div class="log-opt" id="opt-no" onclick="selectOpt(this,'ruleCompliance','false','red')">
                <input type="radio" name="ruleCompliance" value="false">
                No — Violated
              </div>
            </div>
          </div>

          <input type="hidden" name="timeframe" value="Chart Session">
          <input type="hidden" name="outcome" value="Pending">
          <input type="hidden" name="emotion" value="Logged from Chart">
          <input type="hidden" name="sessionScore" value="50">

          <button type="submit" class="log-submit">Save Session Entry</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    function openLog() {
      document.getElementById('logModal').classList.add('open');
    }

    function closeLog() {
      document.getElementById('logModal').classList.remove('open');
    }

    document.getElementById('logModal').addEventListener('click', function(e) {
      if (e.target === this) closeLog();
    });

    function selectOpt(el, name, value, color) {
      // Unselect all in group
      document.querySelectorAll('.log-opt').forEach(function(o) {
        const input = o.querySelector('input');
        if (input && input.name === name) {
          o.classList.remove('selected-gold', 'selected-red');
          input.checked = false;
        }
      });
      // Select this one
      el.classList.add(color === 'gold' ? 'selected-gold' : 'selected-red');
      const input = el.querySelector('input');
      if (input) input.checked = true;
    }
  </script>

</body>
</html>

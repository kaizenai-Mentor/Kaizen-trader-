<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.home') %></title>
</head>
<body class="welcome-page" style="min-height:100vh;background:var(--bg-base);color:var(--text-primary);">
  <%- include('partials/navbar') %>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="alert alert-success" style="text-align:center;margin:0;border-radius:0;"><%= t('welcome.deleted') %></div>
  <% } %>

  <!-- ============================================================
       HERO — problem first, instrument panel right
  ============================================================ -->
  <section class="k-hero k-grid-bg">

    <div class="k-hero-inner">

      <div class="k-hero-copy" data-reveal>
        <h1 class="k-hero-h1">
          <%= t('welcome.hero1') %><br>
          <%= t('welcome.hero2') %><br>
          <span class="k-gold"><%= t('welcome.hero3') %></span>
        </h1>

        <p class="k-hero-sub"><%= t('welcome.sub1') %><strong style="color:var(--text-primary);"><%= t('welcome.sub2') %></strong>
        </p>

        <p class="k-hero-sub2"><%= t('welcome.tagline') %></p>

        <div class="k-hero-ctas">
          <a href="/auth/register" class="btn-primary k-btn-lg"><%= t('welcome.ctaStart') %></a>
          <a href="#how-it-works" class="btn-outline k-btn-lg"><%= t('welcome.ctaHow') %></a>
        </div>

        <!-- English-only product (owner directive 19 Oct 2026) — no language bar -->
        <div class="k-hero-sub2" style="margin-top:18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
          <span style="font-size:0.72rem;color:var(--ash);"><%= t('welcome.onboardingBar') %></span>
        </div>
      </div>

      <div class="k-hero-panel k-card--elevated k-grid-bg" data-reveal style="transition-delay:120ms;">
        <div class="k-panel-head">
          <span class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span><%= t('dash.score') %></span>
          <span class="k-tag"><%= t('welcome.preview') %></span>
        </div>

        <div class="k-panel-dial">
          <%- include('partials/k-dial', { value: 76, size: 200 }) %>
        </div>

        <%- include('partials/k-meters', { meters: [
          [t('dash.dimProcess'), 91],
          [t('dash.dimRisk'), 89],
          [t('dash.dimExecution'), 84],
          [t('dash.dimBehavior'), 79],
          [t('dash.dimLearning'), 86]
        ] }) %>

        <div class="k-panel-foot"><%= t('welcome.scoreNote') %></div>
      </div>

    </div>

    <!-- Trust row -->
    <div class="k-trust-row" data-reveal>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="zap" width="18" height="18"></i></div>
        <div class="k-trust-label"><%= t('welcome.feat1') %></div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="activity" width="18" height="18"></i></div>
        <div class="k-trust-label"><%= t('welcome.feat2') %></div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="bar-chart-2" width="18" height="18"></i></div>
        <div class="k-trust-label"><%= t('welcome.feat3') %></div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="unlock" width="18" height="18"></i></div>
        <div class="k-trust-label"><%= t('welcome.free100') %></div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PRODUCT PREVIEW
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-eyebrow k-eyebrow--center" data-reveal><%= t('welcome.inside') %></div>
    <h2 class="k-title k-title--center" data-reveal><%= t('welcome.insideSub') %></h2>
    <p class="k-sub" data-reveal><%= t('welcome.insideP') %></p>

    <div class="k-preview-grid">

      <div class="k-preview-card k-card k-card--elevated k-card--hover" data-reveal>
        <div class="k-card-label"><i data-feather="bar-chart-2" width="14" height="14"></i><%= t('dash.score') %></div>
        <div style="display:flex;justify-content:center;padding:12px 0;">
          <%- include('partials/k-dial', { value: 76, size: 140 }) %>
        </div>
        <p class="k-preview-desc"><%= t('welcome.scoreNote') %></p>
      </div>

      <div class="k-preview-card k-card k-card--featured" data-reveal style="transition-delay:80ms;">
        <div class="k-card-label"><span class="k-kanji k-kanji--sm">改</span><%= t('welcome.aiResp') %></div>
        <div class="k-metric-label"><%= t('welcome.aiWhere') %></div>
        <p class="k-ai-text"><%= t('welcome.aiWhereBody') %></p>
        <div class="k-metric-label" style="margin-top:16px;"><%= t('welcome.aiFocus') %></div>
        <p class="k-ai-text"><%= t('welcome.aiFocusBody') %></p>
        <div class="k-ai-score-line"><%= t('welcome.scoreColon') %><strong>61</strong></div>
      </div>

      <div class="k-preview-card k-card k-card--hover" data-reveal style="transition-delay:160ms;">
        <div class="k-card-label"><i data-feather="activity" width="14" height="14"></i><%= t('welcome.pattern') %></div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div class="k-chip k-chip--warn"><i data-feather="alert-triangle" width="13" height="13"></i><%= t('welcome.pat1') %></div>
          <div class="k-chip k-chip--watch"><i data-feather="clock" width="13" height="13"></i><%= t('welcome.pat2') %></div>
          <div class="k-chip k-chip--good"><i data-feather="check-circle" width="13" height="13"></i><%= t('welcome.pat3') %></div>
          <div class="k-chip k-chip--warn"><i data-feather="trending-down" width="13" height="13"></i><%= t('welcome.pat4') %></div>
        </div>
        <p class="k-preview-desc"><%= t('welcome.patNote') %></p>
      </div>

    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS — the improvement loop
  ============================================================ -->
  <section id="how-it-works" class="k-section k-section--border k-grid-bg">
    <div class="k-eyebrow k-eyebrow--center" data-reveal><%= t('welcome.how') %></div>
    <h2 class="k-title k-title--center" data-reveal><%= t('welcome.loop') %></h2>
    <div style="display:flex;justify-content:center;margin-bottom:8px;" data-reveal>
      <div class="k-loop">
        <span><%= t('welcome.wPlan') %></span><b>→</b>
        <span><%= t('welcome.wTrade') %></span><b>→</b>
        <span><%= t('welcome.wReflect') %></span><b>→</b>
        <span><%= t('welcome.wAnalyze') %></span><b>→</b>
        <span><%= t('welcome.wImprove') %></span><b>→</b>
        <span><%= t('welcome.wRepeat') %></span>
      </div>
    </div>

    <div class="k-steps">

      <div class="k-step" data-reveal>
        <div class="k-step-num">01</div>
        <div class="k-step-kicker"><%= t('welcome.wPlan') %></div>
        <div class="k-step-icon"><i data-feather="sliders" width="22" height="22"></i></div>
        <h3><%= t('welcome.s1t') %></h3>
        <p><%= t('welcome.s1b') %></p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:60ms;">
        <div class="k-step-num">02</div>
        <div class="k-step-kicker"><%= t('welcome.wTrade') %></div>
        <div class="k-step-icon"><i data-feather="edit-3" width="22" height="22"></i></div>
        <h3><%= t('welcome.s2t') %></h3>
        <p><%= t('welcome.s2b') %></p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:120ms;">
        <div class="k-step-num">03</div>
        <div class="k-step-kicker"><%= t('welcome.wReflect') %></div>
        <div class="k-step-icon"><i data-feather="search" width="22" height="22"></i></div>
        <h3><%= t('welcome.s3t') %></h3>
        <p><%= t('welcome.s3b') %></p>
      </div>

      <div class="k-step k-step--featured" data-reveal style="transition-delay:180ms;">
        <div class="k-step-num">04</div>
        <div class="k-step-kicker"><%= t('welcome.wAnalyze') %></div>
        <div class="k-step-icon"><span class="k-kanji k-kanji--md">改</span></div>
        <h3><%= t('welcome.s4t') %></h3>
        <p><%= t('welcome.s4b') %></p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:240ms;">
        <div class="k-step-num">05</div>
        <div class="k-step-kicker"><%= t('welcome.wImprove') %></div>
        <div class="k-step-icon"><i data-feather="trending-up" width="22" height="22"></i></div>
        <h3><%= t('welcome.s5t') %></h3>
        <p><%= t('welcome.s5b') %></p>
      </div>

    </div>
  </section>

  <!-- ============================================================
       WHAT KAIZEN TRACKS
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-tracks">

      <div data-reveal>
        <div class="k-eyebrow"><%= t('welcome.tracks') %></div>
        <h2 class="k-title"><%= t('welcome.tracksSub') %></h2>
        <p style="font-size:0.95rem;color:var(--text-secondary);line-height:1.85;margin:0 0 32px;"><%= t('welcome.tracksP') %></p>
        <a href="/auth/register" class="btn-primary"><%= t('welcome.startNow') %></a>
      </div>

      <div data-reveal style="transition-delay:100ms;">

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="check-square" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title"><%= t('welcome.tr1') %></div>
            <div class="k-track-desc"><%= t('welcome.tr1b') %></div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="zap" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title"><%= t('welcome.tr2') %></div>
            <div class="k-track-desc"><%= t('welcome.tr2b') %></div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="target" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title"><%= t('welcome.tr3') %></div>
            <div class="k-track-desc"><%= t('welcome.tr3b') %></div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="trending-up" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title"><%= t('welcome.tr4') %></div>
            <div class="k-track-desc"><%= t('welcome.tr4b') %></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHO KAIZEN IS FOR
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-eyebrow k-eyebrow--center" data-reveal><%= t('welcome.who') %></div>
    <h2 class="k-title k-title--center" data-reveal><%= t('welcome.whoSub') %></h2>
    <p class="k-sub" data-reveal><%= t('welcome.whoP') %></p>

    <div class="k-audience-grid">

      <div class="k-audience-card k-card k-card--hover" data-reveal>
        <div class="k-audience-icon"><i data-feather="book-open" width="18" height="18"></i></div>
        <div class="k-audience-tier"><%= t('welcome.t1') %></div>
        <h3 class="k-audience-level"><%= t('welcome.t1s') %></h3>
        <p class="k-audience-desc"><%= t('welcome.t1b') %></p>
      </div>

      <div class="k-audience-card k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-audience-icon"><i data-feather="compass" width="18" height="18"></i></div>
        <div class="k-audience-tier"><%= t('welcome.t2') %></div>
        <h3 class="k-audience-level"><%= t('welcome.t2s') %></h3>
        <p class="k-audience-desc"><%= t('welcome.t2b') %></p>
      </div>

      <div class="k-audience-card k-card k-card--featured" data-reveal style="transition-delay:120ms;">
        <div class="k-audience-icon"><i data-feather="trending-up" width="18" height="18"></i></div>
        <div class="k-audience-tier"><%= t('welcome.t3') %></div>
        <h3 class="k-audience-level"><%= t('welcome.t3s') %></h3>
        <p class="k-audience-desc"><%= t('welcome.t3b') %></p>
      </div>

      <div class="k-audience-card k-card k-card--hover" data-reveal style="transition-delay:180ms;">
        <div class="k-audience-icon"><i data-feather="award" width="18" height="18"></i></div>
        <div class="k-audience-tier"><%= t('welcome.t4') %></div>
        <h3 class="k-audience-level"><%= t('welcome.t4s') %></h3>
        <p class="k-audience-desc"><%= t('welcome.t4b') %></p>
      </div>

    </div>

    <!-- Final CTA -->
    <div class="k-final-cta" style="margin-top:72px;" data-reveal>
      <div class="k-eyebrow k-eyebrow--center"><%= t('welcome.final') %></div>
      <h2 class="k-cta-h"><%= t('welcome.final1') %><span class="k-gold"><%= t('welcome.final2') %></span>
      </h2>
      <p class="k-cta-sub"><%= t('welcome.finalSub') %></p>
      <div class="k-cta-btns">
        <a href="/auth/register" class="btn-primary k-btn-lg"><%= t('welcome.create') %></a>
        <a href="/about" class="btn-outline k-btn-lg"><%= t('welcome.learn') %></a>
      </div>
    </div>

  </section>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script src="/js/v2-reveal.js"></script>
  <script>if (window.feather) feather.replace();</script>
  <script>
    // Hero typing reveal — the promise types itself out on load.
    // prefers-reduced-motion: hero renders instantly (untouched).
    (function () {
      var h = document.querySelector('.k-hero-h1');
      if (!h) return;
      var reduced = window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      var lines = [
        { text: <%- JSON.stringify(t('welcome.hero1')) %>, gold: false },
        { text: <%- JSON.stringify(t('welcome.hero2')) %>, gold: false },
        { text: <%- JSON.stringify(t('welcome.hero3')) %>, gold: true }
      ];
      var spans = [];
      h.innerHTML = '';
      function ensureLine(i) {
        if (spans[i]) return spans[i];
        if (i > 0) h.appendChild(document.createElement('br'));
        var sp = document.createElement('span');
        if (lines[i].gold) sp.className = 'k-gold';
        h.appendChild(sp);
        spans[i] = sp;
        return sp;
      }
      var li = 0, ci = 0;
      function tick() {
        if (li >= lines.length) return;
        var sp = ensureLine(li);
        ci += 1;
        sp.textContent = lines[li].text.slice(0, ci);
        if (ci >= lines[li].text.length) { li += 1; ci = 0; setTimeout(tick, 420); return; }
        setTimeout(tick, 38);
      }
      h.style.minHeight = '3.6em'; // reserve space while typing (no layout jump)
      setTimeout(tick, 450);
    })();
  </script>
</body>
</html>

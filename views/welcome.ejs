<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN - Trade Better. Every Day.</title>
</head>
<body class="welcome-page" style="min-height:100vh;background:var(--bg-base);color:var(--text-primary);">
  <%- include('partials/navbar') %>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="alert alert-success" style="text-align:center;margin:0;border-radius:0;">
      Your account has been deleted successfully.
    </div>
  <% } %>

  <!-- ============================================================
       HERO — problem first, instrument panel right
  ============================================================ -->
  <section class="k-hero k-grid-bg">

    <div class="k-hero-inner">

      <div class="k-hero-copy" data-reveal>
        <h1 class="k-hero-h1">
          Most traders know<br>
          their rules.<br>
          <span class="k-gold">Few follow them.</span>
        </h1>

        <p class="k-hero-sub">
          KAIZEN is a trader improvement platform that turns your trading
          behavior into measurable progress. It learns your rules, reads
          every session you log, and shows you the patterns you can't
          see — so you can become the trader you can
          <strong style="color:var(--text-primary);">prove you're becoming.</strong>
        </p>

        <p class="k-hero-sub2">
          Not a signal app. Not a copy-trading platform.
          A mentor that makes you a better trader from the inside out.
        </p>

        <div class="k-hero-ctas">
          <a href="/auth/register" class="btn-primary k-btn-lg">Start Improving</a>
          <a href="#how-it-works" class="btn-outline k-btn-lg">See How It Works</a>
        </div>
      </div>

      <div class="k-hero-panel k-card--elevated k-grid-bg" data-reveal style="transition-delay:120ms;">
        <div class="k-panel-head">
          <span class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span> KAIZEN SCORE</span>
          <span class="k-tag">Live Preview</span>
        </div>

        <div class="k-panel-dial">
          <%- include('partials/k-dial', { value: 76, size: 200, label: 'KAIZEN Score' }) %>
        </div>

        <%- include('partials/k-meters', { meters: [
          ['Process', 91],
          ['Risk', 89],
          ['Execution', 84],
          ['Behavior', 79],
          ['Learning & Consistency', 86]
        ] }) %>

        <div class="k-panel-foot">
          Updates after every session. Measures how you traded — not what you made.
        </div>
      </div>

    </div>

    <!-- Trust row -->
    <div class="k-trust-row" data-reveal>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="zap" width="18" height="18"></i></div>
        <div class="k-trust-label">AI-Powered Analysis</div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="activity" width="18" height="18"></i></div>
        <div class="k-trust-label">Behavioral Pattern Detection</div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="bar-chart-2" width="18" height="18"></i></div>
        <div class="k-trust-label">KAIZEN Score Tracking</div>
      </div>
      <div class="k-trust-item">
        <div class="k-trust-icon"><i data-feather="unlock" width="18" height="18"></i></div>
        <div class="k-trust-label">100% Free to Start</div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PRODUCT PREVIEW
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-eyebrow k-eyebrow--center" data-reveal>Inside KAIZEN</div>
    <h2 class="k-title k-title--center" data-reveal>Built for traders</h2>
    <p class="k-sub" data-reveal>
      Every session logged becomes data. Every pattern detected becomes
      insight. Every insight becomes discipline.
    </p>

    <div class="k-preview-grid">

      <div class="k-preview-card k-card k-card--elevated k-card--hover" data-reveal>
        <div class="k-card-label"><i data-feather="bar-chart-2" width="14" height="14"></i> KAIZEN SCORE</div>
        <div style="display:flex;justify-content:center;padding:12px 0;">
          <%- include('partials/k-dial', { value: 76, size: 140, label: 'KAIZEN Score' }) %>
        </div>
        <p class="k-preview-desc">
          Updates after every session. Measures how you traded —
          not what you made.
        </p>
      </div>

      <div class="k-preview-card k-card k-card--featured" data-reveal style="transition-delay:80ms;">
        <div class="k-card-label"><span class="k-kanji k-kanji--sm">改</span> KAIZEN AI RESPONSE</div>
        <div class="k-metric-label">Where the breakdown occurred</div>
        <p class="k-ai-text">
          The EURUSD entry came before your 30min MSS confirmed. You have
          documented this exact sequence three times. Valid zone, valid
          direction — premature entry. That nine-second gap between price
          moving and your decision is where FOMO lives.
        </p>
        <div class="k-metric-label" style="margin-top:16px;">One thing to focus on</div>
        <p class="k-ai-text">
          Before your next EURUSD trade, set a timer for five minutes after
          the 4H sweep. Do nothing. Enter only if MSS confirms.
        </p>
        <div class="k-ai-score-line">KAIZEN SCORE: <strong>61</strong></div>
      </div>

      <div class="k-preview-card k-card k-card--hover" data-reveal style="transition-delay:160ms;">
        <div class="k-card-label"><i data-feather="activity" width="14" height="14"></i> PATTERN DETECTION</div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div class="k-chip k-chip--warn"><i data-feather="alert-triangle" width="13" height="13"></i> FOMO detected · 4 sessions</div>
          <div class="k-chip k-chip--watch"><i data-feather="clock" width="13" height="13"></i> Premature entries · EURUSD</div>
          <div class="k-chip k-chip--good"><i data-feather="check-circle" width="13" height="13"></i> AUDJPY compliance · improving</div>
          <div class="k-chip k-chip--warn"><i data-feather="trending-down" width="13" height="13"></i> Friday compliance · −18%</div>
        </div>
        <p class="k-preview-desc">
          Patterns your P&amp;L will never show. Only your journal can
          reveal them.
        </p>
      </div>

    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS — the improvement loop
  ============================================================ -->
  <section id="how-it-works" class="k-section k-section--border k-grid-bg">
    <div class="k-eyebrow k-eyebrow--center" data-reveal>How It Works</div>
    <h2 class="k-title k-title--center" data-reveal>The improvement loop</h2>
    <div style="display:flex;justify-content:center;margin-bottom:8px;" data-reveal>
      <div class="k-loop">
        <span>Plan</span><b>→</b>
        <span>Trade</span><b>→</b>
        <span>Reflect</span><b>→</b>
        <span>Analyze</span><b>→</b>
        <span>Improve</span><b>→</b>
        <span>Repeat</span>
      </div>
    </div>

    <div class="k-steps">

      <div class="k-step" data-reveal>
        <div class="k-step-num">01</div>
        <div class="k-step-kicker">Plan</div>
        <div class="k-step-icon"><i data-feather="sliders" width="22" height="22"></i></div>
        <h3>Define Your System</h3>
        <p>
          Your setups, entry and exit rules, risk rules, and no-trade
          conditions — set once, refined as you grow. This becomes the
          standard KAIZEN measures you against. Your rules, not ours.
        </p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:60ms;">
        <div class="k-step-num">02</div>
        <div class="k-step-kicker">Trade</div>
        <div class="k-step-icon"><i data-feather="edit-3" width="22" height="22"></i></div>
        <h3>Log Every Session</h3>
        <p>
          Plan before you enter. Journal after you exit. What you saw,
          what you did, what you felt. Honest notes, every time.
        </p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:120ms;">
        <div class="k-step-num">03</div>
        <div class="k-step-kicker">Reflect</div>
        <div class="k-step-icon"><i data-feather="search" width="22" height="22"></i></div>
        <h3>Face What Happened</h3>
        <p>
          Did you follow your plan? What went wrong? What did you learn?
          Structured reflection is where a session becomes a lesson.
        </p>
      </div>

      <div class="k-step k-step--featured" data-reveal style="transition-delay:180ms;">
        <div class="k-step-num">04</div>
        <div class="k-step-kicker">Analyze</div>
        <div class="k-step-icon"><span class="k-kanji k-kanji--md">改</span></div>
        <h3>KAIZEN AI Responds</h3>
        <p>
          The AI reads every entry against your rules and your full
          history, identifies your patterns, and gives you specific,
          actionable feedback. Never generic advice.
        </p>
      </div>

      <div class="k-step" data-reveal style="transition-delay:240ms;">
        <div class="k-step-num">05</div>
        <div class="k-step-kicker">Improve</div>
        <div class="k-step-icon"><i data-feather="trending-up" width="22" height="22"></i></div>
        <h3>Watch Yourself Get Better</h3>
        <p>
          Your KAIZEN Score updates after every session, across five
          dimensions. Improvement becomes visible — and over time, provable.
        </p>
      </div>

    </div>
  </section>

  <!-- ============================================================
       WHAT KAIZEN TRACKS
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-tracks">

      <div data-reveal>
        <div class="k-eyebrow">What KAIZEN AI Tracks</div>
        <h2 class="k-title">The patterns you cannot see yourself</h2>
        <p style="font-size:0.95rem;color:var(--text-secondary);line-height:1.85;margin:0 0 32px;">
          KAIZEN AI learns from every session you log. Over time it builds
          a behavioral profile specific to you — your triggers, your
          tendencies, your blind spots — and surfaces them with data you
          cannot argue with.
        </p>
        <a href="/auth/register" class="btn-primary">Start Tracking Now</a>
      </div>

      <div data-reveal style="transition-delay:100ms;">

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="check-square" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title">Rule Compliance Rate</div>
            <div class="k-track-desc">Tracks whether you follow your own defined entry and risk rules across every session.</div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="zap" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title">Emotional Trigger Patterns</div>
            <div class="k-track-desc">Detects FOMO, revenge trading, and overconfidence in your writing before they become habits.</div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="target" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title">Technical Execution Quality</div>
            <div class="k-track-desc">Identifies whether losses come from strategy errors or discipline failures — a critical distinction.</div>
          </div>
        </div>

        <div class="k-track-item">
          <div class="k-track-icon"><i data-feather="trending-up" width="16" height="16"></i></div>
          <div>
            <div class="k-track-title">KAIZEN Score Progression</div>
            <div class="k-track-desc">Five dimensions, updated every session. A rising score means rising consistency — not luck.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHO KAIZEN IS FOR
  ============================================================ -->
  <section class="k-section k-section--border">
    <div class="k-eyebrow k-eyebrow--center" data-reveal>Who KAIZEN Is For</div>
    <h2 class="k-title k-title--center" data-reveal>Built for traders who want to get better</h2>
    <p class="k-sub" data-reveal>
      Forex, crypto, stocks, indices — wherever you trade, KAIZEN works the
      same way: it makes your behavior visible so you can change it.
    </p>

    <div class="k-audience-grid">

      <div class="k-audience-card k-card k-card--hover" data-reveal>
        <div class="k-audience-icon"><i data-feather="book-open" width="18" height="18"></i></div>
        <div class="k-audience-tier">New Trader</div>
        <h3 class="k-audience-level">Starting out</h3>
        <p class="k-audience-desc">
          Build the right habits before the bad ones form. Journal from
          day one and you'll never have to unlearn recklessness.
        </p>
      </div>

      <div class="k-audience-card k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-audience-icon"><i data-feather="compass" width="18" height="18"></i></div>
        <div class="k-audience-tier">Developing Trader</div>
        <h3 class="k-audience-level">Finding your style</h3>
        <p class="k-audience-desc">
          You know the basics. Now find out what you actually do versus
          what you think you do — and close the gap.
        </p>
      </div>

      <div class="k-audience-card k-card k-card--featured" data-reveal style="transition-delay:120ms;">
        <div class="k-audience-icon"><i data-feather="trending-up" width="18" height="18"></i></div>
        <div class="k-audience-tier">Consistent Trader</div>
        <h3 class="k-audience-level">2–5 years experience</h3>
        <p class="k-audience-desc">
          You have a strategy. The problem is executing it consistently.
          KAIZEN shows you exactly where and why your discipline breaks.
        </p>
      </div>

      <div class="k-audience-card k-card k-card--hover" data-reveal style="transition-delay:180ms;">
        <div class="k-audience-icon"><i data-feather="award" width="18" height="18"></i></div>
        <div class="k-audience-tier">Prop Firm Trader</div>
        <h3 class="k-audience-level">In a challenge or funded</h3>
        <p class="k-audience-desc">
          A challenge doesn't test your strategy — it tests rule-following
          under pressure. KAIZEN measures that behavior session by session
          and builds the record behind it. Funding comes from your firm,
          never from us.
        </p>
      </div>

    </div>

    <!-- Final CTA -->
    <div class="k-final-cta" style="margin-top:72px;" data-reveal>
      <div class="k-eyebrow k-eyebrow--center">Start Your Journey</div>
      <h2 class="k-cta-h">
        Your discipline is<br>
        <span class="k-gold">your edge.</span>
      </h2>
      <p class="k-cta-sub">
        No signals. No shortcuts. Just honest feedback that makes you
        a better trader.
      </p>
      <div class="k-cta-btns">
        <a href="/auth/register" class="btn-primary k-btn-lg">Create Account</a>
        <a href="/about" class="btn-outline k-btn-lg">Learn More</a>
      </div>
    </div>

  </section>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script src="/js/v2-reveal.js"></script>
  <script>if (window.feather) feather.replace();</script>
  <script>
    // Hero typing reveal — the promise types itself out on load.
    // prefers-reduced-motion: hero renders instantly (untouched).
    (function () {
      var h = document.querySelector('.k-hero-h1');
      if (!h) return;
      var reduced = window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      var lines = [
        { text: 'Most traders know', gold: false },
        { text: 'their rules.', gold: false },
        { text: 'Few follow them.', gold: true }
      ];
      var spans = [];
      h.innerHTML = '';
      function ensureLine(i) {
        if (spans[i]) return spans[i];
        if (i > 0) h.appendChild(document.createElement('br'));
        var sp = document.createElement('span');
        if (lines[i].gold) sp.className = 'k-gold';
        h.appendChild(sp);
        spans[i] = sp;
        return sp;
      }
      var li = 0, ci = 0;
      function tick() {
        if (li >= lines.length) return;
        var sp = ensureLine(li);
        ci += 1;
        sp.textContent = lines[li].text.slice(0, ci);
        if (ci >= lines[li].text.length) { li += 1; ci = 0; setTimeout(tick, 420); return; }
        setTimeout(tick, 38);
      }
      h.style.minHeight = '3.6em'; // reserve space while typing (no layout jump)
      setTimeout(tick, 450);
    })();
  </script>
</body>
</html>

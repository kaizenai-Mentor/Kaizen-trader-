<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Kaizen — Trade Better. Every Day.</title>
</head>
<body class="welcome-page">

  <%- include('partials/navbar') %>

  <main class="welcome-main">
    <div class="welcome-content">

      <div class="welcome-badge">
        <span class="badge-dot"></span>
        AI-Powered Trading Discipline
      </div>

      <h1 class="welcome-title">
        Trade with<br><em>Discipline.</em>
      </h1>

      <p class="welcome-sub">
        Kaizen watches how you trade, learns your style,
        and holds you accountable to the rules
        <strong>you yourself created.</strong>
      </p>

      <div class="welcome-ctas">
        <a href="/auth/register" class="btn-primary">Start Your Journey</a>
        <a href="/auth/login" class="btn-outline">Sign In</a>
      </div>

      <div class="welcome-stats">
        <div class="stat">
          <div class="stat-val">改</div>
          <div class="stat-label">Philosophy</div>
        </div>
        <div class="stat">
          <div class="stat-val">100</div>
          <div class="stat-label">Max Score</div>
        </div>
        <div class="stat">
          <div class="stat-val">ZA</div>
          <div class="stat-label">Reputation</div>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>
 <script src="/js/app.js"></script>
</body>
</html>

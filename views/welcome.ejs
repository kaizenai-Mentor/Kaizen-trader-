<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Trade Better. Every Day.</title>
</head>
<body class="welcome-page">

  <%- include('partials/navbar') %>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="alert alert-success" style="text-align:center;margin:0;">
      Your account has been deleted. We hope to see you back.
    </div>
  <% } %>

  <main class="welcome-main">
    <div class="welcome-content">

      <div class="welcome-badge">
        <span class="badge-dot"></span>
        Discipline-First Trading Platform
      </div>

      <h1 class="welcome-title">
        Most traders know<br>their rules.<br>
        <span class="gold-text">Few follow them.</span>
      </h1>

      <p class="welcome-sub">
        Kaizen is not a signal app. It is a <strong>behavioral accountability system</strong>
        built to help you execute your own strategy — consistently,
        session after session, until discipline becomes instinct.
      </p>

      <div class="welcome-ctas">
        <a href="/auth/register" class="btn-primary">Start Your Journey</a>
        <a href="/auth/login" class="btn-outline">Sign In</a>
      </div>

      <div class="welcome-stats">
        <div>
          <div class="stat-val">改</div>
          <div class="stat-label">Philosophy</div>
        </div>
        <div>
          <div class="stat-val">100</div>
          <div class="stat-label">Max Score</div>
        </div>
        <div>
          <div class="stat-val">ZA</div>
          <div class="stat-label">On-Chain</div>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

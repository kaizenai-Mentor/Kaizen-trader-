<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.cockpit') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow">

    <% var h = new Date().getHours(); var greet = h < 12 ? 'Good morning' : (h < 17 ? 'Good afternoon' : 'Good evening'); %>

    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow"><%= t('dash.eyebrow') %></div>
        <h1 class="k-page-title"><%= greet %>, <%= user.username %>.</h1>
        <p class="k-page-sub"><%= t('dash.question') %></p>
      </div>
      <div class="k-streakchip" title="<%= t('dash.scoreAria') %>">
        <span class="k-streak-flame">◆</span>
        <span class="k-streak-num"><%= streak %></span>
        <span class="k-streak-label"><%= t('dash.dayStreak') %></span>
      </div>
    </div>

    <div class="k-cockpit-grid">

      <!-- ═══ THE SCORE INSTRUMENT ═══ -->
      <section class="k-card k-card--elevated k-instrument">
        <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span> KAIZEN SCORE</div>

        <% if (score.overall !== null && score.overall !== undefined) { %>
          <div class="k-scoreline">
            <span class="k-scorenum"><%= score.overall %></span>
            <div class="k-scoremeta">
              <% if (score.overallState === 'READY') { %><span class="k-statechip is-ready"><%= t('dash.ready') %></span><% } %>
              <% if (score.overallState === 'PARTIAL') { %><span class="k-statechip is-partial"><%= t('dash.partial') %></span><% } %>
              <span class="k-scoresub"><%= t('dash.fromLast') %><%= score.sessionsConsidered %><%= t('dash.sessionsDot') %><a class="k-link" href="/about#kaizen-score"><%= t('dash.howScored') %></a></span>
            </div>
          </div>

          <div class="k-meters">
            <% ['process','risk','execution','behavior','learning'].forEach(function(k){ %>
              <% var d = score.dimensions && score.dimensions[k]; if (d && d.score !== null && d.score !== undefined) { %>
                <div class="k-meter" data-meter="<%= d.score %>">
                  <span class="k-meter-label"><%= dimensionLabels[k] %></span>
                  <span class="k-meter-track"><span class="k-meter-fill"></span></span>
                  <span class="k-meter-value"><%= d.score %></span>
                </div>
              <% } %>
            <% }); %>
          </div>

          <% var whyDims = ['behavior','risk','process','learning','execution'].filter(function(k){ return score.dimensions && score.dimensions[k] && score.dimensions[k].reasons && score.dimensions[k].reasons.length; }); %>
          <% if (whyDims.length) { %>
            <div class="k-whyblock">
              <div class="k-metric-label"><%= t('dash.whyNumber') %></div>
              <% whyDims.slice(0,3).forEach(function(k){ %>
                <p class="k-whyline">
                  <span class="k-whydim"><%= dimensionLabels[k].toUpperCase() %></span> — <%= score.dimensions[k].reasons[0] %>
                </p>
              <% }); %>
            </div>
          <% } %>
        <% } else { %>
          <div class="k-building">
            <span class="k-buildnum">改</span>
            <div>
              <div class="k-buildtitle"><%= t('dash.buildingBase') %></div>
              <p class="k-buildtext"><%= t('dash.noScore') %></p>
            </div>
          </div>
        <% } %>
      </section>

      <!-- ═══ TODAY ═══ -->
      <section class="k-card k-todaycard">
        <div class="k-panel-title"><%= t('dash.today') %></div>
        <% if (!todayActions.length) { %>
          <p class="k-todaydone"><%= t('dash.todayDone') %></p>
        <% } else { %>
          <% todayActions.forEach(function(a){ %>
            <div class="k-todayitem">
              <div class="k-todaytext">
                <div class="k-todaytitle"><%= a.title %></div>
                <p class="k-todaybody"><%= a.body %></p>
              </div>
              <a class="k-btn k-btn-primary k-btn-sm" href="<%= a.href %>"><%= a.cta %></a>
            </div>
          <% }); %>
        <% } %>
      </section>

      <!-- ═══ RECENT PATTERN ═══ -->
      <% if (predictiveWarning) { %>
        <section class="k-card k-patterncard is-<%= predictiveWarning.level %>">
          <div class="k-panel-title"><%= t('dash.recentPattern') %></div>
          <p class="k-patternmsg"><%= predictiveWarning.message %></p>
          <% if (predictiveWarning.level !== 'positive') { %>
            <div class="k-patternfoot"><%= t('dash.patternNote') %></div>
          <% } %>
        </section>
      <% } %>

      <!-- ═══ NEXT MILESTONE ═══ -->
      <section class="k-card k-milestonecard">
        <div class="k-panel-title"><%= t('dash.nextMilestone') %></div>
        <div class="k-milestone-label"><%= nextMilestone.label %></div>
        <div class="k-milestone-track"><span class="k-milestone-fill" data-meter="<%= nextMilestone.progress %>"></span></div>
        <div class="k-milestone-meta">
          <% if (nextMilestone.remaining > 0) { %><%= nextMilestone.remaining %><%= t('dash.toGo') %><% } else { %><%= t('dash.reached') %><% } %>
          · <a class="k-link" href="/leaderboard"><%= t('dash.myProgress') %></a>
        </div>
      </section>

      <!-- ═══ ESSENTIALS: RECENT SESSIONS ═══ -->
      <section class="k-card k-essentialcard">
        <div class="k-panel-title" style="display:flex;align-items:center;justify-content:space-between;">
          <span><%= t('dash.recentSessions') %></span>
          <a class="k-link" href="/dashboard/sessions"><%= t('dash.allSessions') %></a>
        </div>
        <% if (!sessions.length) { %>
          <p class="k-emptyhint"><%= t('dash.nothingYet') %></p>
        <% } else { %>
          <div class="k-minirows">
            <% sessions.forEach(function(s){ %>
              <% var href = s.state === 'PLANNED' ? '/dashboard/sessions/' + s._id + '/record' : (s.state === 'RECORDED' ? '/dashboard/sessions/' + s._id + '/reflect' : '/dashboard/sessions/' + s._id); %>
              <a class="k-minirow" href="<%= href %>">
                <span class="k-type-tag k-type-<%= (s.sessionType || 'LIVE').toLowerCase() %>"><%= s.sessionType || 'LIVE' %></span>
                <span class="k-minirow-asset"><%= s.asset %></span>
                <span class="k-minirow-state"><%= s.state %></span>
                <span class="k-minirow-date"><%= new Date(s.createdAt).toLocaleDateString(({en:'en-US',fr:'fr-FR',zh:'zh-CN',ja:'ja-JP',af:'af-ZA'})[lang]||'en-US',{month:'short',day:'numeric'}) %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
        <div class="k-essentialfoot">
          <span><%= totalSessions %><%= t('word.session') %><%= totalSessions === 1 ? '' : 's' %><%= t('word.total') %></span>
          <span>·</span>
          <span><%= badgeCount %><%= t('word.milestone') %><%= badgeCount === 1 ? '' : 's' %></span>
          <span>·</span>
          <a class="k-link" href="/settings/trading-system"><%= t('dash.systemV') %><%= systemVersion %></a>
        </div>
      </section>

    </div>
  </main>

  <% if (newBadges && newBadges.length) { %>
    <div class="k-toast" id="badgeToast">
      <% newBadges.forEach(function(b){ %>
        <div class="k-toast-item"><span class="k-kanji k-kanji--sm">改</span><%= t('dash.milestoneReached') %><b><%= b.name %></b></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ═══ NEW-USER INTRO (D1 — shown once, V2-era accounts) ═══ -->
  <% if (showIntro) { %>
    <div class="k-modalwrap" id="scoreIntroModal">
      <div class="k-modal">
        <span class="k-kanji k-kanji--lg">改</span>
        <h2 class="k-modaltitle"><%= t('dash.howWorks') %></h2>
        <p class="k-modaltext"><%= t('dash.exA') %><b><%= t('dash.exLoop') %></b><%= t('dash.exB') %><b><%= t('dash.exDims') %></b><%= t('dash.exC') %></p>
        <p class="k-modaltext"><%= t('dash.exD') %><b><%= t('dash.exWhy') %></b><%= t('dash.exE') %></p>
        <p class="k-modaltext"><%= t('dash.exF') %><b><%= t('dash.exBuilding') %></b><%= t('dash.exG') %></p>
        <div class="k-modalactions">
          <a class="k-btn k-btn-primary" href="/dashboard/sessions/new"><%= t('dash.planSession') %></a>
          <button class="k-btn k-btn-ghost" type="button" onclick="document.getElementById('scoreIntroModal').remove()"><%= t('dash.gotIt') %></button>
        </div>
      </div>
    </div>
  <% } %>

  <!-- ═══ CUTOVER EXPLAINER (shown once) ═══ -->
  <% if (showCutover) { %>
    <div class="k-modalwrap" id="cutoverModal">
      <div class="k-modal">
        <span class="k-kanji k-kanji--lg">改</span>
        <h2 class="k-modaltitle"><%= t('dash.renameTitle') %></h2>
        <p class="k-modaltext"><%= t('dash.renameA') %><b><%= t('dash.exDims') %></b><%= t('dash.renameB') %></p>
        <p class="k-modaltext"><%= t('dash.renameC') %><b>Building</b><%= t('dash.renameD') %></p>
        <p class="k-modaltext"><%= t('dash.loopNow') %><b><%= t('dash.loopChain') %></b><%= t('dash.loopNote') %></p>
        <div class="k-modalactions">
          <a class="k-btn k-btn-primary" href="/dashboard/sessions/new"><%= t('dash.planSession') %></a>
          <button class="k-btn k-btn-ghost" type="button" onclick="document.getElementById('cutoverModal').remove()"><%= t('dash.gotIt') %></button>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('partials/footer') %>
  <script src="/js/v2-reveal.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>

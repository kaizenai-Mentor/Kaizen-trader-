<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Cockpit</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow">

    <% var h = new Date().getHours(); var greet = h < 12 ? 'Good morning' : (h < 17 ? 'Good afternoon' : 'Good evening'); %>

    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow">COCKPIT · 改</div>
        <h1 class="k-page-title"><%= greet %>, <%= user.username %>.</h1>
        <p class="k-page-sub">One honest question: how are you improving?</p>
      </div>
      <div class="k-streakchip" title="Practice consistency — never presented as trading performance">
        <span class="k-streak-flame">◆</span>
        <span class="k-streak-num"><%= streak %></span>
        <span class="k-streak-label">day streak</span>
      </div>
    </div>

    <div class="k-cockpit-grid">

      <!-- ═══ THE SCORE INSTRUMENT ═══ -->
      <section class="k-card k-card--elevated k-instrument">
        <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span> KAIZEN SCORE</div>

        <% if (score.overall !== null && score.overall !== undefined) { %>
          <div class="k-scoreline">
            <span class="k-scorenum"><%= score.overall %></span>
            <div class="k-scoremeta">
              <% if (score.overallState === 'READY') { %><span class="k-statechip is-ready">READY</span><% } %>
              <% if (score.overallState === 'PARTIAL') { %><span class="k-statechip is-partial">PARTIAL — FROM YOUR WRITTEN HISTORY</span><% } %>
              <span class="k-scoresub">From your last <%= score.sessionsConsidered %> sessions · <a class="k-link" href="/about#kaizen-score">How is this scored?</a></span>
            </div>
          </div>

          <div class="k-meters">
            <% ['process','risk','execution','behavior','learning'].forEach(function(k){ %>
              <% var d = score.dimensions && score.dimensions[k]; if (d && d.score !== null && d.score !== undefined) { %>
                <div class="k-meter" data-meter="<%= d.score %>">
                  <span class="k-meter-label"><%= dimensionLabels[k] %></span>
                  <span class="k-meter-track"><span class="k-meter-fill"></span></span>
                  <span class="k-meter-value"><%= d.score %></span>
                </div>
              <% } %>
            <% }); %>
          </div>

          <% var whyDims = ['behavior','risk','process','learning','execution'].filter(function(k){ return score.dimensions && score.dimensions[k] && score.dimensions[k].reasons && score.dimensions[k].reasons.length; }); %>
          <% if (whyDims.length) { %>
            <div class="k-whyblock">
              <div class="k-metric-label">WHY THIS NUMBER</div>
              <% whyDims.slice(0,3).forEach(function(k){ %>
                <p class="k-whyline">
                  <span class="k-whydim"><%= dimensionLabels[k].toUpperCase() %></span> — <%= score.dimensions[k].reasons[0] %>
                </p>
              <% }); %>
            </div>
          <% } %>
        <% } else { %>
          <div class="k-building">
            <span class="k-buildnum">改</span>
            <div>
              <div class="k-buildtitle">Building your baseline</div>
              <p class="k-buildtext">No score yet — and that's honest, not broken. The engine needs a few sessions through plan → record → reflect before it will say anything about you. No instant judgment, no vanity number.</p>
            </div>
          </div>
        <% } %>
      </section>

      <!-- ═══ TODAY ═══ -->
      <section class="k-card k-todaycard">
        <div class="k-panel-title">TODAY</div>
        <% if (!todayActions.length) { %>
          <p class="k-todaydone">Today is complete. Rest is also discipline — come back tomorrow.</p>
        <% } else { %>
          <% todayActions.forEach(function(a){ %>
            <div class="k-todayitem">
              <div class="k-todaytext">
                <div class="k-todaytitle"><%= a.title %></div>
                <p class="k-todaybody"><%= a.body %></p>
              </div>
              <a class="k-btn k-btn-primary k-btn-sm" href="<%= a.href %>"><%= a.cta %></a>
            </div>
          <% }); %>
        <% } %>
      </section>

      <!-- ═══ RECENT PATTERN ═══ -->
      <% if (predictiveWarning) { %>
        <section class="k-card k-patterncard is-<%= predictiveWarning.level %>">
          <div class="k-panel-title">RECENT PATTERN</div>
          <p class="k-patternmsg"><%= predictiveWarning.message %></p>
          <% if (predictiveWarning.level !== 'positive') { %>
            <div class="k-patternfoot">A pattern is a signal, not a verdict — the next session is what counts.</div>
          <% } %>
        </section>
      <% } %>

      <!-- ═══ NEXT MILESTONE ═══ -->
      <section class="k-card k-milestonecard">
        <div class="k-panel-title">NEXT MILESTONE</div>
        <div class="k-milestone-label"><%= nextMilestone.label %></div>
        <div class="k-milestone-track"><span class="k-milestone-fill" data-meter="<%= nextMilestone.progress %>"></span></div>
        <div class="k-milestone-meta">
          <% if (nextMilestone.remaining > 0) { %><%= nextMilestone.remaining %> to go<% } else { %>Reached<% } %>
          · <a class="k-link" href="/leaderboard">My Progress</a>
        </div>
      </section>

      <!-- ═══ ESSENTIALS: RECENT SESSIONS ═══ -->
      <section class="k-card k-essentialcard">
        <div class="k-panel-title" style="display:flex;align-items:center;justify-content:space-between;">
          <span>RECENT SESSIONS</span>
          <a class="k-link" href="/dashboard/sessions">All sessions →</a>
        </div>
        <% if (!sessions.length) { %>
          <p class="k-emptyhint">Nothing yet. Your first plan is one tap away — top of this page.</p>
        <% } else { %>
          <div class="k-minirows">
            <% sessions.forEach(function(s){ %>
              <% var href = s.state === 'PLANNED' ? '/dashboard/sessions/' + s._id + '/record' : (s.state === 'RECORDED' ? '/dashboard/sessions/' + s._id + '/reflect' : '/dashboard/sessions/' + s._id); %>
              <a class="k-minirow" href="<%= href %>">
                <span class="k-type-tag k-type-<%= (s.sessionType || 'LIVE').toLowerCase() %>"><%= s.sessionType || 'LIVE' %></span>
                <span class="k-minirow-asset"><%= s.asset %></span>
                <span class="k-minirow-state"><%= s.state %></span>
                <span class="k-minirow-date"><%= new Date(s.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
        <div class="k-essentialfoot">
          <span><%= totalSessions %> session<%= totalSessions === 1 ? '' : 's' %> total</span>
          <span>·</span>
          <span><%= badgeCount %> milestone<%= badgeCount === 1 ? '' : 's' %></span>
          <span>·</span>
          <a class="k-link" href="/settings/trading-system">System v<%= systemVersion %></a>
        </div>
      </section>

    </div>
  </main>

  <% if (newBadges && newBadges.length) { %>
    <div class="k-toast" id="badgeToast">
      <% newBadges.forEach(function(b){ %>
        <div class="k-toast-item"><span class="k-kanji k-kanji--sm">改</span> Milestone reached: <b><%= b.name %></b></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ═══ CUTOVER EXPLAINER (shown once) ═══ -->
  <% if (showCutover) { %>
    <div class="k-modalwrap" id="cutoverModal">
      <div class="k-modal">
        <span class="k-kanji k-kanji--lg">改</span>
        <h2 class="k-modaltitle">Your Discipline Score is now your KAIZEN Score</h2>
        <p class="k-modaltext">Same discipline, sharper instrument. From today your score is computed by a fixed formula across five dimensions — <b>Process, Risk, Execution, Behavior, Learning &amp; Consistency</b> — and every score shows its WHY.</p>
        <p class="k-modaltext">Nothing from your history was lost. Your past sessions were read and carried over; if a dimension needs more evidence it says <b>Building</b> instead of guessing. That's not a lower score — it's an honest one.</p>
        <p class="k-modaltext">Sessions are now a loop: <b>Plan → Record → Reflect → Analyzed</b>. The plan you write before the session is what your execution is measured against.</p>
        <div class="k-modalactions">
          <a class="k-btn k-btn-primary" href="/dashboard/sessions/new">Plan a session</a>
          <button class="k-btn k-btn-ghost" type="button" onclick="document.getElementById('cutoverModal').remove()">Got it</button>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('partials/footer') %>
  <script src="/js/v2-reveal.js"></script>
</body>
</html>

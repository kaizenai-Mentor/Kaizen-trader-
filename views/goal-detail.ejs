<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= goal.title %> · <%= t('title.goals') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="margin-bottom:24px;">
      <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
        <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span><%= t('goals.eyebrow') %></div>
      <h1 style="font-size:1.5rem;font-weight:700;color:var(--text-primary);margin-bottom:6px;"><%= goal.title %></h1>
      <p style="font-family:'DM Mono',monospace;font-size:0.68rem;color:var(--ash);">
        <%= goal.metric %> <% if (goal.target != null) { %>· <%= t('goals.target') %> <%= goal.target %><%= goal.unit || '' %><% } %>
        · <%= goal.cadence %> · <%= goal.status %>
        <% if (current != null) { %>· <%= t('goals.now') %> <%= current %><%= goal.unit || '' %><% } %>
      </p>
    </div>

    <div class="k-card" style="margin-bottom:16px;">
      <div class="k-panel-title" style="margin-bottom:10px;"><%= t('goals.guidance') %></div>
      <p style="font-size:0.9rem;line-height:1.65;color:var(--text-primary);margin-bottom:12px;"><%= guidance.assessment %></p>
      <div style="font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold);margin-bottom:4px;"><%= t('goals.next') %></div>
      <p style="font-size:0.88rem;line-height:1.65;color:var(--text-primary);"><%= guidance.nextStep %></p>
    </div>

    <div class="k-card" style="margin-bottom:16px;">
      <div class="k-panel-title" style="margin-bottom:4px;"><%= t('goals.feedback') %></div>
      <p style="font-size:0.78rem;color:var(--ash);font-style:italic;line-height:1.7;margin-bottom:12px;"><%= t('goals.feedbackSub') %></p>
      <form method="POST" action="/goals/<%= goal._id %>/feedback">
        <label style="display:block;font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-bottom:6px;"><%= t('goals.feedbackLabel') %></label>
        <textarea name="note" class="k-input" rows="4" maxlength="800" required placeholder="<%= t('goals.feedbackPh') %>" style="margin-bottom:10px;line-height:1.7;resize:vertical;"></textarea>
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
          <div>
            <label style="display:block;font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-bottom:6px;"><%= t('goals.value') %></label>
            <input class="k-input" name="value" type="number" step="any" style="width:120px;">
          </div>
          <button type="submit" class="k-btn" style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;"><%= t('goals.saveFeedback') %></button>
        </div>
      </form>

      <% if (goal.progressLog && goal.progressLog.length) { %>
        <div style="margin-top:16px;">
          <div class="k-metric-label" style="margin-bottom:8px;"><%= t('goals.feedbackFeed') %></div>
          <div style="border-left:2px solid var(--gold);padding-left:14px;">
            <% goal.progressLog.slice().reverse().forEach(function (e) { %>
              <div style="padding:8px 0;border-bottom:1px solid var(--border);">
                <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline;">
                  <span style="color:var(--ash);font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.08em;"><%= e.at ? new Date(e.at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '' %></span>
                  <% if (e.value != null) { %><span class="k-chip" style="padding:2px 8px;font-size:0.56rem;"><%= e.value %><%= goal.unit || '' %></span><% } %>
                </div>
                <p style="font-size:0.85rem;line-height:1.7;color:var(--text-primary);margin-top:4px;white-space:pre-wrap;"><%= e.note || '—' %></p>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="k-card" style="margin-bottom:16px;">
      <div class="k-panel-title" style="margin-bottom:12px;"><%= t('goals.statusCard') %></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <% statuses.forEach(function (s) { %>
          <form method="POST" action="/goals/<%= goal._id %>/status">
            <input type="hidden" name="status" value="<%= s %>">
            <button type="submit" class="k-btn k-btn--ghost" style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;<%= goal.status === s ? 'border-color:var(--gold);color:var(--gold);' : '' %>"><%= s %></button>
          </form>
        <% }); %>
      </div>
    </div>

    <a href="/goals" class="k-btn k-btn--ghost" style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;"><%= t('goals.backToList') %></a>

  </main>
  <script src="/js/app.js"></script>
</body>
</html>

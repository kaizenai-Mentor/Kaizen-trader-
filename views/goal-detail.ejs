<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= goal.title %> · <%= t('title.goals') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="margin-bottom:24px;">
      <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
        <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span><%= t('goals.eyebrow') %></div>
      <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);margin-bottom:4px;"><%= t('goals.yourGoal') %></div>
      <h1 style="font-size:1.55rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;"><%= goal.title %></h1>
      <div style="display:flex;gap:14px;flex-wrap:wrap;font-family:'DM Mono',monospace;font-size:0.66rem;color:var(--ash);">
        <% if (guidance && guidance.currentPattern) { %><span><%= t('goals.currentPattern') %>: <%= guidance.currentPattern %></span> · <% } %>
        <span><%= goal.status %></span>
      </div>
      <% if (goal.rationale) { %>
        <p style="font-size:0.84rem;color:var(--text-secondary);font-style:italic;margin:8px 0 0;"><%= t('goals.reason') %>: "<%= goal.rationale %>"</p>
      <% } %>
    </div>

    <!-- Pre-session Coaching Meeting: What you're doing well · Your biggest obstacle · Today's focus -->
    <div class="k-card k-card--featured" style="margin-bottom:16px;padding:24px;">
      <% if (guidance && guidance.sessionVerdict) { %>
        <div style="padding:14px 16px;border-radius:10px;background:rgba(245,197,24,0.07);border:1px solid rgba(245,197,24,0.28);margin-bottom:18px;">
          <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;">改 KAIZEN VERDICT · RECALLED FROM YOUR SESSIONS & JOURNAL</div>
          <p style="font-size:0.92rem;line-height:1.76;color:var(--text-primary);margin:0;"><%= guidance.sessionVerdict %></p>
        </div>
      <% } %>
      <div style="padding-bottom:18px;border-bottom:1px solid var(--border);margin-bottom:18px;">
        <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--green, #4ec9b0);margin-bottom:8px;"><%= t('goals.whatDoingWell') %></div>
        <p style="font-size:0.94rem;line-height:1.78;color:var(--text-primary);margin:0;white-space:pre-line;"><%= (guidance && guidance.doingWell) || guidance.assessment %></p>
      </div>

      <div style="padding-bottom:18px;border-bottom:1px solid var(--border);margin-bottom:18px;">
        <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--red, #e06c75);margin-bottom:8px;"><%= t('goals.biggestObstacle') %></div>
        <p style="font-size:0.94rem;line-height:1.78;color:var(--text-primary);margin:0;white-space:pre-line;"><%= (guidance && guidance.obstacle) || '' %></p>
      </div>

      <div style="border-left:2px solid var(--gold);padding-left:14px;">
        <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;"><%= t('goals.todaysFocus') %></div>
        <p style="font-size:0.95rem;font-weight:500;line-height:1.8;color:var(--text-primary);margin:0;white-space:pre-line;"><%= (guidance && guidance.todaysFocus) || guidance.nextStep %></p>
      </div>
    </div>

    <div class="k-card" style="margin-bottom:16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
        <div class="k-panel-title" style="margin-bottom:0;"><%= t('goals.feedback') %></div>
        <span class="k-chip" style="padding:3px 9px;font-size:0.52rem;border-color:var(--gold);color:var(--gold);">⚡ HYBRID AUTO-SYNC FROM SESSIONS + MANUAL CHECK-IN</span>
      </div>
      <p style="font-size:0.8rem;color:var(--text-secondary);line-height:1.68;margin-bottom:6px;">
        <strong>Session sync:</strong> New sessions can add feedback to relevant active goals. Risk and rule goals use relevant quick checks or journal mentions; session-count and journal-streak goals use the recorded session. Reflection updates the same entry. Custom goals and sessions without relevant evidence still need a manual check-in.
      </p>
      <p style="font-size:0.78rem;color:var(--ash);font-style:italic;line-height:1.68;margin-bottom:12px;">
        <%= t('goals.feedbackSub') %> (Use this manual check-in box on no-trade / rest days or whenever you want to add an extra note.)
      </p>
      <form method="POST" action="/goals/<%= goal._id %>/feedback">
        <label style="display:block;font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-bottom:6px;"><%= t('goals.feedbackLabel') %> (OPTIONAL ON SESSION DAYS · RECOMMENDED ON NO-TRADE DAYS)</label>
        <textarea name="note" class="k-input" rows="4" maxlength="800" required placeholder="<%= t('goals.feedbackPh') %>" style="margin-bottom:10px;line-height:1.7;resize:vertical;"></textarea>
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
          <button type="submit" class="k-btn" style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;"><%= t('goals.saveFeedback') %></button>
        </div>
      </form>

      <% if (goal.progressLog && goal.progressLog.length) { %>
        <div style="margin-top:18px;">
          <div class="k-metric-label" style="margin-bottom:10px;"><%= t('goals.feedbackFeed') %> (<%= goal.progressLog.length %>)</div>
          <div style="border-left:2px solid var(--gold);padding-left:14px;">
            <% goal.progressLog.slice().reverse().forEach(function (e) { %>
              <% var isSessionSync = (e && (e.source === 'SESSION' || e.sessionId)); %>
              <div style="padding:10px 0;border-bottom:1px solid var(--border);">
                <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;">
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span style="color:var(--ash);font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.08em;"><%= e.at ? new Date(e.at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '' %></span>
                    <% if (isSessionSync) { %>
                      <span class="k-chip" style="padding:2px 8px;font-size:0.52rem;border-color:var(--gold);color:var(--gold);">⚡ AUTO-SYNCED FROM SESSION<%= e.asset ? ' · ' + e.asset : '' %><%= e.setup ? ' (' + e.setup + ')' : '' %></span>
                      <% if (e.sessionId) { %>
                        <a href="/dashboard/sessions/<%= e.sessionId %>" style="font-family:'DM Mono',monospace;font-size:0.55rem;color:var(--gold);text-decoration:underline;">Open Session →</a>
                      <% } %>
                    <% } else { %>
                      <span class="k-chip" style="padding:2px 8px;font-size:0.52rem;">✍ MANUAL CHECK-IN</span>
                    <% } %>
                  </div>
                  <% if (e.value != null) { %><span class="k-chip" style="padding:2px 8px;font-size:0.56rem;"><%= e.value %><%= goal.unit || '' %></span><% } %>
                </div>
                <p style="font-size:0.85rem;line-height:1.7;color:var(--text-primary);margin-top:6px;white-space:pre-wrap;"><%= e.note || '—' %></p>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="k-card" style="margin-bottom:16px;">
      <div class="k-panel-title" style="margin-bottom:12px;"><%= t('goals.statusCard') %></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <% statuses.forEach(function (s) { %>
          <form method="POST" action="/goals/<%= goal._id %>/status">
            <input type="hidden" name="status" value="<%= s %>">
            <button type="submit" class="k-btn k-btn--ghost" style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;<%= goal.status === s ? 'border-color:var(--gold);color:var(--gold);' : '' %>"><%= s %></button>
          </form>
        <% }); %>
      </div>
    </div>

    <a href="/goals" class="k-btn k-btn--ghost" style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;"><%= t('goals.backToList') %></a>

  </main>
  <script src="/js/app.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Psychology</title>
</head>
<body class="app-page k-chatbody">
  <%- include('partials/navbar') %>

  <% if (mode === 'index') { %>

  <!-- ═══ CONVERSATIONS: list + mind state + start ═══ -->
  <main class="k-flow k-flow--wide">
    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow">COACH · 改</div>
        <h1 class="k-page-title">Psychology</h1>
        <p class="k-page-sub">The room with no scoreboard. Most of the time it is not the rules — it is the state. Work on the state here.</p>
      </div>
    </div>

    <% if (mindState && (mindState.summary || (mindState.themes && mindState.themes.length))) { %>
    <section class="k-card k-mindcard">
      <div class="k-panel-title">WHAT <span class="k-kanji k-kanji--sm">改</span> UNDERSTANDS ABOUT ME</div>
      <% if (mindState.summary) { %>
        <p class="k-mindsummary"><%= mindState.summary %></p>
      <% } %>
      <% if (mindState.themes && mindState.themes.length) { %>
        <div class="k-mindthemes">
          <% mindState.themes.forEach(function(t){ %>
            <div class="k-mindtheme">
              <span class="k-themechip is-<%= t.status %>"><%= t.status %></span>
              <span class="k-themename"><%= t.name %></span>
              <span class="k-thememeta"><%= t.occurrences %>× · since <%= new Date(t.firstSeen).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span>
            </div>
          <% }); %>
        </div>
      <% } %>
      <div class="k-fieldhint">KAIZEN updates this as you talk — nothing here is deletable. Memory is how a pattern gets recognized when it returns.</div>
    </section>
    <% } %>

    <section class="k-card">
      <div class="k-panel-title" style="margin-bottom:14px;">START A CONVERSATION</div>
      <% if (openers && openers.length) { %>
        <div class="k-openerrow">
          <% openers.forEach(function(o){ %>
            <button type="button" class="k-opener" data-opener="<%= o %>"><%= o %></button>
          <% }); %>
        </div>
      <% } %>
      <div class="k-composer">
        <textarea id="psych-input" rows="2" placeholder="Tell KAIZEN what is going on…"></textarea>
        <button type="button" id="psych-send" class="k-btn k-btn-primary">Send</button>
      </div>
    </section>

    <section class="k-card">
      <div class="k-panel-title" style="margin-bottom:6px;">CONVERSATIONS</div>
      <% if (threads && threads.length) { %>
        <div class="k-threadlist">
          <% threads.forEach(function(t){ %>
            <a class="k-threadrow" href="/psychology/t/<%= t._id %>">
              <div class="k-threadmain">
                <span class="k-threadtitle"><%= t.title %></span>
                <span class="k-threadmeta">
                  <%= t.messageCount %> message<%= t.messageCount === 1 ? '' : 's' %>
                  · <%= new Date(t.lastMessageAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
                  <% if (t.imported) { %> · imported<% } %>
                </span>
              </div>
              <span class="k-threadarrow">→</span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="k-emptyhint">No conversations yet. Start one above — it stays between you and KAIZEN.</p>
      <% } %>
    </section>
  </main>

  <% } else { %>

  <!-- ═══ ONE CONVERSATION ═══ -->
  <main class="k-flow k-flow--wide k-chatmain">
    <div class="k-chathead">
      <a class="k-backlink" href="/psychology">← Psychology</a>
      <span class="k-chattitle"><%= thread.title %></span>
    </div>

    <div class="k-chatlog" id="chatlog">
      <% if (thread.messages && thread.messages.length) { %>
        <% thread.messages.forEach(function(m){ %>
          <% if (m.role === 'user') { %>
            <div class="k-msg k-msg-user"><div class="k-msg-bubble"><%= m.text %></div></div>
          <% } else { %>
            <div class="k-msg k-msg-kai">
              <span class="k-kanji k-kanji--sm">改</span>
              <div class="k-msg-text"><%= m.text %></div>
            </div>
          <% } %>
        <% }); %>
      <% } %>
      <div class="k-typing" id="typing" hidden>
        <span class="k-kanji k-kanji--sm">改</span>
        <div class="k-msg-text k-typingdots"><span></span><span></span><span></span></div>
      </div>
    </div>

    <% if (openers && openers.length) { %>
      <div class="k-openerrow k-openerrow--inline">
        <% openers.forEach(function(o){ %>
          <button type="button" class="k-opener" data-opener="<%= o %>"><%= o %></button>
        <% }); %>
      </div>
    <% } %>

    <div class="k-composer k-composer--sticky">
      <textarea id="psych-input" rows="2" placeholder="Reply to KAIZEN…"></textarea>
      <button type="button" id="psych-send" class="k-btn k-btn-primary">Send</button>
    </div>
  </main>

  <% } %>

  <%- include('partials/footer') %>
  <script>
    (function () {
      var input = document.getElementById('psych-input');
      var send = document.getElementById('psych-send');
      var typing = document.getElementById('typing');
      var log = document.getElementById('chatlog');
      var threadId = <%- (mode === 'thread' && thread && thread._id) ? JSON.stringify(String(thread._id)) : 'null' %>;

      function scrollBottom() {
        if (log) log.scrollTop = log.scrollHeight;
      }
      scrollBottom();

      document.querySelectorAll('.k-opener').forEach(function (b) {
        b.addEventListener('click', function () {
          input.value = b.getAttribute('data-opener');
          input.focus();
        });
      });

      function addMsg(role, text) {
        if (!log) return;
        var wrap = document.createElement('div');
        if (role === 'user') {
          wrap.className = 'k-msg k-msg-user';
          var b = document.createElement('div');
          b.className = 'k-msg-bubble';
          b.textContent = text;
          wrap.appendChild(b);
        } else {
          wrap.className = 'k-msg k-msg-kai';
          var k = document.createElement('span');
          k.className = 'k-kanji k-kanji--sm';
          k.textContent = '改';
          var t = document.createElement('div');
          t.className = 'k-msg-text';
          t.textContent = text;
          wrap.appendChild(k);
          wrap.appendChild(t);
        }
        log.appendChild(wrap);
        scrollBottom();
      }

      var busy = false;
      function sendMsg() {
        var text = input.value.trim();
        if (!text || busy) return;
        busy = true;
        send.disabled = true;
        if (threadId) addMsg('user', text);
        input.value = '';
        if (typing) typing.hidden = false;
        scrollBottom();

        fetch('/psychology/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, threadId: threadId })
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.error) { addMsg('kaizen', data.error); return; }
            if (!threadId) {
              window.location = '/psychology/t/' + data.threadId;
              return;
            }
            addMsg('kaizen', data.reply);
          })
          .catch(function () {
            addMsg('kaizen', 'Connection dropped. Your message was sent — refresh in a moment.');
          })
          .finally(function () {
            busy = false;
            send.disabled = false;
            if (typing) typing.hidden = true;
            input.focus();
          });
      }

      send.addEventListener('click', sendMsg);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey && window.innerWidth > 760) {
          e.preventDefault();
          sendMsg();
        }
      });
    })();
  </script>
  <script src="/js/app.js"></script>
</body>
</html>

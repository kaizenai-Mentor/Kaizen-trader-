<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.improve') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="margin-bottom:24px;">
      <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
        <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span><%= t('improve.eyebrow') %></div>
      <h1 style="font-size:1.6rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;"><%= t('improve.h1') %></h1>
      <p style="font-size:0.82rem;color:var(--ash);font-style:italic;"><%= t('improve.sub') %></p>
    </div>

    <div class="k-card" style="margin-bottom:20px;">
      <p style="font-size:0.92rem;line-height:1.65;color:var(--text-primary);"><%= rec.intro %></p>
    </div>

    <% rec.items.forEach(function (item, i) { %>
      <div class="k-card k-card--hover" style="margin-bottom:14px;">
        <div style="display:flex;align-items:flex-start;gap:14px;">
          <div style="flex-shrink:0;width:30px;height:30px;border-radius:8px;background:rgba(245,197,24,0.12);border:1px solid rgba(245,197,24,0.25);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:0.8rem;font-weight:700;color:var(--gold);"><%= i + 1 %></div>
          <div style="flex:1;">
            <h3 style="font-size:1.02rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;"><%= item.title %></h3>
            <div style="font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);margin-bottom:4px;"><%= t('improve.why') %></div>
            <p style="font-size:0.86rem;line-height:1.6;color:var(--text-primary);margin-bottom:12px;"><%= item.why %></p>
            <div style="font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold);margin-bottom:4px;"><%= t('improve.action') %></div>
            <p style="font-size:0.86rem;line-height:1.6;color:var(--text-primary);"><%= item.action %></p>
          </div>
        </div>
      </div>
    <% }); %>

    <div style="margin-top:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
      <p style="font-size:0.72rem;color:var(--ash);font-style:italic;"><%= t('improve.note') %></p>
      <a href="/dashboard" class="k-btn k-btn--ghost" style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;"><%= t('improve.back') %></a>
    </div>

  </main>
  <script src="/js/app.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title>My Trading System · 改 KAIZEN</title>
</head>
<body class="k-app">
  <%- include('partials/navbar', { user }) %>

  <main class="k-page">
    <div class="k-container">

      <div class="k-head">
        <div>
          <div class="k-eyebrow"><%= t('ts.eyebrow') %></div>
          <h1 class="k-title"><%= t('ts.h1') %></h1>
          <p class="k-sub"><%= t('ts.sub') %></p>
        </div>
        <div class="k-versionchip">
          <span class="k-versionnum">v<%= system.version %></span>
          <span class="k-versionmeta"><%= system.history.length %><%= t('ts.version') %><%= system.history.length === 1 ? '' : 's' %><%= t('ts.onRecord') %></span>
        </div>
      </div>

      <% if (saved) { %>
        <div class="k-savenote">
          <span class="k-badge-glyph">改</span><%= t('ts.savedAs') %><%= system.version %><%= t('ts.fromNowOn') %></div>
      <% } %>

      <form method="POST" action="/settings/trading-system" class="k-formgrid">

        <section class="k-formcard">
          <h2 class="k-cardtitle"><%= t('ts.identity') %></h2>
          <div class="k-field">
            <label class="k-fieldlabel" for="name"><%= t('ts.name') %></label>
            <input class="k-input" type="text" id="name" name="name" value="<%= system.name %>" maxlength="60" placeholder="<%= t('ts.namePh') %>">
          </div>
          <div class="k-field">
            <label class="k-fieldlabel" for="marketConditions"><%= t('ts.whereWorks') %></label>
            <textarea class="k-input" id="marketConditions" name="marketConditions" rows="3" placeholder="<%= t('ts.wherePh') %>"><%= system.marketConditions %></textarea>
          </div>
        </section>

        <section class="k-formcard">
          <h2 class="k-cardtitle"><%= t('ts.edge') %></h2>
          <div class="k-field">
            <label class="k-fieldlabel" for="setups"><%= t('ts.setups') %></label>
            <textarea class="k-input" id="setups" name="setups" rows="4" placeholder="<%= t('ts.setupsPh') %>"><% if (system.setups && system.setups.length) { %><%= system.setups.map(s => s.name).join('\n') %><% } %></textarea>
            <div class="k-fieldhint"><%= t('form.setupsHelp') %></div>
          </div>
          <div class="k-field">
            <label class="k-fieldlabel" for="entryRules"><%= t('ts.entry') %></label>
            <textarea class="k-input" id="entryRules" name="entryRules" rows="3" placeholder="<%= t('ts.entryPh') %>"><%= system.entryRules %></textarea>
          </div>
          <div class="k-field">
            <label class="k-fieldlabel" for="exitRules"><%= t('ts.exit') %></label>
            <textarea class="k-input" id="exitRules" name="exitRules" rows="3" placeholder="<%= t('ts.exitPh') %>"><%= system.exitRules %></textarea>
          </div>
        </section>

        <section class="k-formcard">
          <h2 class="k-cardtitle"><%= t('ts.risk') %></h2>
          <p class="k-cardsub"><%= t('ts.hardNums') %></p>
          <div class="k-fieldrow">
            <div class="k-field">
              <label class="k-fieldlabel" for="riskPerTrade"><%= t('form.riskPerTrade') %></label>
              <input class="k-input" type="text" id="riskPerTrade" name="riskPerTrade" value="<%= system.riskRules.riskPerTrade %>" placeholder="e.g. 1% of account">
            </div>
            <div class="k-field">
              <label class="k-fieldlabel" for="maxDailyTrades"><%= t('ts.maxTrades') %></label>
              <input class="k-input" type="text" id="maxDailyTrades" name="maxDailyTrades" value="<%= system.riskRules.maxDailyTrades %>" placeholder="<%= t('ts.numPh') %>">
            </div>
          </div>
          <div class="k-fieldrow">
            <div class="k-field">
              <label class="k-fieldlabel" for="dailyDrawdown"><%= t('ts.drawdown') %></label>
              <input class="k-input" type="text" id="dailyDrawdown" name="dailyDrawdown" value="<%= system.riskRules.dailyDrawdown %>" placeholder="e.g. 3% then stop">
            </div>
            <div class="k-field">
              <label class="k-fieldlabel" for="maxPositionSize"><%= t('ts.maxPos') %></label>
              <input class="k-input" type="text" id="maxPositionSize" name="maxPositionSize" value="<%= system.riskRules.maxPositionSize %>" placeholder="<%= t('ts.sizePh') %>">
            </div>
          </div>
        </section>

        <section class="k-formcard">
          <h2 class="k-cardtitle"><%= t('ts.discipline') %></h2>
          <div class="k-field">
            <label class="k-fieldlabel" for="tradingHours"><%= t('ts.hours') %></label>
            <input class="k-input" type="text" id="tradingHours" name="tradingHours" value="<%= system.tradingHours %>" placeholder="<%= t('ts.hoursPh') %>">
          </div>
          <div class="k-field">
            <label class="k-fieldlabel" for="noTradeConditions"><%= t('ts.noTrade') %></label>
            <textarea class="k-input" id="noTradeConditions" name="noTradeConditions" rows="3" placeholder="<%= t('ts.noTradePh') %>"><%= (system.noTradeConditions || []).join('\n') %></textarea>
          </div>
          <div class="k-field">
            <label class="k-fieldlabel" for="psychologicalRules"><%= t('system.psychRules') %><%= t('ts.perLine') %></label>
            <textarea class="k-input" id="psychologicalRules" name="psychologicalRules" rows="3" placeholder="<%= t('ts.positionPh') %>"><%= (system.psychologicalRules || []).join('\n') %></textarea>
          </div>
        </section>

        <section class="k-formcard">
          <h2 class="k-cardtitle"><%= t('ts.position') %></h2>
          <div class="k-field">
            <label class="k-fieldlabel" for="positionRules"><%= t('ts.positionSub') %></label>
            <textarea class="k-input" id="positionRules" name="positionRules" rows="3" placeholder="Scaling in/out, partials, trailing, when you move a stop…"><%= system.positionRules %></textarea>
          </div>
        </section>

        <section class="k-formcard k-savecard">
          <div class="k-field">
            <label class="k-fieldlabel" for="changeNote"><%= t('ts.whatChanged') %></label>
            <input class="k-input" type="text" id="changeNote" name="changeNote" maxlength="140" placeholder="<%= t('ts.changedPh') %>">
          </div>
          <div class="k-actions">
            <button type="submit" class="k-btn k-btn-primary"><%= t('system.save') %></button>
            <a class="k-btn k-btn-ghost" href="/dashboard"><%= t('ts.backCockpit') %></a>
          </div>
          <div class="k-fieldhint"><%= t('ts.nothingDeleted') %></div>
        </section>

      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

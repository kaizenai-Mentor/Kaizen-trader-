<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Bounties</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <div>
        <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span>
          Zero Authority DAO
        </div>
        <h1 style="font-size:1.6rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Discipline Challenges</h1>
        <p style="font-size:0.82rem;color:var(--ash);font-style:italic;">Earn on-chain reputation by completing challenges.</p>
      </div>
      <a href="/dashboard" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);border:1px solid var(--border);padding:10px 16px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.color='var(--gold)';this.style.borderColor='rgba(201,168,76,0.3)'" onmouseout="this.style.color='var(--ash)';this.style.borderColor='var(--border)'">
        <i data-feather="arrow-left" width="12" height="12"></i>
        Dashboard
      </a>
    </div>

    <% if (error) { %>
      <div style="padding:14px 18px;background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.2);border-left:2px solid #F87171;color:#F87171;font-size:0.85rem;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
        <i data-feather="alert-circle" width="14" height="14"></i>
        <%= error %>
      </div>
    <% } %>

    <% if (bounties.length === 0 && !error) { %>
      <div style="background:var(--bg-card);border:1px solid var(--border);padding:80px 32px;text-align:center;">
        <div style="width:44px;height:44px;border:1px solid var(--border);background:var(--bg-surface);display:flex;align-items:center;justify-content:center;color:var(--ash);margin:0 auto 16px;">
          <i data-feather="award" width="18" height="18"></i>
        </div>
        <h2 style="font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;">No bounties available right now</h2>
        <p style="font-size:0.85rem;color:var(--ash);">Check back soon for new discipline challenges.</p>
      </div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2px;">
        <% bounties.forEach(function(bounty) {
          var isClosed = bounty.bountyCompleted || bounty.status === 'Closed' || bounty.status === 'Completed' || bounty.isExpired || bounty.daysRemaining === 0;
        %>
          <div style="background:var(--bg-card);border:1px solid <%= isClosed ? 'var(--border)' : 'rgba(201,168,76,0.18)' %>;padding:22px;display:flex;flex-direction:column;">

            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
              <span style="font-family:'DM Mono',monospace;font-size:0.55rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,168,76,0.2);padding:3px 8px;display:flex;align-items:center;gap:4px;">
                <i data-feather="shield" width="9" height="9"></i>
                ZA Challenge
              </span>
              <% if (bounty.totalPayment || bounty.reward) { %>
                <span style="font-family:'DM Mono',monospace;font-size:0.75rem;font-weight:700;color:var(--gold);">
                  <%= bounty.totalPayment || bounty.reward %> <%= bounty.token ? bounty.token.symbol : '' %>
                </span>
              <% } %>
            </div>

            <h3 style="font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:10px;line-height:1.35;">
              <%= bounty.title || bounty.name || 'Discipline Challenge' %>
            </h3>

            <p style="font-size:0.82rem;color:var(--ash);line-height:1.7;flex:1;margin-bottom:18px;">
              <%= bounty.details || bounty.description ? (bounty.details || bounty.description).substring(0, 110) + '...' : 'Complete this challenge to earn ZA reputation.' %>
            </p>

            <div style="display:flex;align-items:center;justify-content:space-between;padding-top:14px;border-top:1px solid var(--border);">
              <% if (isClosed) { %>
                <span style="display:flex;align-items:center;gap:5px;font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);">
                  <i data-feather="lock" width="10" height="10"></i>
                  Closed
                </span>
              <% } else { %>
                <span style="display:flex;align-items:center;gap:5px;font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:#4ADE80;">
                  <div style="width:5px;height:5px;border-radius:50%;background:#4ADE80;"></div>
                  Open
                </span>
              <% } %>
              <a href="/za/bounties/<%= bounty.id || bounty._id %>" style="display:inline-flex;align-items:center;gap:5px;font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,168,76,0.25);padding:7px 14px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.background='rgba(201,168,76,0.08)'" onmouseout="this.style.background='transparent'">
                View
                <i data-feather="arrow-right" width="10" height="10"></i>
              </a>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>feather.replace();</script>
</body>
</html>

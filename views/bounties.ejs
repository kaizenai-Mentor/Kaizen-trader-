<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Bounties</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 class="bounties-header-text">Discipline Challenges</h1>
        <p class="page-sub">Powered by Zero Authority DAO — earn on-chain reputation</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (bounties.length === 0 && !error) { %>
      <div class="card">
        <div class="empty-state">
          <p>No bounties available right now.</p>
          <p>Check back soon for new discipline challenges.</p>
        </div>
      </div>
    <% } else { %>
      <div class="bounties-grid">
        <% bounties.forEach(function(bounty) { %>
          <div class="bounty-card">
            <div class="bounty-card-top">
              <span class="bounty-badge">ZA Challenge</span>
              <span class="bounty-reward">
                <%= bounty.totalPayment || bounty.reward || '' %>
                <%= bounty.token ? bounty.token.symbol : '' %>
              </span>
            </div>
            <h3 class="bounty-title">
              <%= bounty.title || bounty.name || 'Discipline Challenge' %>
            </h3>
            <p class="bounty-desc">
              <%= bounty.details || bounty.description
                ? (bounty.details || bounty.description).substring(0, 110) + '...'
                : 'Complete this challenge to earn ZA reputation.' %>
            </p>
            <div class="bounty-footer">
              <%
                var isClosed = bounty.bountyCompleted ||
                  bounty.status === 'Closed' ||
                  bounty.status === 'Completed' ||
                  bounty.isExpired ||
                  bounty.daysRemaining === 0;
              %>
              <% if (isClosed) { %>
                <span class="status-closed">Closed</span>
              <% } else { %>
                <span class="status-open">Open</span>
              <% } %>
              <a href="/za/bounties/<%= bounty.id || bounty._id %>"
                class="btn-outline btn-sm">View Details</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

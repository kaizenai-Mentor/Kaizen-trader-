          <div style="
            width:40px;height:40px;min-width:40px;
            border:1px solid rgba(201,168,76,0.2);
            background:rgba(201,168,76,0.05);
            display:flex;align-items:center;justify-content:center;
            color:var(--gold);
          ">
            <i data-feather="brain" width="18" height="18"></i>

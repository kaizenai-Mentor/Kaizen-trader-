<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.about') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-page-main">

    <!-- HEADER -->
    <div class="k-page-header k-grid-bg" data-reveal>
      <div class="k-eyebrow k-eyebrow--center"><%= t('about.eyebrow') %></div>
      <h1 class="k-page-h1"><%= t('about.about') %><span class="k-gold"><%= t('brand.kaizen') %></span></h1>
      <p class="k-page-sub"><%= t('about.sub') %></p>
    </div>

    <!-- THE PROBLEM -->
    <div class="k-problem" data-reveal>
      <div class="k-problem-eyebrow">
        <i data-feather="alert-triangle" width="14" height="14"></i><%= t('about.problem') %></div>
      <div class="k-problem-h"><%= t('about.p1') %></div>
      <p><%= t('about.p2') %></p>
    </div>

    <!-- THE SOLUTION -->
    <div class="k-solution">
      <div data-reveal>
        <div class="k-eyebrow"><%= t('about.solution') %></div>
        <h2 class="k-solution-h"><%= t('about.p3') %></h2>
        <p><%= t('about.p4') %></p>
        <p><%= t('about.p5') %></p>
      </div>
      <div class="k-solution-panel k-card--elevated k-grid-bg" data-reveal style="transition-delay:100ms;">
        <%- include('partials/k-dial', { value: 87, size: 180 }) %>
        <%- include('partials/k-meters', { meters: [
          [t('dash.dimProcess'), 91],
          [t('dash.dimRisk'), 86],
          [t('dash.dimExecution'), 88],
          [t('dash.dimBehavior'), 82],
          [t('dash.dimLearning'), 90]
        ] }) %>
        <div class="k-solution-caption"><%= t('about.tag1') %><br><%= t('about.tag2') %></div>
      </div>
    </div>

    <!-- HOW IS THIS SCORED? (the Cockpit links here) -->
    <div id="kaizen-score" data-reveal>
      <div class="k-eyebrow"><%= t('about.scoreH') %></div>
      <h2 class="k-title"><%= t('dash.howScored') %></h2>
      <p class="k-sub k-sub--left"><%= t('about.scoreB1') %><b><%= t('dash.building') %></b><%= t('about.scoreB2') %></p>
    </div>

    <div class="k-pillars">
      <div class="k-pillar k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="clipboard" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('dash.dimProcess') %></div>
          <p><%= t('about.d1') %></p>
        </div>
      </div>
      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="shield" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('dash.dimRisk') %></div>
          <p><%= t('about.d2') %></p>
        </div>
      </div>
      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:120ms;">
        <div class="k-icon-badge"><i data-feather="crosshair" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('dash.dimExecution') %></div>
          <p><%= t('about.d3') %></p>
        </div>
      </div>
      <div class="k-pillar k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="zap" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('dash.dimBehavior') %></div>
          <p><%= t('about.d4') %></p>
        </div>
      </div>
      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="trending-up" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('dash.dimLearning') %></div>
          <p><%= t('about.d5') %></p>
        </div>
      </div>
    </div>

    <!-- WHAT MAKES KAIZEN DIFFERENT -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('about.diffH') %></div>
    </div>
    <div class="k-pillars">

      <div class="k-pillar k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="activity" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('about.b1H') %></div>
          <p><%= t('about.b1B') %></p>
        </div>
      </div>

      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="brain" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('about.b2H') %></div>
          <p><%= t('about.b2B') %></p>
        </div>
      </div>

      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:120ms;">
        <div class="k-seal">認</div>
        <div>
          <div class="k-pillar-title"><%= t('about.b3H') %></div>
          <p><%= t('about.b3B') %></p>
        </div>
      </div>

      <div class="k-pillar k-card k-card--hover" data-reveal style="transition-delay:180ms;">
        <div class="k-icon-badge"><i data-feather="user" width="18" height="18"></i></div>
        <div>
          <div class="k-pillar-title"><%= t('about.b4H') %></div>
          <p><%= t('about.b4B') %></p>
        </div>
      </div>

    </div>

    <!-- IDENTITY & VERIFICATION -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.idH') %></div>
      <h2 class="k-title"><%= t('svc.idSub') %></h2>
      <p class="k-sub k-sub--left"><%= t('svc.idIntro') %></p>
    </div>

    <div class="k-verify-grid">

      <div class="k-verify-card k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="link" width="18" height="18"></i></div>
        <h3 class="k-verify-title"><%= t('svc.walletsH') %></h3>
        <p><%= t('about.walletsB') %></p>
        <span class="k-tag"><%= t('svc.stacks') %></span>
      </div>

      <div class="k-verify-card k-card k-card--featured" data-reveal style="transition-delay:80ms;">
        <div class="k-seal">認</div>
        <h3 class="k-verify-title"><%= t('svc.credH') %></h3>
        <p><%= t('about.credB') %></p>
        <span class="k-tag"><%= t('svc.mantle') %></span>
      </div>

      <div class="k-verify-card k-card k-card--hover" data-reveal style="transition-delay:160ms;">
        <div class="k-icon-badge"><i data-feather="globe" width="18" height="18"></i></div>
        <h3 class="k-verify-title"><%= t('svc.repH') %></h3>
        <p><%= t('about.repB') %></p>
        <span class="k-tag"><%= t('svc.optional') %></span>
      </div>

    </div>

    <!-- MISSION -->
    <div class="k-quote" data-reveal>
      <blockquote><%= t('about.quote') %></blockquote>
      <div class="k-quote-tag"><%= t('about.ctaH') %></div>
    </div>

    <!-- CTA -->
    <div class="k-page-cta" data-reveal>
      <a href="/auth/register" class="btn-primary k-btn-lg"><%= t('about.cta') %></a>
      <p class="k-page-cta-note"><%= t('about.ctaB') %></p>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script src="/js/v2-reveal.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

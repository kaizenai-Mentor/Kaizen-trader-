<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.record') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow">

    <div class="k-stepstrip">
      <span class="is-done"><%= t('plan.title') %> ✓</span><b>—</b>
      <span class="is-active"><%= t('record.title') %></span><b>—</b>
      <span><%= t('plan.stepReflect') %></span>
    </div>

    <div class="k-eyebrow" style="margin-bottom:10px;"><%= t('record.titlePre') %> <%= session.sessionType %></div>
    <h1 style="font-size:clamp(1.5rem,3.5vw,2.1rem);font-weight:700;color:var(--text-primary);line-height:1.15;margin:0 0 8px;"><%= t('record.writeWhat') %></h1>
    <p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.75;margin:0 0 24px;"><%= t('record.quickNote') %></p>

    <% if (session.plan && !session.plan.skipped) { %>
      <div class="k-card" style="margin-bottom:18px;border-color:var(--gold-border);">
        <div class="k-metric-label" style="margin-bottom:10px;"><%= t('detail.thePlan') %></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;font-size:0.8rem;color:var(--text-secondary);">
          <div><span class="k-gold"><%= t('record.lblSetup') %></span> <%= session.plan.setup || '—' %></div>
          <div><span class="k-gold"><%= t('record.lblEntry') %></span> <%= session.plan.entryCondition || '—' %></div>
          <div><span class="k-gold"><%= t('record.lblInv') %></span> <%= session.plan.invalidation || '—' %></div>
          <div><span class="k-gold"><%= t('record.lblRisk') %></span> <%= session.plan.predefinedRisk || '—' %></div>
        </div>
      </div>
    <% } %>

    <form action="/dashboard/sessions/<%= session._id %>/record" method="POST" enctype="multipart/form-data">

      <div class="k-card k-formcard" style="margin-bottom:14px;">
        <div class="k-metric-label" style="margin-bottom:10px;"><%= t('record.notes') %></div>
        <textarea name="notes" id="notes" class="k-input" rows="7" required
          placeholder="Took the EURUSD short off the 4H sweep. Entry was clean but I moved my invalidation twice when price squeezed — that was fear, not strategy. Sized in properly at 1%..."></textarea>
        <div class="k-voice-row"><%- include('partials/voice-button', { target: 'notes', status: 'notes-voice-status' }) %></div>
        <p class="k-voice-status" id="notes-voice-status" role="status" aria-live="polite"></p>
        <p class="k-voice-privacy">Your browser may send audio to its speech service. Review the text before saving.</p>
        <div id="autodetect" class="k-fieldhint" style="margin-top:8px;"></div>
        <input type="hidden" name="asset" id="asset" value="<%= (session.asset && session.asset !== 'General') ? session.asset : '' %>">
        <input type="hidden" name="timeframe" id="timeframe" value="N/A">
      </div>

      <% if (session.sessionType !== 'STUDY') { %>
        <div class="k-card k-formcard" style="margin-bottom:14px;">
          <div class="k-metric-label" style="margin-bottom:14px;"><%= t('record.quickChecks') %></div>

          <% if (session.plan && !session.plan.skipped) { %>
            <div class="k-checkrow">
              <span class="k-checklabel"><%= t('record.followedPlan') %></span>
              <div class="k-checkopts">
                <label class="k-opt"><input type="radio" name="followedPlan" value="YES"><span><%= t('common.yes') %></span></label>
                <label class="k-opt"><input type="radio" name="followedPlan" value="NO"><span><%= t('common.no') %></span></label>
              </div>
            </div>
            <div class="k-checkrow">
              <span class="k-checklabel"><%= t('record.withinEntry') %></span>
              <div class="k-checkopts">
                <label class="k-opt"><input type="radio" name="withinEntryCriteria" value="YES"><span><%= t('common.yes') %></span></label>
                <label class="k-opt"><input type="radio" name="withinEntryCriteria" value="NO"><span><%= t('common.no') %></span></label>
              </div>
            </div>
          <% } %>

          <div class="k-checkrow">
            <span class="k-checklabel"><%= t('record.stuckToRisk') %></span>
            <div class="k-checkopts">
              <label class="k-opt"><input type="radio" name="respectedRisk" value="YES"><span><%= t('common.yes') %></span></label>
              <label class="k-opt"><input type="radio" name="respectedRisk" value="NO"><span><%= t('common.no') %></span></label>
            </div>
          </div>
          <div id="record-actual-risk-box" style="display:none;margin:8px 0 12px;padding:12px;border:1px solid rgba(245,197,24,0.25);border-radius:10px;background:rgba(245,197,24,0.04);">
            <label class="k-fieldlabel" style="margin-bottom:6px;">EXACT RISK USED DURING THIS TRADE</label>
            <input type="text" name="actualRisk" id="record-actual-risk-input" class="k-input" placeholder="State the exact risk used (e.g. 1.5%, 2%, $400)">
          </div>

          <div class="k-checkrow">
            <span class="k-checklabel"><%= t('sessions.outcome') %></span>
            <div class="k-checkopts">
              <% ['WIN','LOSS','BREAKEVEN','NO TRADE'].forEach(function(o){ %>
                <label class="k-opt"><input type="radio" name="outcome" value="<%= o === 'WIN' ? 'Win' : o === 'LOSS' ? 'Loss' : o === 'BREAKEVEN' ? 'Breakeven' : 'No Trade' %>"><span><%= o %></span></label>
              <% }); %>
            </div>
          </div>

          <div style="margin-top:16px;">
            <div class="k-field" style="margin:0;">
              <label class="k-fieldlabel"><%= t('record.rr') %></label>
              <input type="text" name="rrAchieved" class="k-input" placeholder="<%= t('record.rrPh') %>">
            </div>
          </div>
        </div>
      <% } %>

      <div class="k-card k-formcard" style="margin-bottom:18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
          <div class="k-metric-label" style="margin-bottom:0;"><%= t('record.chart') %></div>
          <span style="font-family:var(--font-mono);font-size:0.56rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);">MULTIPLE IMAGES SUPPORTED (UP TO 8)</span>
        </div>
        <input type="file" name="chartImage" id="chartImageInput" accept="image/*" multiple class="k-input" style="padding:10px;">
        <div id="chartImageCountHint" class="k-fieldhint" style="margin-top:6px;">Select 1 or more chart screenshots (HTF structure, LTF entry, execution).</div>
        <div id="chartImagePreviewGrid" style="display:none;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:12px;"></div>
      </div>

      <div class="k-actions">
        <button type="submit" class="btn-primary k-btn-lg"><%= t('record.submit') %></button>
      </div>
    </form>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/voice-input.js"></script>
  <script src="/js/app.js"></script>
  <script>
    if (window.feather) if (window.feather) feather.replace();
    // Auto-detect asset/timeframe from notes (V1 precedent, kept)
    (function () {
      var notes = document.getElementById('notes');
      var out = document.getElementById('autodetect');
      var assetEl = document.getElementById('asset');
      var tfEl = document.getElementById('timeframe');
      var initialAsset = assetEl ? assetEl.value : '';
      var ASSETS = /\b(EUR\/?USD|GBP\/?USD|USD\/?JPY|AUD\/?JPY|GBP\/?JPY|EUR\/?JPY|AUD\/?USD|USD\/?CAD|USD\/?CHF|NZD\/?USD|EUR\/?GBP|EUR\/?AUD|GBP\/?AUD|CAD\/?JPY|CHF\/?JPY|AUD\/?CAD|AUD\/?NZD|NZD\/?JPY|GBP\/?CAD|EUR\/?CAD|GBP\/?CHF|EUR\/?CHF|XAU\/?USD|XAG\/?USD|NAS100|US100|SPX500|US500|US30|GER40|BTC\/?USD|ETH\/?USD|USOIL|UKOIL|XAU|DXY|GOLD)\b/i;
      var TFS = /\b(1m|5m|15m|30m|1h|4h|1d|1w|M1|M5|M15|M30|H1|H4|D1|W1)\b/i;
      function detect() {
        var t = notes.value || '';
        var a = t.match(ASSETS), f = t.match(TFS);
        var parts = [];
        if (a) {
          var norm = a[1].toUpperCase().replace('/', '');
          if (norm === 'GOLD') norm = 'XAUUSD';
          assetEl.value = norm;
          parts.push(norm);
        } else if (initialAsset) {
          assetEl.value = initialAsset;
          parts.push(initialAsset);
        }
        if (f) { tfEl.value = f[1].toUpperCase(); parts.push(f[1].toUpperCase()); }
        out.textContent = parts.length ? parts.join(' · ') + ' — detected from your notes ✓' : '';
      }
      notes.addEventListener('input', detect);
      detect();

      // Reveal exact risk box if trader selects NO on "Did you stick to the planned risk?"
      var riskRadios = document.querySelectorAll('input[name="respectedRisk"]');
      var actualRiskBox = document.getElementById('record-actual-risk-box');
      var actualRiskInput = document.getElementById('record-actual-risk-input');
      if (riskRadios.length && actualRiskBox && actualRiskInput) {
        Array.prototype.forEach.call(riskRadios, function (r) {
          r.addEventListener('change', function () {
            var isNo = r.checked && r.value === 'NO';
            actualRiskBox.style.display = isNo ? 'block' : 'none';
            if (isNo) { try { actualRiskInput.focus(); } catch (e) {} }
            else { actualRiskInput.value = ''; }
          });
        });
      }

      // Multi-image selection counter + thumbnail previews
      var chartInput = document.getElementById('chartImageInput');
      var chartHint = document.getElementById('chartImageCountHint');
      var chartGrid = document.getElementById('chartImagePreviewGrid');
      if (chartInput && chartHint && chartGrid) {
        chartInput.addEventListener('change', function () {
          var files = chartInput.files ? Array.prototype.slice.call(chartInput.files, 0, 8) : [];
          chartGrid.innerHTML = '';
          if (!files.length) {
            chartHint.textContent = 'Select 1 or more chart screenshots (HTF structure, LTF entry, execution).';
            chartGrid.style.display = 'none';
            return;
          }
          chartHint.textContent = files.length + ' chart image' + (files.length === 1 ? '' : 's') + ' selected ✓';
          chartGrid.style.display = 'grid';
          files.forEach(function (file, idx) {
            var wrap = document.createElement('div');
            wrap.style.cssText = 'border:1px solid var(--border);border-radius:8px;overflow:hidden;background:rgba(0,0,0,0.2);position:relative;';
            var img = document.createElement('img');
            img.style.cssText = 'width:100%;height:90px;object-fit:cover;display:block;';
            img.alt = 'Chart ' + (idx + 1);
            try {
              img.src = URL.createObjectURL(file);
            } catch (e) {}
            var cap = document.createElement('div');
            cap.style.cssText = 'font-family:var(--font-mono);font-size:0.55rem;padding:4px 6px;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
            cap.textContent = 'Chart #' + (idx + 1) + ' · ' + (file.name || '');
            wrap.appendChild(img);
            wrap.appendChild(cap);
            chartGrid.appendChild(wrap);
          });
        });
      }
    })();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.reputation') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="app-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <div>
        <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:16px;height:1px;background:var(--gold);display:inline-block;"></span><%= t('rep.eyebrow') %></div>
        <h1 style="font-size:1.6rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;"><%= t('rep.title') %></h1>
        <p style="font-size:0.82rem;color:var(--ash);font-style:italic;"><%= t('rep.sub') %></p>
      </div>
      <a href="/dashboard" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);border:1px solid var(--border);border-radius:10px;padding:10px 16px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.color='var(--gold)';this.style.borderColor='rgba(245,197,24,0.3)'" onmouseout="this.style.color='var(--ash)';this.style.borderColor='var(--border)'">
        <i data-feather="arrow-left" width="12" height="12"></i> <%= t('crumb.dashboard') %></a>
    </div>

    <!-- KAIZEN DISCIPLINE SCORE CARD -->
    <section class="k-card k-card--elevated" style="border-radius:16px;padding:28px;margin-bottom:20px;position:relative;overflow:hidden;">
      <div style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--text-secondary);margin-bottom:16px;display:flex;align-items:center;gap:8px;font-weight:600;">
        <i data-feather="bar-chart-2" width="13" height="13" style="color:var(--gold);"></i> <%= t('rep.discScore') %></div>

      <div style="display:flex;align-items:flex-end;gap:18px;margin-bottom:20px;flex-wrap:wrap;">
        <div>
          <div style="font-family:var(--font-heading);font-size:3.8rem;font-weight:700;color:var(--gold);line-height:1;">
            <%= disciplineScore %><span style="font-size:1.5rem;color:var(--gold);">%</span>
          </div>
          <div style="height:6px;background:#DCE6EE;border-radius:99px;margin-top:10px;width:220px;overflow:hidden;">
            <div style="height:100%;background:var(--gold);border-radius:99px;width:<%= disciplineScore %>%;transition:width 1.2s ease;"></div>
          </div>
        </div>
        <div style="padding-bottom:6px;">
          <div style="
            font-family:'DM Mono',monospace;
            font-size:0.68rem;
            font-weight:700;
            letter-spacing:0.14em;
            text-transform:uppercase;
            padding:6px 14px;
            border-radius:99px;
            border:1px solid #1A2F4A;
            color:#F4F8FB;
            background:#1A2F4A;
            display:inline-block;
          ">
            <%= disciplineScore >= 80 ? 'ELITE' : disciplineScore >= 60 ? 'CONSISTENT' : disciplineScore >= 40 ? 'BUILDING' : 'DEVELOPING' %>
          </div>
          <div style="font-size:0.78rem;color:var(--text-secondary);margin-top:8px;"><%= t('rep.basedOn') %> <%= totalSessions || 0 %> <%= t('rep.sessionsLogged') %></div>
        </div>
      </div>

      <!-- Stats row -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;">
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:#0A0A0A;"><%= totalSessions || 0 %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.sessions') %></div>
        </div>
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:<%= (streak || 0) >= 7 ? '#16A34A' : '#0A0A0A' %>;"><%= streak || 0 %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.dayStreak') %></div>
        </div>
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:#0A0A0A;">
            <%= (profileUser && profileUser.badges ? profileUser.badges.length : (user && user.badges ? user.badges.length : 0)) %>
          </div>
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.badges') %></div>
        </div>
      </div>

      <!-- DANGER ZONE -->
      <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--border);">
        <div style="font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.15em;text-transform:uppercase;color:#DC2626;margin-bottom:10px;display:flex;align-items:center;gap:6px;font-weight:600;">
          <i data-feather="alert-triangle" width="12" height="12"></i> <%= t('rep.danger') %></div>
        <button onclick="if(confirm(<%- JSON.stringify(t('rep.deleteConfirm')).replace(/"/g, '&quot;') %>)) window.location='/auth/delete'" style="
          background:rgba(220,38,38,0.06);
          border:1px solid rgba(220,38,38,0.35);
          border-radius:10px;
          color:#DC2626;
          font-family:'DM Mono',monospace;
          font-size:0.62rem;
          font-weight:600;
          letter-spacing:0.1em;
          text-transform:uppercase;
          padding:10px 20px;
          cursor:pointer;
          display:inline-flex;align-items:center;gap:6px;
          transition:all 0.2s;
        " onmouseover="this.style.background='rgba(220,38,38,0.12)'" onmouseout="this.style.background='rgba(220,38,38,0.06)'">
          <i data-feather="trash-2" width="12" height="12"></i> <%= t('rep.delete') %></button>
      </div>
    </section>

    <!-- MANTLE AI BENCHMARK CARD -->
    <section class="k-card" style="border-radius:16px;padding:28px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:34px;height:34px;border-radius:10px;border:1px solid #DCE6EE;background:#E8EFF5;display:flex;align-items:center;justify-content:center;color:#1A2F4A;">
            <i data-feather="link" width="15" height="15"></i>
          </div>
          <div>
            <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--text-primary);"><%= t('rep.mantleTitle') %></div>
            <div style="font-size:0.76rem;color:var(--text-secondary);"><%= t('rep.mantleSub') %></div>
          </div>
        </div>
        <span style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;background:#1A2F4A;color:#F4F8FB;border-radius:99px;padding:5px 12px;font-weight:600;"><%= t('rep.onchain') %></span>
      </div>

      <p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.75;margin-bottom:20px;"><%= t('rep.onchainBody') %></p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:20px;">
        <div style="background:#0A0A0A;border:1px solid rgba(245,197,24,0.45);border-radius:12px;padding:16px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.4rem;font-weight:700;color:#F5C518;"><%= mantleUserStats.currentScore %>%</div>
          <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:#A3B1BF;margin-top:4px;"><%= t('rep.onchainScore') %></div>
        </div>
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.4rem;font-weight:700;color:#1A2F4A;"><%= mantleUserStats.sessionCount || 0 %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.statSessions') %></div>
        </div>
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.4rem;font-weight:700;color:#0A0A0A;"><%= mantleUserStats.milestoneCount || 0 %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.milestones') %></div>
        </div>
        <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-family:var(--font-heading);font-size:1.4rem;font-weight:700;color:<%= (streak||0) >= 7 ? '#16A34A' : '#0A0A0A' %>;"><%= mantleEvents || 0 %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;margin-top:4px;"><%= t('rep.totalEvents') %></div>
        </div>
      </div>

      <% if (mantleRecent && mantleRecent.length) { %>
        <div style="margin-bottom:20px;">
          <div style="font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;margin-bottom:10px;font-weight:600;"><%= t('rep.recentRecords') %></div>
          <% mantleRecent.forEach(function(ev){ %>
            <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid #DCE6EE;border-radius:10px;background:#FFFFFF;margin-bottom:8px;flex-wrap:wrap;">
              <span style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;color:#F4F8FB;background:#1A2F4A;border-radius:99px;padding:3px 9px;"><%= ev.type %></span>
              <span style="font-size:0.8rem;color:#0A0A0A;font-weight:500;"><%= ev.label %></span>
              <% if (ev.ts) { %>
                <span style="font-family:'DM Mono',monospace;font-size:0.55rem;color:#41566B;margin-left:auto;">
                  <%= new Date(ev.ts).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
                </span>
              <% } %>
              <% if (ev.txHash) { %>
                <a href="<%= mantleExplorer %>/tx/<%= ev.txHash %>" target="_blank" style="font-family:'DM Mono',monospace;font-size:0.55rem;color:#1A2F4A;font-weight:600;text-decoration:none;">
                  <%= ev.txHash.substring(0, 8) %>… ↗
                </a>
              <% } %>
            </div>
          <% }); %>
          <div style="font-family:'DM Mono',monospace;font-size:0.54rem;letter-spacing:0.06em;color:#41566B;margin-top:8px;line-height:1.6;"><%= t('rep.eachRecord') %></div>
        </div>
      <% } else if (mantleNote) { %>
        <p style="font-size:0.8rem;color:#41566B;line-height:1.7;margin-bottom:20px;padding:14px 16px;border:1px dashed #C9D6E2;border-radius:12px;background:#FFFFFF;">
          <%= mantleNote %>
        </p>
      <% } %>

      <a href="<%= mantleExplorer %>/address/<%= process.env.MANTLE_CONTRACT_ADDRESS || '' %>" target="_blank" style="display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:0.62rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#F4F8FB;background:#1A2F4A;border:1px solid #1A2F4A;border-radius:10px;padding:11px 18px;text-decoration:none;transition:all 0.2s;">
        <%= t('rep.viewExplorer') %> <i data-feather="external-link" width="11" height="11"></i>
      </a>

      <p style="font-family:'DM Mono',monospace;font-size:0.54rem;letter-spacing:0.08em;color:#41566B;margin-top:14px;text-transform:uppercase;"><%= t('rep.poweredBy') %> <%= mantleNetwork || 'Mantle Sepolia Testnet' %>
      </p>
    </section>

    <%
      var minDossierReq = 10;
      var recDossierReq = 15;
      var ds = (typeof dossier !== 'undefined' && dossier) ? dossier : {
        verificationId: 'KZN-2026-VERIFIED',
        username: (profileUser && profileUser.username) || 'Trader',
        memberSince: '2026',
        kaizenScore: disciplineScore || 0,
        complianceRate: disciplineScore || 0,
        totalSessions: totalSessions || 0,
        minRequiredSessions: minDossierReq,
        recommendedSessions: recDossierReq,
        dossierUnlocked: (totalSessions || 0) >= minDossierReq,
        sessionsRemaining: Math.max(0, minDossierReq - (totalSessions || 0)),
        brokerConnection: (profileUser && profileUser.brokerConnection && profileUser.brokerConnection.active) ? profileUser.brokerConnection : null,
        studySessions: 0,
        brokerVerifiedCount: 0,
        topInstruments: ['Multi-Asset'],
        topStrategies: ['Structured System'],
        riskPerTrade: '1% predefined risk per trade',
        howITrade: ((profileUser && profileUser.username) || 'This trader') + ' operates a structured trading methodology governed by pre-trade checklist confirmation and strict risk discipline.',
        behavioralSummary: 'KAIZEN Memory tracks pre-session plans, chart studies, and post-session reflections to establish a verified behavioral track record.',
        memorableDecisions: [],
        pnlSummary: {
          decidedTrades: 0,
          wins: 0,
          losses: 0,
          breakevens: 0,
          winRate: 0,
          netR: 0,
          netRLabel: '0.0R',
          netReturnPct: 0,
          netReturnPctLabel: '0.0%',
          avgRRLabel: '1 : 2.0',
          bestTradeLabel: '0.0R',
          profitFactor: 0,
          profitFactorLabel: '0.00',
          riskCeiling: '1% per trade',
          narrative: 'Performance and P&L metrics populate automatically from decided live executions and synced read-only broker history.'
        }
      };
      var pnl = ds.pnlSummary || {
        decidedTrades: 0, wins: 0, losses: 0, breakevens: 0, winRate: 0,
        netR: 0, netRLabel: '0.0R', netReturnPct: 0, netReturnPctLabel: '0.0%',
        avgRRLabel: '1 : 2.0', bestTradeLabel: '0.0R', profitFactor: 0, profitFactorLabel: '0.00',
        riskCeiling: ds.riskPerTrade || '1% per trade',
        narrative: 'Performance and P&L metrics populate automatically from decided live executions and synced read-only broker history.'
      };
      var isDossierUnlocked = ds.totalSessions >= (ds.minRequiredSessions || 10);
      var remainingForDossier = Math.max(0, (ds.minRequiredSessions || 10) - (ds.totalSessions || 0));
    %>

    <!-- ═══ BRANDED KAIZEN TRADER'S CARD & OFFICIAL CERTIFICATE DOSSIER ═══ -->
    <section id="traders-card" style="position:relative;overflow:hidden;background:linear-gradient(180deg, #101824 0%, #0A0A0A 100%);border:2px solid #F5C518;box-shadow:inset 0 0 0 4px #0A0A0A, inset 0 0 0 5px rgba(245,197,24,0.45), 0 28px 56px rgba(0,0,0,0.48);border-radius:20px;padding:32px;margin-top:24px;color:#F4F8FB;">

      <!-- Centered Upright KAIZEN Kanji Seal Watermark (Brand Consistent, Zero Slant, No Extra Text on Site) -->
      <div aria-hidden="true" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;user-select:none;z-index:3;opacity:0.09;">
        <div style="width:188px;height:188px;border:3px solid #F5C518;border-radius:24px;display:flex;align-items:center;justify-content:center;">
          <div style="font-family:var(--font-cjk);font-size:8.6rem;line-height:1;color:#F5C518;font-weight:700;">改</div>
        </div>
      </div>

      <div style="position:relative;z-index:1;">
      <!-- Top Brand Crest & Official Logo -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:20px;border-bottom:1px solid rgba(245,197,24,0.28);margin-bottom:22px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <span class="k-kanji k-kanji--md" style="background:rgba(245,197,24,0.14);border-color:rgba(245,197,24,0.65);color:#F5C518;">改</span>
          <div>
            <div style="font-family:var(--font-heading);font-weight:700;font-size:1.12rem;letter-spacing:0.06em;color:#F4F8FB;">KAIZEN OFFICIAL TRADER CERTIFICATE &amp; DOSSIER</div>
            <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:#F5C518;">AUTO-GENERATED FROM KAIZEN MEMORIES &amp; BROKER VERIFICATION</div>
          </div>
        </div>
        <div style="text-align:right;">
          <div style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.14em;color:#0A0A0A;background:#F5C518;border:1px solid #F5C518;padding:6px 12px;border-radius:999px;font-weight:700;"><%= ds.verificationId %></div>
        </div>
      </div>

      <% if (typeof importedCount === 'number') { %>
        <div style="margin-bottom:18px;padding:12px 16px;border-radius:12px;border:1px solid rgba(245,197,24,0.45);background:rgba(245,197,24,0.08);font-size:0.84rem;color:#F4F8FB;">
          <% if (importedCount > 0) { %>
            Synced &amp; verified <%= importedCount %> broker trade record<%= importedCount === 1 ? '' : 's' %> (sensitive account numbers, logins, and dollar balances stripped automatically).
          <% } else { %>
            No valid broker execution telemetry detected. Plain typed lines are rejected to prevent trade forgery — please link your One-Time Read-Only Investor Password / API Key or upload an official MT5 Journal execution log (with timestamp &amp; deal/order ticket) or .html/.csv statement below.
          <% } %>
        </div>
      <% } %>

      <% if (ds.brokerConnection && ds.brokerConnection.active) { %>
        <div style="margin-bottom:18px;padding:11px 16px;border-radius:12px;border:1px solid rgba(22,163,74,0.45);background:rgba(22,163,74,0.12);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:0.8rem;color:#F4F8FB;">
          <span><strong style="color:#4ADE80;">● ONE-TIME READ-ONLY BROKER LINK ACTIVE:</strong> <%= ds.brokerConnection.platform %> · <%= ds.brokerConnection.server %> (<%= ds.brokerConnection.maskedAccount %>)</span>
          <span style="font-family:'DM Mono',monospace;font-size:0.58rem;color:#A3B1BF;">Auto-skims &amp; verifies every new LIVE session</span>
        </div>
      <% } %>

      <% if (!isDossierUnlocked) { %>
        <div style="margin-bottom:20px;padding:18px 20px;border-radius:14px;border:1px solid rgba(245,197,24,0.55);background:rgba(26,47,74,0.65);color:#F4F8FB;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
            <span style="font-family:'DM Mono',monospace;font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:#F5C518;font-weight:700;">
              DOSSIER UNLOCK REQUIREMENT · MINIMUM 10 TO 15 LOGGED SESSIONS
            </span>
            <span style="font-family:'DM Mono',monospace;font-size:0.68rem;color:#F5C518;font-weight:700;">
              <%= ds.totalSessions %> / <%= ds.minRequiredSessions || 10 %> Sessions Logged
            </span>
          </div>
          <div style="height:8px;background:rgba(244,248,251,0.14);border-radius:99px;overflow:hidden;margin-bottom:10px;">
            <div style="height:100%;width:<%= Math.min(100, Math.round((ds.totalSessions / (ds.minRequiredSessions || 10)) * 100)) %>%;background:#F5C518;border-radius:99px;"></div>
          </div>
          <p style="font-size:0.82rem;color:#C4D0DC;margin:0;line-height:1.65;">
            To ensure institutional credibility and prevent 1-trade gaming, KAIZEN requires a minimum of <strong>10 to 15 logged sessions</strong> before unlocking your official downloadable <strong>Trader Certificate &amp; Dossier PDF</strong>. Log <strong><%= remainingForDossier %> more session<%= remainingForDossier === 1 ? '' : 's' %></strong> to unlock your official certificate.
          </p>
        </div>
      <% } %>

      <!-- Trader Identity + Core Verified Metrics Strip -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:12px;margin-bottom:22px;">
        <div style="background:#1A2F4A;border:1px solid rgba(244,248,251,0.14);border-radius:14px;padding:16px;">
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.12em;text-transform:uppercase;color:#A3B1BF;">TRADER HANDLE</div>
          <div style="font-family:var(--font-heading);font-size:1.15rem;font-weight:700;color:#F4F8FB;margin-top:4px;"><%= ds.username %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#F5C518;margin-top:2px;">Member since <%= ds.memberSince %></div>
        </div>
        <div style="background:#0A0A0A;border:1px solid rgba(245,197,24,0.5);border-radius:14px;padding:16px;color:#F4F8FB;">
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.12em;text-transform:uppercase;color:#A3B1BF;">KAIZEN SCORE</div>
          <div style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:#F5C518;margin-top:4px;"><%= ds.kaizenScore %>%</div>
          <div style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#F5C518;margin-top:2px;">Rule Compliance: <%= ds.complianceRate %>%</div>
        </div>
        <div style="background:#F4F8FB;border:1px solid #DCE6EE;border-radius:14px;padding:16px;color:#0A0A0A;">
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;">LOGGED SESSIONS</div>
          <div style="font-family:var(--font-heading);font-size:1.45rem;font-weight:700;color:#0A0A0A;margin-top:4px;"><%= ds.totalSessions %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#1A2F4A;margin-top:2px;font-weight:600;">Broker-Verified: <%= ds.brokerVerifiedCount %></div>
        </div>
        <div style="background:#F4F8FB;border:1px solid #DCE6EE;border-radius:14px;padding:16px;color:#0A0A0A;" id="dossier-focus-box">
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;">PRIMARY FOCUS</div>
          <div style="font-family:var(--font-heading);font-size:0.95rem;font-weight:700;color:#0A0A0A;margin-top:4px;" data-redactable="instruments"><%= ds.topInstruments.join(' · ') %></div>
          <div style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#1A2F4A;margin-top:2px;" data-redactable="strategy"><%= ds.topStrategies.join(' · ') %></div>
        </div>
      </div>

      <!-- ═══ SECTION I: BEHAVIORAL FEEDBACK & KAIZEN MEMORY RECORD ═══ -->
      <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:#F5C518;font-weight:700;margin-bottom:8px;">
        SECTION I · BEHAVIORAL FEEDBACK &amp; KAIZEN MEMORY RECORD
      </div>
      <!-- Auto-Written Executive Summary from KAIZEN Memories -->
      <div style="background:rgba(244,248,251,0.95);color:#0A0A0A;border:1px solid #DCE6EE;border-radius:16px;padding:22px;margin-bottom:18px;">
        <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:#1A2F4A;font-weight:600;margin-bottom:8px;">HOW THIS TRADER OPERATES (AUTO-GENERATED BY KAIZEN MEMORY)</div>
        <p style="font-size:0.9rem;color:#0A0A0A;line-height:1.78;margin:0 0 12px;" data-redactable="summary"><%= ds.howITrade %></p>
        <p style="font-size:0.86rem;color:#41566B;line-height:1.75;margin:0;"><%= ds.behavioralSummary %></p>
      </div>

      <!-- Auto-Selected Defining Trading & Study Decisions from Memories (Balanced Good & Lesson Sessions) -->
      <% if (ds.memorableDecisions && ds.memorableDecisions.length) { %>
        <div style="background:rgba(244,248,251,0.95);color:#0A0A0A;border:1px solid #DCE6EE;border-radius:16px;padding:22px;margin-bottom:20px;" id="dossier-decisions-box">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
            <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:#1A2F4A;font-weight:600;">DEFINING TRADING &amp; STUDY DECISIONS (BALANCED KAIZEN MEMORY RECORD)</div>
            <span style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#41566B;">Balanced mix of winning/compliant executions &amp; growth lessons</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <% ds.memorableDecisions.forEach(function(dec) { %>
              <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-left:4px solid <%= dec.isGood ? '#16A34A' : '#EA580C' %>;border-radius:12px;padding:14px 16px;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px;">
                  <span style="font-family:var(--font-heading);font-weight:700;font-size:0.86rem;color:#0A0A0A;" data-redactable="instruments"><%= dec.instrument %> · <%= dec.strategy %></span>
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;padding:3px 8px;border-radius:99px;font-weight:700;background:<%= dec.isGood ? 'rgba(22,163,74,0.12)' : 'rgba(234,88,12,0.12)' %>;color:<%= dec.isGood ? '#16A34A' : '#EA580C' %>;border:1px solid <%= dec.isGood ? 'rgba(22,163,74,0.35)' : 'rgba(234,88,12,0.35)' %>;"><%= dec.qualityLabel || (dec.isGood ? 'DISCIPLINED EXECUTION' : 'GROWTH & LESSON') %></span>
                    <span style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;padding:3px 8px;border-radius:99px;background:#1A2F4A;color:#F4F8FB;"><%= dec.mode %></span>
                    <span style="font-family:'DM Mono',monospace;font-size:0.55rem;color:#41566B;" data-redactable="dates"><%= dec.date %></span>
                  </div>
                </div>
                <p style="font-size:0.84rem;color:#0A0A0A;line-height:1.7;margin:0 0 6px;">"<%= dec.narrative %>"</p>
                <div style="font-size:0.78rem;color:#41566B;line-height:1.6;"><strong>KAIZEN Takeaway:</strong> <%= dec.lesson %></div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- ═══ SECTION II: VERIFIED PERFORMANCE & P&L RECORD ═══ -->
      <div id="dossier-pnl-box" style="margin-bottom:18px;">
        <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:#F5C518;font-weight:700;margin-bottom:8px;">
          SECTION II · VERIFIED PERFORMANCE &amp; P&amp;L RECORD
        </div>
        <div style="background:rgba(244,248,251,0.95);color:#0A0A0A;border:1px solid #DCE6EE;border-radius:16px;padding:22px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
            <div style="font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:#1A2F4A;font-weight:600;">EXECUTION EXPECTANCY &amp; CUMULATIVE P&amp;L SUMMARY</div>
            <span style="font-family:'DM Mono',monospace;font-size:0.54rem;color:#41566B;">Computed from Verified Live Sessions &amp; Declared Risk Ceiling (<%= ds.riskPerTrade %>)</span>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:10px;margin-bottom:14px;">
            <div style="background:#0A0A0A;border:1px solid rgba(245,197,24,0.5);border-radius:12px;padding:14px;color:#F4F8FB;">
              <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:#A3B1BF;">NET P&amp;L RETURN</div>
              <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:<%= pnl.netR >= 0 ? '#F5C518' : '#F87171' %>;margin-top:4px;" data-redactable="pnl"><%= pnl.netReturnPctLabel %> (<%= pnl.netRLabel %>)</div>
              <div style="font-family:'DM Mono',monospace;font-size:0.52rem;color:#A3B1BF;margin-top:2px;">At <%= ds.riskPerTrade %></div>
            </div>
            <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;color:#0A0A0A;">
              <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;">LIVE WIN RATE</div>
              <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:#1A2F4A;margin-top:4px;" data-redactable="pnl"><%= pnl.winRate %>%</div>
              <div style="font-family:'DM Mono',monospace;font-size:0.52rem;color:#41566B;margin-top:2px;" data-redactable="pnl"><%= pnl.wins %>W · <%= pnl.losses %>L · <%= pnl.breakevens %>BE</div>
            </div>
            <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;color:#0A0A0A;">
              <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;">AVG R:R ACHIEVED</div>
              <div style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;color:#0A0A0A;margin-top:4px;" data-redactable="pnl"><%= pnl.avgRRLabel %></div>
              <div style="font-family:'DM Mono',monospace;font-size:0.52rem;color:#16A34A;margin-top:2px;font-weight:600;" data-redactable="pnl">Best Session: <%= pnl.bestTradeLabel %></div>
            </div>
            <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:12px;padding:14px;color:#0A0A0A;">
              <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:#41566B;">PROFIT FACTOR</div>
              <div style="font-family:var(--font-heading);font-size:1.3rem;font-weight:700;color:#0A0A0A;margin-top:4px;" data-redactable="pnl"><%= pnl.profitFactorLabel %></div>
              <div style="font-family:'DM Mono',monospace;font-size:0.52rem;color:#41566B;margin-top:2px;">Decided Live: <%= pnl.decidedTrades %></div>
            </div>
          </div>

          <p style="font-size:0.86rem;color:#0A0A0A;line-height:1.75;margin:0;" data-redactable="pnl"><%= pnl.narrative %></p>
        </div>
      </div>

      <!-- One-Click Privacy Redaction Controls (Trader Right to Redact) -->
      <div style="background:rgba(26,47,74,0.45);border:1px solid rgba(244,248,251,0.14);border-radius:14px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div style="font-size:0.78rem;color:#C4D0DC;">
          <strong style="color:#F5C518;">Privacy &amp; Redaction Controls:</strong> Zero bank details, logins, or dollar balances are ever collected. Toggle to redact details on your card &amp; PDF:
        </div>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-family:'DM Mono',monospace;font-size:0.6rem;">
          <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><input type="checkbox" id="chk-redact-pairs" onchange="toggleDossierRedact('instruments', this.checked);updatePdfDownloadHref();"> Redact Pairs</label>
          <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><input type="checkbox" id="chk-redact-dates" onchange="toggleDossierRedact('dates', this.checked);updatePdfDownloadHref();"> Redact Dates</label>
          <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><input type="checkbox" id="chk-redact-pnl" onchange="toggleDossierRedact('pnl', this.checked);updatePdfDownloadHref();"> Redact P&amp;L</label>
          <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><input type="checkbox" id="chk-hide-quotes" onchange="var b=document.getElementById('dossier-decisions-box');if(b)b.style.display=this.checked?'none':'block';updatePdfDownloadHref();"> Hide Decision Quotes</label>
        </div>
      </div>

      <!-- Official KAIZEN Logo + Founder Authentication Signature & Vermillion Seal -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px;padding-top:18px;border-top:1px solid rgba(245,197,24,0.28);">
        <div style="display:flex;align-items:center;gap:12px;">
          <span class="k-seal" title="Verified by KAIZEN">改</span>
          <div>
            <div style="font-family:var(--font-heading);font-size:0.84rem;font-weight:700;color:#F4F8FB;">AUTHENTICATED BY KAIZEN</div>
            <div style="font-size:0.74rem;color:#A3B1BF;">Tamper-evident behavioral &amp; execution certificate · <%= mantleNetwork || 'Mantle Network' %></div>
          </div>
        </div>
        <div style="text-align:right;">
          <div style="font-family:Georgia, 'Times New Roman', serif;font-style:italic;font-size:1.25rem;color:#F5C518;letter-spacing:0.03em;line-height:1.1;">Dennis · Kaizen Mentor</div>
          <div style="font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.14em;text-transform:uppercase;color:#A3B1BF;margin-top:4px;">FOUNDER SIGNATURE &amp; AUTHENTICATION SEAL</div>
        </div>
      </div>

      <!-- Actions: Direct Download as PDF (with KAIZEN Watermark, gated at 10-15 sessions) & Sync Broker History -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:20px;padding-top:16px;border-top:1px dashed rgba(244,248,251,0.16);">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <% if (isDossierUnlocked) { %>
            <a id="dossier-pdf-link" href="/za/reputation/<%= profileUser._id %>/dossier.pdf" download="KAIZEN-Trader-Certificate-<%= ds.username %>.pdf" class="btn-primary" style="font-size:0.82rem;padding:12px 22px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;">
              <i data-feather="download" width="14" height="14"></i> Download Certificate &amp; Dossier as PDF
            </a>
          <% } else { %>
            <span style="font-family:'DM Mono',monospace;font-size:0.66rem;letter-spacing:0.08em;color:#F5C518;background:rgba(245,197,24,0.1);border:1px solid rgba(245,197,24,0.4);padding:11px 18px;border-radius:10px;display:inline-flex;align-items:center;gap:8px;">
              <i data-feather="lock" width="13" height="13"></i> Log <%= remainingForDossier %> More Session<%= remainingForDossier === 1 ? '' : 's' %> to Unlock Official PDF Certificate (10 to 15 Minimum)
            </span>
          <% } %>
        </div>
        <button type="button" onclick="var f=document.getElementById('rep-broker-sync');if(f)f.style.display=f.style.display==='none'?'block':'none';" class="btn-outline" style="font-size:0.78rem;padding:10px 18px;color:#F4F8FB;border-color:rgba(245,197,24,0.45);">
          Link Read-Only Investor Password / Sync Broker
        </button>
      </div>

      <div id="rep-broker-sync" style="display:none;margin-top:16px;padding:20px;border-radius:14px;background:rgba(10,10,10,0.88);border:1px solid rgba(245,197,24,0.45);">
        <form action="/dashboard/sessions/import-broker" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="returnTo" value="/za/reputation/<%= profileUser._id %>#traders-card">

          <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:#F5C518;margin-bottom:6px;font-weight:700;">
            OPTION 1: ONE-TIME READ-ONLY BROKER API KEY
          </div>
          <p style="font-size:0.78rem;color:#A3B1BF;margin:0 0 12px;line-height:1.6;">
            Paste your <strong>Read-Only Broker API Key</strong> once. KAIZEN never stores your master password or bank details — whenever you log a new <code>LIVE</code> session, KAIZEN automatically skims your read-only API link and verifies the trade:
          </p>
          <div style="margin-bottom:16px;">
            <label class="k-fieldlabel" style="color:#F5C518;">READ-ONLY BROKER API KEY</label>
            <input type="password" name="investorPassword" class="k-input" placeholder="Paste your Read-Only Broker API Key here">
          </div>

          <div style="border-top:1px solid rgba(244,248,251,0.12);padding-top:14px;margin-bottom:14px;">
            <div style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:#A3B1BF;margin-bottom:6px;font-weight:700;">
              OPTION 2: PROP FIRMS WITHOUT INVESTOR PASSWORD · UPLOAD STATEMENT (.HTML / .CSV) OR OFFICIAL MT5 EXECUTION LOG
            </div>
            <p style="font-size:0.75rem;color:#A3B1BF;margin:0 0 10px;line-height:1.55;">
              If your prop firm does not issue an Investor Password, upload an exported Trade History report (<strong>.html</strong> / <strong>.csv</strong>) or paste an official <strong>MT5 Journal execution log line</strong> (must include the broker timestamp and deal/order ticket <code>#...</code> or execution price <code>at ...</code>; plain typed text is rejected to prevent forgery):
            </p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="k-fieldlabel" style="color:#C4D0DC;">UPLOAD BROKER REPORT (.HTML / .CSV)</label>
                <input type="file" name="brokerFile" accept=".html,.htm,.csv,.txt" class="k-input">
              </div>
              <div>
                <label class="k-fieldlabel" style="color:#C4D0DC;">OR PASTE OFFICIAL MT5 JOURNAL EXECUTION LOG</label>
                <input type="text" name="brokerText" class="k-input" placeholder="e.g. 2026.11.04 09:15:22 Trades '50192837': instant sell 0.10 AUDJPY at 101.420">
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary" style="font-size:0.82rem;padding:11px 22px;">Connect Read-Only Link &amp; Verify Trades</button>
        </form>
      </div>
      </div>
    </section>

    <script>
      function toggleDossierRedact(kind, redact) {
        var els = document.querySelectorAll('[data-redactable="' + kind + '"]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (!el.getAttribute('data-orig')) el.setAttribute('data-orig', el.textContent);
          el.textContent = redact ? '[REDACTED BY TRADER]' : el.getAttribute('data-orig');
        }
      }
      function updatePdfDownloadHref() {
        var link = document.getElementById('dossier-pdf-link');
        if (!link) return;
        var base = '/za/reputation/<%= profileUser._id %>/dossier.pdf';
        var params = [];
        var p = document.getElementById('chk-redact-pairs');
        var d = document.getElementById('chk-redact-dates');
        var pnlChk = document.getElementById('chk-redact-pnl');
        var q = document.getElementById('chk-hide-quotes');
        if (p && p.checked) params.push('redactPairs=1');
        if (d && d.checked) params.push('redactDates=1');
        if (pnlChk && pnlChk.checked) params.push('redactPnl=1');
        if (q && q.checked) params.push('hideQuotes=1');
        link.href = base + (params.length ? ('?' + params.join('&')) : '');
      }
    </script>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Reputation</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Your Reputation</h1>
        <p class="page-sub">Kaizen Discipline Score + DUAL on-chain reputation</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

         <div class="rep-grid">

      <!-- KAIZEN SCORE -->
      <div class="card card-gold">
        <div class="card-header">
          <h2>Kaizen Discipline Score</h2>
          <span class="card-badge">In-App</span>
        </div>
        <div class="rep-score-big">
          <%= user.disciplineScore || 0 %>
          <span>/100</span>
        </div>
        <div class="score-bar">
          <div class="score-fill"
            style="width:<%= user.disciplineScore || 0 %>%"></div>
        </div>
        <div class="rep-tier" style="margin-top:16px;">
          <% if ((user.disciplineScore || 0) >= 80) { %>
            <span class="tier-badge tier-elite">Elite Trader</span>
          <% } else if ((user.disciplineScore || 0) >= 60) { %>
            <span class="tier-badge tier-consistent">Consistent</span>
          <% } else if ((user.disciplineScore || 0) >= 40) { %>
            <span class="tier-badge tier-building">Building</span>
          <% } else { %>
            <span class="tier-badge tier-developing">Developing</span>
          <% } %>
        </div>
        <p class="rep-desc">
          Your discipline score is calculated from rule compliance,
          session consistency, and emotional control across all
          logged trading sessions.
        </p>

        <!-- DELETE ACCOUNT -->
        <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--border);">
          <div style="font-family:var(--font-mono);font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--red);margin-bottom:10px;">
            Danger Zone
          </div>
          <button onclick="openModal('deleteModal')" class="btn-outline btn-full"
            style="border-color:rgba(248,113,113,0.3);color:var(--red);font-size:0.82rem;">
            Delete Account
          </button>
        </div>
      </div>

      <!-- ZA REPUTATION -->
      <div class="card card-blue">
        <div class="card-header">
          <h2>Zero Authority Reputation</h2>
          <span class="card-badge">On-Chain</span>
        </div>

        <% if (reputation && reputation.activityScore !== undefined) { %>
  <div style="text-align:center;padding:10px 0 20px;">

    <div style="
      font-family:'DM Mono',monospace;
      font-size:2.5rem;
      font-weight:700;
      color:var(--blue);
      line-height:1;
      margin-bottom:6px;
    "><%= reputation.activityScore || 0 %></div>

    <div style="
      font-family:'DM Mono',monospace;
      font-size:0.6rem;
      letter-spacing:0.15em;
      text-transform:uppercase;
      color:var(--ash);
      margin-bottom:20px;
    ">Activity Score</div>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(110px,1fr));
      gap:2px;
      margin-bottom:20px;
    ">
      <div style="background:var(--bg-surface);border:1px solid var(--border);padding:12px 8px;text-align:center;">
        <div style="font-family:'DM Mono',monospace;font-size:1.2rem;font-weight:700;color:var(--gold);">
          <%= reputation._count?.wonBounties || 0 %>
        </div>
        <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);margin-top:4px;">
          Bounties Won
        </div>
      </div>
      <div style="background:var(--bg-surface);border:1px solid var(--border);padding:12px 8px;text-align:center;">
        <div style="font-family:'DM Mono',monospace;font-size:1.2rem;font-weight:700;color:var(--gold);">
          <%= reputation._count?.receivedEndorsements || 0 %>
        </div>
        <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);margin-top:4px;">
          Endorsements
        </div>
      </div>
      <div style="background:var(--bg-surface);border:1px solid var(--border);padding:12px 8px;text-align:center;">
        <div style="font-family:'DM Mono',monospace;font-size:1.2rem;font-weight:700;color:var(--gold);">
          <%= reputation._count?.bountySubmissions || 0 %>
        </div>
        <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);margin-top:4px;">
          Submissions
        </div>
      </div>
      <div style="background:var(--bg-surface);border:1px solid var(--border);padding:12px 8px;text-align:center;">
        <div style="font-family:'DM Mono',monospace;font-size:1.2rem;font-weight:700;color:var(--gold);">
          <%= reputation.profileCompleteness || 0 %>%
        </div>
        <div style="font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);margin-top:4px;">
          Profile Complete
        </div>
      </div>
    </div>

    <a href="https://zeroauthoritydao.com/profile/<%= user.zaUserId %>"
      target="_blank"
      class="btn-outline"
      style="display:inline-flex;align-items:center;gap:8px;">
      <span>View ZA Profile</span>
      <span style="font-size:0.7rem;">↗</span>
    </a>

  </div>

<% } else { %>
  <div style="text-align:center;padding:20px 0;">
    <p style="font-size:0.85rem;color:var(--ash);line-height:1.75;max-width:420px;margin:0 auto 20px;">
      Connect your Zero Authority DAO account to display your
      on-chain reputation here alongside your Kaizen score.
    </p>
    <a href="https://zeroauthoritydao.com" target="_blank"
      class="btn-primary">
      Visit Zero Authority
    </a>
  </div>
<% } %>

      </div>
    </div>

<!-- MANTLE AI BENCHMARK -->
<div class="card" style="margin-top:2px;">
  <div class="card-header">
    <h2>Mantle AI Benchmark</h2>
    <span class="card-badge">ON-CHAIN</span>
  </div>

  <div style="text-align:center;padding:20px 0;">
    <p style="
      font-size:0.88rem;
      color:var(--text-secondary);
      line-height:1.85;
      max-width:480px;
      margin:0 auto 24px;
    ">
      Every Kaizen AI decision about your account — discipline
      score changes, behavioral pattern detections, and milestone
      achievements — is permanently recorded on the Mantle
      blockchain. This is a verifiable, tamper-proof record of
      how KAIZEN AI has guided your progress.
    </p>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
      gap:2px;
      margin-bottom:24px;
    ">
      <div style="
        background:var(--bg-surface);
        border:1px solid var(--border);
        padding:16px;
      ">
        <div style="
          font-family:'DM Mono',monospace;
          font-size:1.4rem;
          font-weight:700;
          color:var(--gold);
        "><%= disciplineScore %>%</div>
        <div style="
          font-family:'DM Mono',monospace;
          font-size:0.55rem;
          letter-spacing:0.1em;
          text-transform:uppercase;
          color:var(--ash);
          margin-top:4px;
        ">Current Score</div>
      </div>

      <div style="
        background:var(--bg-surface);
        border:1px solid var(--border);
        padding:16px;
      ">
        <div style="
          font-family:'DM Mono',monospace;
          font-size:1.4rem;
          font-weight:700;
          color:var(--blue);
        "><%= totalSessions || 0 %></div>
        <div style="
          font-family:'DM Mono',monospace;
          font-size:0.55rem;
          letter-spacing:0.1em;
          text-transform:uppercase;
          color:var(--ash);
          margin-top:4px;
        ">On-Chain Events</div>
      </div>

      <div style="
        background:var(--bg-surface);
        border:1px solid var(--border);
        padding:16px;
      ">
        <div style="
          font-family:'DM Mono',monospace;
          font-size:1.4rem;
          font-weight:700;
          color:var(--green);
        "><%= streak || 0 %></div>
        <div style="
          font-family:'DM Mono',monospace;
          font-size:0.55rem;
          letter-spacing:0.1em;
          text-transform:uppercase;
          color:var(--ash);
          margin-top:4px;
        ">Day Streak</div>
      </div>
    </div>

    <a href="https://explorer.sepolia.mantle.xyz/address/<%= process.env.MANTLE_CONTRACT_ADDRESS || '' %>"
      target="_blank"
      class="btn-outline"
      style="display:inline-flex;align-items:center;gap:8px;">
      <span>View on Mantle Explorer</span>
      <span style="font-size:0.7rem;">↗</span>
    </a>

    <p style="
      font-family:'DM Mono',monospace;
      font-size:0.6rem;
      letter-spacing:0.08em;
      color:rgba(201,168,76,0.4);
      margin-top:16px;
      text-transform:uppercase;
    ">
      Powered by KaizenBenchmark.sol · Mantle Sepolia Testnet
    </p>
  </div>
</div>

  </main>

  <!-- DELETE ACCOUNT MODAL -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Delete Account</h3>
        <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
      </div>
      <div class="modal-body">
        <p style="font-size:0.9rem;color:var(--text-secondary);line-height:1.7;margin-bottom:16px;">
          This action is permanent and cannot be undone. All your journal entries,
          discipline scores, and account data will be deleted immediately.
        </p>
        <div style="background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.2);padding:14px;margin-bottom:20px;">
          <p style="font-size:0.82rem;color:var(--red);">
            Deleting your account will permanently remove all your data from our servers.
          </p>
        </div>
        <form action="/auth/delete-account" method="POST">
          <button type="submit" class="btn-primary btn-full"
            style="background:var(--red);color:var(--white);">
            Yes, Delete My Account Permanently
          </button>
        </form>
      </div>
      <div class="modal-footer">
        <button onclick="closeModal('deleteModal')" class="btn-outline">
          Cancel — Keep My Account
        </button>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

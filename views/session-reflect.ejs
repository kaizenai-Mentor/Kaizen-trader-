<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.reflection') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow">

    <div class="k-stepstrip">
      <span class="is-done"><%= t('plan.title') %> ✓</span><b>—</b>
      <span class="is-done"><%= t('record.title') %> ✓</span><b>—</b>
      <span class="is-active"><%= t('reflect.title') %></span>
    </div>

    <div class="k-eyebrow" style="margin-bottom:10px;"><%= t('reflect.title') %></div>
    <h1 style="font-size:clamp(1.5rem,3.5vw,2.1rem);font-weight:700;color:var(--text-primary);line-height:1.15;margin:0 0 8px;"><%= t('reflect.lesson') %></h1>
    <p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.75;margin:0 0 24px;"><%= t('reflect.four') %></p>

    <div class="k-card" style="margin-bottom:18px;">
      <div class="k-metric-label" style="margin-bottom:8px;"><%= t('nav.sessions') %> — <%= session.asset %><% if (session.plan && session.plan.setup && session.plan.setup !== session.asset) { %> · <%= session.plan.setup %><% } %></div>
      <div style="font-size:0.84rem;color:var(--text-secondary);line-height:1.75;max-height:110px;overflow:hidden;position:relative;">
        <%= session.notes %>
        <div style="position:absolute;bottom:0;left:0;right:0;height:44px;background:linear-gradient(transparent,var(--bg-card));"></div>
      </div>
    </div>

    <form action="/dashboard/sessions/<%= session._id %>/reflect" method="POST">
      <p class="k-voice-privacy">Your browser may send audio to its speech service. Review the text before saving.</p>

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel"><%= t('reflect.learned') %></label>
        <textarea id="reflect-learned" name="learned" class="k-input" rows="3" placeholder="<%= t('reflect.ph3') %>"></textarea>
        <div class="k-voice-row"><%- include('partials/voice-button', { target: 'reflect-learned', status: 'learned-voice-status' }) %></div>
        <p class="k-voice-status" id="learned-voice-status" role="status" aria-live="polite"></p>
      </div>

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel"><%= t('reflect.wouldChange') %></label>
        <textarea id="reflect-change" name="wouldChange" class="k-input" rows="3" placeholder="<%= t('reflect.ph4') %>"></textarea>
        <div class="k-voice-row"><%- include('partials/voice-button', { target: 'reflect-change', status: 'change-voice-status' }) %></div>
        <p class="k-voice-status" id="change-voice-status" role="status" aria-live="polite"></p>
      </div>

      <div class="k-actions">
        <button type="submit" class="btn-primary k-btn-lg" id="k-finish"><%= t('reflect.submit') %></button>
      </div>
      <p style="font-size:0.72rem;color:var(--ash);line-height:1.7;margin:14px 0 0;"><%= t('reflect.onFinish') %></p>
    </form>

    <!-- KAIZEN's response — revealed in place (streamed, Psychology-style) -->
    <section class="k-card k-card--featured k-ai-card" id="k-response" hidden style="margin-top:20px;width:100%;box-sizing:border-box;">
      <div class="k-ai-cardhead">
        <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span><%= t('kaizen.responds') %></div>
        <span style="font-family:var(--font-mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);"><%= session.asset %><% if (session.plan && session.plan.setup && session.plan.setup !== session.asset) { %> · <%= session.plan.setup %><% } %></span>
      </div>
      <div class="k-typing" id="k-responding" hidden>
        <span class="k-kanji k-kanji--sm">改</span>
        <div class="k-msg-text k-typingdots"><span></span><span></span><span></span></div>
      </div>
      <p id="k-review-status" role="status" aria-live="polite" style="font-size:0.82rem;color:var(--ash);"></p>
      <div id="k-analysis" class="k-review-stack" style="font-size:0.9rem;color:var(--text-primary);line-height:1.85;white-space:pre-wrap;width:100%;"></div>
      <div id="k-after" hidden style="margin-top:20px;">
        <a class="btn-primary k-btn-lg" href="/dashboard/sessions/<%= session._id %>"><%= t('reflect.openAnalyzed') %></a>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/voice-input.js?v=3"></script>
  <script src="/js/app.js?v=8"></script>
  <script src="/js/session-review-reveal.js?v=1"></script>
  <script>
    if (window.feather) feather.replace();
    (function () {
      var form = document.querySelector('form[action*="/reflect"]');
      if (!form || !window.fetch) return; // no-JS: normal POST + redirect
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('k-finish');
        var panel = document.getElementById('k-response');
        var typingEl = document.getElementById('k-responding');
        var out = document.getElementById('k-analysis');
        var after = document.getElementById('k-after');
        btn.disabled = true; btn.textContent = <%- JSON.stringify(t('reflect.analyzing')) %>;
        panel.hidden = false; typingEl.hidden = false;
        try { panel.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (err) {}
        var data = new URLSearchParams(new FormData(form));

        function handleJson(res) {
          typingEl.hidden = true;
          if (!res || res.error) {
            out.textContent = (res && res.error) || 'Something went wrong — try again.';
            after.hidden = false; btn.disabled = false; btn.textContent = <%- JSON.stringify(t('reflect.finish')) %>;
            return;
          }
          var text = res.analysis || '';
          var reduced = window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced) { out.textContent = text; after.hidden = false; return; }
          var i = 0;
          (function type() {
            i += 3;
            out.textContent = text.slice(0, i);
            if (i < text.length) { setTimeout(type, 12); return; }
            out.textContent = text;
            after.hidden = false;
          })();
        }

        // The next provider starts as soon as a reset arrives. Its text is
        // queued locally while the failed response is erased.
        if (window.kaizenStream && window.createSessionReviewReveal) {
          var payload = {};
          data.forEach(function (v, k) { payload[k] = v; });
          payload.stream = '1';
          var reveal = window.createSessionReviewReveal({
            output: out,
            status: document.getElementById('k-review-status'),
            typing: typingEl,
            reducedMotion: window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches,
            onDone: function () {
              after.hidden = false;
              btn.textContent = <%- JSON.stringify(t('reflect.done')) %>;
            }
          });
          function interrupted() {
            reveal.reset(false);
            reveal.delta('Connection interrupted. Open the session to check whether your review was saved.');
            reveal.done();
          }
          window.kaizenStream(form.action, payload, {
            onDelta: reveal.delta,
            onReset: function (event) { reveal.reset(event.retrying); },
            onDone: reveal.done,
            onError: interrupted,
            onJson: handleJson
          }).catch(interrupted);
          return;
        }

        data.append('json', '1');
        fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        })
          .then(function (r) { return r.json(); })
          .then(handleJson)
          .catch(function () { form.submit(); }); // network issue: plain POST
      });
    })();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — The Reflection</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow">

    <div class="k-stepstrip">
      <span class="is-done">Plan ✓</span><b>—</b>
      <span class="is-done">Record ✓</span><b>—</b>
      <span class="is-active">Reflect</span>
    </div>

    <div class="k-eyebrow" style="margin-bottom:10px;">The Reflection</div>
    <h1 style="font-size:clamp(1.5rem,3.5vw,2.1rem);font-weight:700;color:var(--text-primary);line-height:1.15;margin:0 0 8px;">
      A session becomes a lesson here.
    </h1>
    <p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.75;margin:0 0 24px;">
      Four short answers. Yours, not KAIZEN's — the AI responds after you finish.
    </p>

    <div class="k-card" style="margin-bottom:18px;">
      <div class="k-metric-label" style="margin-bottom:8px;">YOUR SESSION — <%= session.asset %></div>
      <div style="font-size:0.84rem;color:var(--text-secondary);line-height:1.75;max-height:110px;overflow:hidden;position:relative;">
        <%= session.notes %>
        <div style="position:absolute;bottom:0;left:0;right:0;height:44px;background:linear-gradient(transparent,var(--bg-card));"></div>
      </div>
    </div>

    <form action="/dashboard/sessions/<%= session._id %>/reflect" method="POST">

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel">WHAT ACTUALLY HAPPENED?</label>
        <textarea name="whatHappened" class="k-input" rows="3" placeholder="In your own words..."></textarea>
      </div>

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel">DID YOU FOLLOW YOUR PROCESS?</label>
        <textarea name="followedProcess" class="k-input" rows="3" placeholder="Honest answer — this is where improvement starts..."></textarea>
      </div>

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel">WHAT DID YOU LEARN?</label>
        <textarea name="learned" class="k-input" rows="3" placeholder="The same mistake, seen twice, becomes a decision..."></textarea>
      </div>

      <div class="k-card k-formcard k-prompt">
        <label class="k-fieldlabel">WHAT WOULD YOU CHANGE?</label>
        <textarea name="wouldChange" class="k-input" rows="3" placeholder="One concrete thing..."></textarea>
      </div>

      <div class="k-actions">
        <button type="submit" class="btn-primary k-btn-lg" id="k-finish">Finish Session</button>
      </div>
      <p style="font-size:0.72rem;color:var(--ash);line-height:1.7;margin:14px 0 0;">
        On finish, the engine scores your session and 改 KAIZEN responds to your reflection.
      </p>
    </form>

    <!-- KAIZEN's response — revealed in place (streamed, Psychology-style) -->
    <div class="k-card k-card--featured" id="k-response" hidden style="margin-top:18px;">
      <div class="k-panel-title" style="margin-bottom:14px;"><span class="k-kanji k-kanji--sm">改</span> KAIZEN RESPONDS</div>
      <div class="k-typing" id="k-responding" hidden>
        <span class="k-kanji k-kanji--sm">改</span>
        <div class="k-msg-text k-typingdots"><span></span><span></span><span></span></div>
      </div>
      <div id="k-analysis" style="font-size:0.9rem;color:var(--text-primary);line-height:1.85;white-space:pre-wrap;"></div>
      <div id="k-after" hidden style="margin-top:18px;">
        <a class="btn-primary k-btn-lg" href="/dashboard/sessions/<%= session._id %>">Open the analyzed session</a>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    if (window.feather) feather.replace();
    (function () {
      var form = document.querySelector('form[action*="/reflect"]');
      if (!form || !window.fetch) return; // no-JS: normal POST + redirect
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('k-finish');
        var panel = document.getElementById('k-response');
        var typingEl = document.getElementById('k-responding');
        var out = document.getElementById('k-analysis');
        var after = document.getElementById('k-after');
        btn.disabled = true; btn.textContent = 'Analyzing…';
        panel.hidden = false; typingEl.hidden = false;
        try { panel.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (err) {}
        var data = new URLSearchParams(new FormData(form));
        data.append('json', '1');
        fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            typingEl.hidden = true;
            if (!res || res.error) {
              out.textContent = (res && res.error) || 'Something went wrong — try again.';
              after.hidden = false; btn.disabled = false; btn.textContent = 'Finish Session';
              return;
            }
            var text = res.analysis || '';
            var reduced = window.matchMedia &&
              window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduced) { out.textContent = text; after.hidden = false; return; }
            var i = 0;
            (function type() {
              i += 3;
              out.textContent = text.slice(0, i);
              if (i < text.length) { setTimeout(type, 12); return; }
              out.textContent = text;
              after.hidden = false;
            })();
          })
          .catch(function () { form.submit(); }); // network issue: plain POST
      });
    })();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Leaderboard</title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>
  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Leaderboard</h1>
        <p class="page-sub">Ranked by discipline — not profit.</p>
      </div>
    </div>

    <!-- TABS -->
    <div style="display:flex;gap:2px;margin-bottom:20px;">
      <button onclick="showTab('weekly')" id="tab-weekly" style="
        flex:1;padding:12px;
        font-family:'DM Mono',monospace;
        font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;
        background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.3);
        color:var(--gold);cursor:pointer;transition:all 0.2s;
      ">This Week</button>
      <button onclick="showTab('alltime')" id="tab-alltime" style="
        flex:1;padding:12px;
        font-family:'DM Mono',monospace;
        font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;
        background:var(--bg-card);border:1px solid var(--border);
        color:var(--ash);cursor:pointer;transition:all 0.2s;
      ">All Time</button>
    </div>

    <!-- WEEKLY TAB -->
    <div id="panel-weekly">
      <% if (weeklyLeaders.length === 0) { %>
        <div class="card">
          <div class="empty-state">
            <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">
              No sessions logged this week yet.
            </p>
            <p>Be the first on this week's board.</p>
            <a href="/dashboard/journal" class="btn-primary"
              style="margin-top:20px;display:inline-block;">
              Log a Session
            </a>
          </div>
        </div>
      <% } else { %>
        <%- include('partials/leaderboard-list', {
          leaders: weeklyLeaders,
          scoreKey: 'weekScore',
          currentUser: user,
          showSessions: true
        }) %>
      <% } %>
    </div>

    <!-- ALL TIME TAB -->
    <div id="panel-alltime" style="display:none;">
      <%- include('partials/leaderboard-list', {
        leaders: allTimeLeaders,
        scoreKey: 'disciplineScore',
        currentUser: user,
        showSessions: false
      }) %>
    </div>

  </main>
  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    function showTab(tab) {
      document.getElementById('panel-weekly').style.display =
        tab === 'weekly' ? 'block' : 'none';
      document.getElementById('panel-alltime').style.display =
        tab === 'alltime' ? 'block' : 'none';

      document.getElementById('tab-weekly').style.background =
        tab === 'weekly' ? 'rgba(201,168,76,0.1)' : 'var(--bg-card)';
      document.getElementById('tab-weekly').style.borderColor =
        tab === 'weekly' ? 'rgba(201,168,76,0.3)' : 'var(--border)';
      document.getElementById('tab-weekly').style.color =
        tab === 'weekly' ? 'var(--gold)' : 'var(--ash)';

      document.getElementById('tab-alltime').style.background =
        tab === 'alltime' ? 'rgba(201,168,76,0.1)' : 'var(--bg-card)';
      document.getElementById('tab-alltime').style.borderColor =
        tab === 'alltime' ? 'rgba(201,168,76,0.3)' : 'var(--border)';
      document.getElementById('tab-alltime').style.color =
        tab === 'alltime' ? 'var(--gold)' : 'var(--ash)';
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.progress') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-flow k-flow--wide">

    <div class="k-cockpit-head">
      <div>
        <div class="k-eyebrow"><%= t('prog.eyebrow') %></div>
        <h1 class="k-page-title"><%= t('dash.myProgress') %></h1>
        <p class="k-page-sub"><%= t('prog.sub') %></p>
      </div>
      <div class="k-streakchip" title="Practice consistency, never trading performance">
        <span class="k-streak-flame">◆</span>
        <span class="k-streak-num"><%= streak %></span>
        <span class="k-streak-label"><%= t('dash.dayStreak') %></span>
      </div>
    </div>

    <%
      var dimOrder = ['process','risk','execution','behavior','learning'];
      var weightsMap = (typeof dimensionWeights !== 'undefined' && dimensionWeights) || { process: 25, risk: 25, execution: 20, behavior: 15, learning: 15 };
      var dimData = {};
      dimOrder.forEach(function(k) {
        if (typeof dimensionsSummary !== 'undefined' && dimensionsSummary && dimensionsSummary[k]) {
          dimData[k] = dimensionsSummary[k];
        } else if (move && move.dimensions && move.dimensions[k]) {
          var md = move.dimensions[k];
          dimData[k] = {
            now: md.now,
            delta: md.delta,
            weight: weightsMap[k],
            contribution: md.now != null ? Math.round((md.now * weightsMap[k]) / 100) : null
          };
        } else {
          dimData[k] = { now: null, delta: null, weight: weightsMap[k], contribution: null };
        }
      });
      var overallScoreVal = (typeof calculatedKaizenScore !== 'undefined' && calculatedKaizenScore != null)
        ? calculatedKaizenScore
        : (move && move.overall && move.overall.now != null ? move.overall.now : null);
      var plotPts = (typeof chartPoints !== 'undefined' && chartPoints && chartPoints.length)
        ? chartPoints
        : (points || []);
    %>

    <!-- ═══ CARD 1: FIVE-DIMENSION SCORING CARD ═══ -->
    <section class="k-card">
      <div class="k-panel-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <span><%= t('prog.dimMove') %></span>
        <span style="font-family:var(--font-mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-secondary);">All 5 Dimensions Explained · Feeds Overall KAIZEN Score</span>
      </div>
      <div class="k-dimrows">
        <%
          var fallbackBriefs = {
            process: 'Measures how consistently you declare a pre-session plan and follow your written trading system.',
            risk: 'Measures whether you respect your predefined risk per trade and stay within your daily trade limit.',
            execution: 'Measures whether your actual entries match the entry criteria and checklist you locked in beforehand.',
            behavior: 'Measures emotional composure before and during sessions, especially in the window right after a loss.',
            learning: 'Measures reflection depth, consistency across sessions, and how quickly you correct a breakdown.'
          };
        %>
        <% dimOrder.forEach(function(k){ %>
          <% var d = dimData[k]; %>
          <div style="padding:12px 0;border-bottom:1px solid var(--border);">
            <div class="k-dimrow" style="grid-template-columns:1.2fr 1fr auto auto;gap:14px;align-items:center;border-bottom:none;padding:0;">
              <span class="k-dimlabel" style="display:flex;align-items:center;gap:8px;">
                <span><%= dimensionLabels[k] %></span>
                <span style="font-family:var(--font-mono);font-size:0.55rem;color:#F4F8FB;background:#1A2F4A;padding:2px 6px;border-radius:6px;"><%= d.weight %>%</span>
              </span>
              <span class="k-meter-track" style="height:8px;border-radius:99px;background:#DCE6EE;overflow:hidden;display:block;">
                <span style="display:block;height:100%;width:<%= d.now != null ? d.now : 0 %>%;background:<%= d.now != null ? 'var(--gold)' : 'transparent' %>;border-radius:99px;transition:width 0.6s ease;"></span>
              </span>
              <span class="k-dimval" style="color:var(--gold);font-weight:700;"><%= d.now != null ? d.now + '%' : '—' %></span>
              <% if (d.delta == null) { %>
                <span class="k-dimdelta is-flat"><%= t('prog.building') %></span>
              <% } else if (d.delta > 0) { %>
                <span class="k-dimdelta is-up">▲ +<%= d.delta %></span>
              <% } else if (d.delta < 0) { %>
                <span class="k-dimdelta is-down">▼ <%= d.delta %></span>
              <% } else { %>
                <span class="k-dimdelta is-flat">± 0</span>
              <% } %>
            </div>
            <div style="margin-top:6px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:0.78rem;color:var(--text-secondary);line-height:1.55;">
              <span><%= d.reason || fallbackBriefs[k] %></span>
              <% if (d.progressNote) { %>
                <span style="font-family:var(--font-mono);font-size:0.66rem;color:var(--gold);"><%= d.progressNote %></span>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- ═══ CARD 2 (BELOW 5-DIMENSION SCORING): CHART-LIKE KAIZEN SCORE PROGRESS PANEL ═══ -->
    <section class="k-card k-card--elevated k-progress-chart-panel" id="kaizenProgressChartPanel">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
        <div class="k-panel-title" style="margin-bottom:0;">
          <span class="k-kanji k-kanji--sm">改</span> <%= t('prog.scoreTimeline') %> <span class="k-gold"><%= t('dash.score') %></span>
        </div>
        <div class="k-chart-tabs" role="tablist" style="display:inline-flex;gap:6px;background:#E8EFF5;padding:4px;border-radius:99px;border:1px solid #DCE6EE;">
          <button type="button" class="k-chart-tab is-active" data-chart-view="trajectory" role="tab" aria-selected="true" style="border:0;background:#1A2F4A;color:#F4F8FB;font-family:var(--font-heading);font-size:0.72rem;font-weight:600;padding:6px 14px;border-radius:99px;cursor:pointer;transition:all 0.2s;">Overall Progress Chart</button>
          <button type="button" class="k-chart-tab" data-chart-view="dimensions" role="tab" aria-selected="false" style="border:0;background:transparent;color:#41566B;font-family:var(--font-heading);font-size:0.72rem;font-weight:600;padding:6px 14px;border-radius:99px;cursor:pointer;transition:all 0.2s;">5 Dimension Breakdown</button>
        </div>
      </div>

      <% if (move || overallScoreVal !== null) { %>
        <div class="k-scorerow" style="margin-bottom:16px;">
          <span class="k-scorenum"><%= move ? move.overall.now : overallScoreVal %></span>
          <div class="k-scoremeta">
            <% if (move) { %>
              <% if (move.overall.same) { %>
                <span class="k-deltachip is-flat"><%= t('prog.firstReading') %></span>
              <% } else if (move.overall.delta > 0) { %>
                <span class="k-deltachip is-up">▲ +<%= move.overall.delta %> <%= t('prog.in30') %></span>
              <% } else if (move.overall.delta < 0) { %>
                <span class="k-deltachip is-down">▼ <%= move.overall.delta %> <%= t('prog.in30') %></span>
              <% } else { %>
                <span class="k-deltachip is-flat"><%= t('prog.flat30') %></span>
              <% } %>
            <% } else { %>
              <span class="k-deltachip is-flat">Composite 5 Dimension Calculation</span>
            <% } %>
            <span class="k-scoresub">Calculated from your 5 scoring dimensions · <%= points.length %> <%= t('prog.computed') %><%= points.length === 1 ? '' : 's' %> <%= t('prog.onRecord') %> <a class="k-link" href="/about#kaizen-score"><%= t('dash.howScored') %></a></span>
          </div>
        </div>
      <% } else { %>
        <div class="k-building" style="margin-bottom:16px;">
          <span class="k-buildnum">改</span>
          <div>
            <div class="k-buildtitle"><%= t('prog.timelineStarts') %></div>
            <p class="k-buildtext"><%= t('prog.noScores') %></p>
          </div>
        </div>
      <% } %>

      <!-- TAB VIEW 1: OVERALL PROGRESS TRAJECTORY CHART -->
      <div class="k-chart-pane" id="chartPaneTrajectory">
        <div style="background:#0A0A0A;border:1px solid #232B33;border-radius:14px;padding:18px 20px 14px;color:#F4F8FB;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:#A3B1BF;">
            <span>KAIZEN SCORE CURVE (0 TO 100 SCALE)</span>
            <span style="color:#F5C518;">CURRENT KAIZEN SCORE: <strong><%= overallScoreVal != null ? overallScoreVal : 'BUILDING' %></strong></span>
          </div>

          <%
            var cW = 600, cH = 190;
            var padLeft = 38, padRight = 18, padTop = 24, padBot = 22;
            var plotW = cW - padLeft - padRight;
            var plotH = cH - padTop - padBot;
            var series = plotPts && plotPts.length >= 2
              ? plotPts
              : (overallScoreVal != null
                ? [
                    { t: new Date(Date.now() - 14 * 86400000), v: Math.max(30, overallScoreVal - 5) },
                    { t: new Date(Date.now() - 10 * 86400000), v: Math.max(30, overallScoreVal - 2) },
                    { t: new Date(Date.now() - 6 * 86400000), v: Math.max(30, overallScoreVal - 4) },
                    { t: new Date(Date.now() - 3 * 86400000), v: Math.max(30, overallScoreVal - 1) },
                    { t: new Date(), v: overallScoreVal }
                  ]
                : [
                    { t: new Date(Date.now() - 10 * 86400000), v: 46 },
                    { t: new Date(Date.now() - 7 * 86400000), v: 50 },
                    { t: new Date(Date.now() - 4 * 86400000), v: 48 },
                    { t: new Date(), v: 52 }
                  ]);
            var vals = series.map(function(p){ return Number(p.v) || 50; });
            var rawMin = Math.min.apply(null, vals);
            var rawMax = Math.max.apply(null, vals);
            var yMin = Math.max(0, Math.floor(rawMin - 4));
            var yMax = Math.min(100, Math.ceil(rawMax + 4));
            if (yMax - yMin < 8) {
              yMin = Math.max(0, yMin - 4);
              yMax = Math.min(100, yMax + 4);
            }
            var yMid = Math.round((yMin + yMax) / 2);
            var polyCoords = series.map(function(p, idx) {
              var x = padLeft + (idx / Math.max(1, series.length - 1)) * plotW;
              var ratio = (Math.max(yMin, Math.min(yMax, p.v)) - yMin) / Math.max(1, yMax - yMin);
              var y = padTop + plotH - ratio * plotH;
              return { x: Number(x.toFixed(1)), y: Number(y.toFixed(1)), v: p.v, t: p.t };
            });
            var polyStr = polyCoords.map(function(pt){ return pt.x + ',' + pt.y; }).join(' ');
            var firstNode = polyCoords[0];
            var lastNode = polyCoords[polyCoords.length - 1];
            var areaStr = firstNode.x + ',' + (padTop + plotH) + ' ' + polyStr + ' ' + lastNode.x + ',' + (padTop + plotH);
          %>
          <svg class="k-spark" viewBox="0 0 600 190" preserveAspectRatio="none" style="height:190px;width:100%;display:block;" role="img" aria-label="<%= t('prog.timelineAria') %>">
            <defs>
              <linearGradient id="kaizenChartFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F5C518" stop-opacity="0.38" />
                <stop offset="100%" stop-color="#1A2F4A" stop-opacity="0.03" />
              </linearGradient>
            </defs>
            <!-- Auto-scaled Y-axis labels & gridlines -->
            <text x="4" y="<%= padTop + 4 %>" fill="#A3B1BF" font-family="DM Mono, monospace" font-size="10"><%= yMax %>%</text>
            <line x1="<%= padLeft %>" y1="<%= padTop %>" x2="<%= cW - padRight %>" y2="<%= padTop %>" stroke="rgba(244,248,251,0.10)" stroke-dasharray="3 3" />

            <text x="4" y="<%= padTop + (plotH / 2) + 4 %>" fill="#A3B1BF" font-family="DM Mono, monospace" font-size="10"><%= yMid %>%</text>
            <line x1="<%= padLeft %>" y1="<%= padTop + (plotH / 2) %>" x2="<%= cW - padRight %>" y2="<%= padTop + (plotH / 2) %>" stroke="rgba(244,248,251,0.14)" stroke-dasharray="3 3" />

            <text x="4" y="<%= padTop + plotH + 4 %>" fill="#A3B1BF" font-family="DM Mono, monospace" font-size="10"><%= yMin %>%</text>
            <line x1="<%= padLeft %>" y1="<%= padTop + plotH %>" x2="<%= cW - padRight %>" y2="<%= padTop + plotH %>" stroke="rgba(244,248,251,0.22)" />

            <polygon points="<%= areaStr %>" fill="url(#kaizenChartFill)" />
            <polyline fill="none" stroke="#F5C518" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" points="<%= polyStr %>"></polyline>
            <% polyCoords.forEach(function(pt, idx) { %>
              <circle cx="<%= pt.x %>" cy="<%= pt.y %>" r="<%= idx === polyCoords.length - 1 ? 5.5 : 4 %>" fill="<%= idx === polyCoords.length - 1 ? '#F5C518' : '#0A0A0A' %>" stroke="#F5C518" stroke-width="2.2"></circle>
              <% if (polyCoords.length <= 10 || idx === 0 || idx === polyCoords.length - 1 || idx % 2 === 0) { %>
                <text x="<%= pt.x %>" y="<%= Math.max(12, pt.y - 8) %>" text-anchor="middle" fill="<%= idx === polyCoords.length - 1 ? '#F5C518' : '#F4F8FB' %>" font-family="DM Mono, monospace" font-size="9.5" font-weight="700"><%= pt.v %>%</text>
              <% } %>
            <% }); %>
          </svg>

          <div class="k-spark-meta" style="margin-top:10px;color:#A3B1BF;">
            <span><%= series[0] && series[0].t ? new Date(series[0].t).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : 'Start' %></span>
            <span>5 Dimension Weighted Composite → KAIZEN Score</span>
            <span><%= lastNode && lastNode.t ? new Date(lastNode.t).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'Today' %></span>
          </div>
        </div>
        <% if (points.length < 2) { %>
          <div class="k-fieldhint" style="margin-top:8px;"><%= t('prog.oneReading') %></div>
        <% } %>
      </div>

      <!-- TAB VIEW 2: 5-DIMENSION BAR CHART & COMPOSITE FORMULA -->
      <div class="k-chart-pane" id="chartPaneDimensions" style="display:none;">
        <div style="background:#0A0A0A;border:1px solid #232B33;border-radius:14px;padding:20px;color:#F4F8FB;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:#A3B1BF;">
            <span>FIVE DIMENSION CONTRIBUTIONS TO KAIZEN SCORE</span>
            <span style="color:#F5C518;">WEIGHTED TOTAL: <strong><%= overallScoreVal != null ? overallScoreVal + ' / 100' : 'BUILDING' %></strong></span>
          </div>

          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:14px;align-items:end;height:150px;padding:12px 8px 0;border-bottom:1px solid rgba(244,248,251,0.14);">
            <% dimOrder.forEach(function(k) { %>
              <% var d = dimData[k]; var pct = d.now != null ? d.now : 18; %>
              <div style="display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;">
                <div style="font-family:var(--font-mono);font-size:0.72rem;font-weight:700;color:<%= d.now != null ? '#F5C518' : '#A3B1BF' %>;margin-bottom:6px;">
                  <%= d.now != null ? d.now : 'Build' %>
                </div>
                <div style="width:100%;max-width:48px;height:<%= Math.max(12, Math.round((pct / 100) * 105)) %>px;background:<%= d.now != null ? 'linear-gradient(180deg, #F5C518 0%, #1A2F4A 100%)' : 'rgba(244,248,251,0.12)' %>;border-radius:8px 8px 0 0;transition:height 0.4s ease;"></div>
              </div>
            <% }); %>
          </div>
          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:14px;padding-top:10px;text-align:center;">
            <% dimOrder.forEach(function(k) { %>
              <% var d = dimData[k]; %>
              <div>
                <div style="font-size:0.74rem;font-weight:600;color:#F4F8FB;line-height:1.25;"><%= dimensionLabels[k] %></div>
                <div style="font-family:var(--font-mono);font-size:0.56rem;color:#A3B1BF;margin-top:3px;">Weight <%= d.weight %>%<% if (d.contribution != null) { %> · +<%= d.contribution %> pts<% } %></div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- FIVE-DIMENSION CALCULATION SUMMARY STRIP -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:8px;margin-top:14px;">
        <% dimOrder.forEach(function(k){ %>
          <% var d = dimData[k]; %>
          <div style="background:#FFFFFF;border:1px solid #DCE6EE;border-radius:10px;padding:10px 12px;">
            <div style="font-family:var(--font-mono);font-size:0.54rem;letter-spacing:0.1em;text-transform:uppercase;color:#41566B;"><%= dimensionLabels[k] %> (<%= d.weight %>%)</div>
            <div style="display:flex;align-items:baseline;justify-content:space-between;margin-top:4px;">
              <strong style="font-family:var(--font-heading);font-size:1rem;color:#0A0A0A;"><%= d.now != null ? d.now : 'Building' %></strong>
              <span style="font-family:var(--font-mono);font-size:0.6rem;color:#1A2F4A;font-weight:600;"><%= d.contribution != null ? '+' + d.contribution + ' pts' : 'pending' %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <section class="k-card">
      <div class="k-panel-title"><%= t('prog.practiceVs') %></div>
      <p class="k-cardsub"><%= t('prog.practiceNote') %></p>
      <%
        var liveTp = (typePerf && typePerf.types && typePerf.types.LIVE) || { count: 0, rate: null };
        var sbTp = (typePerf && typePerf.types && typePerf.types.STUDY_BACKTEST)
          ? typePerf.types.STUDY_BACKTEST
          : {
              count: ((typePerf && typePerf.types && typePerf.types.BACKTEST && typePerf.types.BACKTEST.count) || 0) +
                     ((typePerf && typePerf.types && typePerf.types.STUDY && typePerf.types.STUDY.count) || 0),
              rate: (typePerf && typePerf.types && typePerf.types.BACKTEST && typePerf.types.BACKTEST.rate != null)
                ? typePerf.types.BACKTEST.rate
                : ((typePerf && typePerf.types && typePerf.types.STUDY && typePerf.types.STUDY.rate != null) ? typePerf.types.STUDY.rate : null)
            };
      %>
      <div class="k-typerow" style="grid-template-columns:repeat(2,1fr);">
        <div class="k-typecard-stat">
          <span class="k-type-tag k-type-live">LIVE</span>
          <span class="k-typecard-num"><%= liveTp.count %></span>
          <span class="k-typecard-cap"><%= t('word.session') %><%= liveTp.count === 1 ? '' : 's' %></span>
          <span class="k-typecard-rate"><%= liveTp.rate != null ? t('prog.insidePct', { p: liveTp.rate }) : t('prog.noData') %></span>
        </div>
        <div class="k-typecard-stat">
          <span class="k-type-tag k-type-study">STUDY / BACKTEST</span>
          <span class="k-typecard-num"><%= sbTp.count %></span>
          <span class="k-typecard-cap"><%= t('word.session') %><%= sbTp.count === 1 ? '' : 's' %></span>
          <span class="k-typecard-rate"><%= sbTp.rate != null ? t('prog.insidePct', { p: sbTp.rate }) : 'Chart study & historical testing' %></span>
        </div>
      </div>
      <% if (typePerf.insight) { %>
        <div class="k-insight">
          <span class="k-kanji k-kanji--sm">改</span>
          <p><%= typePerf.insight.message %></p>
        </div>
      <% } else if (liveTp.count + sbTp.count > 0) { %>
        <div class="k-fieldhint"><%= t('prog.notEnough') %></div>
      <% } else { %>
        <div class="k-fieldhint"><%= t('prog.noSessionsYet') %></div>
      <% } %>
    </section>

    <section class="k-card">
      <div class="k-panel-title" style="display:flex;align-items:center;justify-content:space-between;">
        <span><%= t('prog.milestones') %></span>
        <span class="k-milestone-meta"><%= totalSessions %> <%= t('word.session') %><%= totalSessions === 1 ? '' : 's' %> <%= t('word.total') %></span>
      </div>
      <div class="k-milestone-label"><%= nextMilestone.label %></div>
      <div class="k-milestone-track"><span class="k-milestone-fill" data-meter="<%= nextMilestone.progress %>"></span></div>
      <div class="k-milestone-meta"><% if (nextMilestone.remaining > 0) { %><%= nextMilestone.remaining %> <%= t('dash.toGo') %><% } else { %><%= t('dash.reached') %><% } %></div>
      <% if (badges.length) { %>
        <div class="k-badgegrid">
          <% badges.forEach(function(b){ %>
            <div class="k-badgecell">
              <span class="k-badgename"><%= labels.badge(b.name) %></span>
              <span class="k-badgedate"><%= b.earnedAt ? new Date(b.earnedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '' %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="k-fieldhint"><%= t('prog.noMilestones') %></div>
      <% } %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/v2-reveal.js"></script>
  <script src="/js/app.js"></script>
  <script>
    (function () {
      var tabs = document.querySelectorAll('[data-chart-view]');
      var paneTraj = document.getElementById('chartPaneTrajectory');
      var paneDims = document.getElementById('chartPaneDimensions');
      if (!tabs.length || !paneTraj || !paneDims) return;
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.getAttribute('data-chart-view');
          tabs.forEach(function (t) {
            var on = t === btn;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.style.background = on ? '#1A2F4A' : 'transparent';
            t.style.color = on ? '#F4F8FB' : '#41566B';
          });
          paneTraj.style.display = mode === 'trajectory' ? '' : 'none';
          paneDims.style.display = mode === 'dimensions' ? '' : 'none';
        });
      });
    })();
  </script>
</body>
</html>

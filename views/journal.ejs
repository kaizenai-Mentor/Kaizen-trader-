<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Journal</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1>Trading Journal</h1>
        <p class="page-sub">Log and review your trading sessions</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <!-- LOG NEW SESSION FORM -->
    <div class="card" style="margin-bottom:2px;">
      <div class="card-header">
        <h2>Log New Session</h2>
        <span class="card-badge">New Entry</span>
      </div>
      <form action="/dashboard/journal" method="POST" class="journal-form">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Asset</label>
            <input type="text" name="asset" class="form-input"
              placeholder="BTC/USDT" value="BTC/USDT">
          </div>
          <div class="form-group">
            <label class="form-label">Timeframe</label>
            <select name="timeframe" class="form-input">
              <option value="1m">1m</option>
              <option value="5m">5m</option>
              <option value="15m">15m</option>
              <option value="1H" selected>1H</option>
              <option value="4H">4H</option>
              <option value="1D">1D</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Direction</label>
            <select name="direction" class="form-input">
              <option value="Long">Long</option>
              <option value="Short">Short</option>
              <option value="No Trade">No Trade</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Outcome</label>
            <select name="outcome" class="form-input">
              <option value="Win">Win</option>
              <option value="Loss">Loss</option>
              <option value="Breakeven">Breakeven</option>
              <option value="Pending">Pending</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Emotion</label>
            <select name="emotion" class="form-input">
              <option value="Neutral">Neutral</option>
              <option value="Confident">Confident</option>
              <option value="Fear">Fear</option>
              <option value="Greed">Greed</option>
              <option value="Anxious">Anxious</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Session Score (0-100)</label>
            <input type="number" name="sessionScore"
              class="form-input" min="0" max="100" value="50">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Session Notes</label>
          <textarea name="notes" class="form-input form-textarea"
            placeholder="What did you observe? Did you follow your rules? What could you improve?"
            required></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Did you follow your rules?</label>
          <select name="ruleCompliance" class="form-input">
            <option value="true">Yes — Full Compliance</option>
            <option value="false">No — Rules Violated</option>
          </select>
        </div>
        <button type="submit" class="btn-primary btn-full">Log Session</button>
      </form>
    </div>

    <!-- PAST ENTRIES -->
    <div style="margin-top:32px;">
      <h2 style="font-size:1rem;font-weight:700;margin-bottom:16px;color:var(--text-primary);">
        Past Sessions
      </h2>

      <% if (typeof journals !== 'undefined' && journals.length === 0) { %>
        <div class="card">
          <div class="empty-state">
            <p>
                      No sessions yet. 
              <strong>The traders who journal consistently
               outperform those who don't. Start today.<strong>
            </p>
            <p>Use the form above to log your first session.</p>
          </div>
        </div>
      <% } else if (typeof journals !== 'undefined') { %>
        <div class="journal-grid">
          <% journals.forEach(function(journal) { %>
            <div class="journal-card">
              <div class="journal-card-top">
                <div>
                  <span class="journal-asset"><%= journal.asset %></span>
                  <span class="journal-tf"><%= journal.timeframe %></span>
                </div>
                <span class="journal-score-big <%= journal.ruleCompliance ? 'score-good' : 'score-bad' %>">
                  <%= journal.sessionScore %>/100
                </span>
              </div>
              <div class="journal-tags">
                <span class="journal-tag"><%= journal.direction %></span>
                <span class="journal-tag <%= journal.outcome === 'Win' ? 'tag-win' : journal.outcome === 'Loss' ? 'tag-loss' : '' %>">
                  <%= journal.outcome %>
                </span>
                <span class="journal-tag"><%= journal.emotion %></span>
              </div>
              <p class="journal-notes"><%= journal.notes %></p>
              <div class="journal-card-footer">
                <% if (journal.ruleCompliance) { %>
                  <span class="compliance-good">Compliant</span>
                <% } else { %>
                  <span class="compliance-bad">Violated</span>
                <% } %>
                <span class="journal-date">
                  <%= new Date(journal.createdAt).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'short', day: 'numeric'
                  }) %>
                </span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card">
          <div class="empty-state">
            <p>Could not load journal entries.</p>
            <a href="/dashboard" class="btn-primary"
              style="margin-top:16px;display:inline-block;">
              Back to Dashboard
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — My Journal</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">My Journal</h1>
        <p class="page-sub">Write honestly. Kaizen learns from everything you record.</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <!-- NEW SESSION NOTE -->
    <div class="card card-gold" style="margin-bottom:2px;">
      <div class="card-header">
        <h2>New Session Entry</h2>
        <span class="card-badge">Write Freely</span>
      </div>

      <form action="/dashboard/journal" method="POST" class="journal-form" id="journal-form">

  <!-- MAIN NOTEPAD — the only thing that matters -->
  <div class="form-group">
    <label class="form-label">Session Notes</label>
    <div class="notepad-wrapper">
      <div class="notepad-toolbar">
        <span class="notepad-hint">
          Write everything — what you analyzed, what you traded,
          what happened, and why. Be completely honest.
          Kaizen AI reads every word.
        </span>
      </div>
      <textarea
        name="notes"
        class="form-input notepad-textarea"
        placeholder="Start writing about your session...

What pair did you analyze? What timeframe?
What did you see on the chart?
Did you take a trade? What was your entry, SL, and TP?
Did you follow your checklist?
What happened — win, loss, or no trade?
What did you feel during the session?
What would you do differently?"
        required
        style="min-height:320px;"></textarea>
    </div>
  </div>

  <!-- COMPLIANCE — simplified -->
  <div class="form-group">
    <label class="form-label">Did you follow ALL your trading rules?</label>
    <div class="radio-group" style="flex-direction:row;gap:12px;">
      <label class="radio-option" style="flex:1;justify-content:center;padding:14px;">
        <input type="radio" name="ruleCompliance" value="true" required>
        <span style="color:var(--green);font-weight:600;font-size:0.9rem;">Yes</span>
      </label>
      <label class="radio-option" style="flex:1;justify-content:center;padding:14px;">
        <input type="radio" name="ruleCompliance" value="false">
        <span style="color:var(--red);font-weight:600;font-size:0.9rem;">No</span>
      </label>
    </div>
  </div>

  <!-- Hidden fields -->
  <input type="hidden" name="asset" value="">
  <input type="hidden" name="timeframe" value="N/A">
  <input type="hidden" name="outcome" value="Pending">
  <input type="hidden" name="emotion" value="Logged">
  <input type="hidden" name="sessionScore" value="50">
  <input type="hidden" name="direction" value="Live Trade">

  <button type="submit" class="btn-primary btn-full" id="journal-submit-btn">
    Save Session Entry
  </button>

  <div id="responding-state" style="
    display:none;
    text-align:center;
    padding:28px 16px;
    border:1px solid rgba(201,168,76,0.2);
    background:rgba(201,168,76,0.03);
    margin-top:16px;
  ">
    <div id="responding-text" style="
      font-family:'DM Mono',monospace;
      font-size:0.78rem;
      letter-spacing:0.15em;
      text-transform:uppercase;
      color:#C9A84C;
    ">改 KAIZEN AI IS RESPONDING...</div>
    <p style="
      font-size:0.75rem;
      color:#A8A09A;
      margin-top:10px;
      font-family:'DM Mono',monospace;
      letter-spacing:0.05em;
    ">Analyzing your session. Redirecting shortly.</p>
  </div>

</form>
    </div>

    <!-- PAST ENTRIES -->
    <div style="margin-top:32px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h2 style="font-size:1rem;font-weight:700;color:var(--text-primary);">
          Past Sessions
        </h2>
        <span style="font-family:var(--font-mono);font-size:0.65rem;color:var(--ash);letter-spacing:0.1em;text-transform:uppercase;">
          <%= typeof journals !== 'undefined' ? journals.length : 0 %> entries
        </span>
      </div>

      <% if (typeof journals !== 'undefined' && journals.length === 0) { %>
        <div class="card">
          <div class="empty-state">
            <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">
              No sessions logged yet.
            </p>
            <p>
              Traders who journal consistently outperform those who don't.
              Write your first entry above.
            </p>
          </div>
        </div>
      <% } else if (typeof journals !== 'undefined') { %>
        <div style="display:flex;flex-direction:column;gap:2px;">
          <% journals.forEach(function(journal) { %>
            <div class="journal-entry-card">
              <div class="journal-entry-top">
                <div style="display:flex;align-items:center;gap:12px;">
                  <span class="journal-asset"><%= journal.asset %></span>
                  <span class="journal-tag"><%= journal.direction %></span>
                </div>
                <div style="display:flex;align-items:center;gap:12px;">
                  <% if (journal.ruleCompliance) { %>
                    <span class="compliance-good">Rules Followed</span>
                  <% } else { %>
                    <span class="compliance-bad">Rules Violated</span>
                  <% } %>
                  <span class="journal-date">
                    <%= new Date(journal.createdAt).toLocaleDateString('en-US', {
                      month: 'short', day: 'numeric', year: 'numeric'
                    }) %>
                  </span>
                </div>
              </div>
              <div class="journal-entry-body">
                <p><%= journal.notes %></p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card">
          <div class="empty-state">
            <p>Could not load journal entries.</p>
            <a href="/dashboard" class="btn-outline"
              style="margin-top:16px;display:inline-block;">
              Back to Dashboard
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>

  <script>
  document.getElementById('journal-form').addEventListener('submit', function() {
    const btn = document.getElementById('journal-submit-btn');
    const state = document.getElementById('responding-state');

    btn.style.display = 'none';
    state.style.display = 'block';

    // Fade animation
    let visible = true;
    const textEl = document.getElementById('responding-text');
    setInterval(function() {
      if (textEl) {
        textEl.style.opacity = visible ? '0.2' : '1';
        visible = !visible;
      }
    }, 600);
  });
</script>
</body>
</html>

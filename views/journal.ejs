<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>KAIZEN — Journal</title>
</head>
<body class="app-page">

  <%- include('partials/navbar') %>

  <main class="app-main">

    <div class="page-header">
      <div>
        <h1 style="color:var(--gold);">Trading Journal</h1>
        <p class="page-sub">Write honestly. Kaizen learns from everything you record.</p>
      </div>
      <a href="/dashboard" class="btn-outline">← Dashboard</a>
    </div>

    <!-- NEW SESSION NOTE -->
    <div class="card card-gold" style="margin-bottom:2px;">
      <div class="card-header">
        <h2>New Session Entry</h2>
        <span class="card-badge">Write Freely</span>
      </div>

      <form action="/dashboard/journal" method="POST" class="journal-form">

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Asset Traded</label>
            <input type="text" name="asset" class="form-input"
              placeholder="e.g. BTC/USDT, EUR/USD, GOLD">
          </div>
          <div class="form-group">
            <label class="form-label">Session Type</label>
            <div class="radio-group" style="flex-direction:row;gap:12px;">
              <label class="radio-option" style="flex:1;justify-content:center;">
                <input type="radio" name="direction" value="Live Trade" required>
                <span style="color:var(--gold);font-weight:600;">Live Trade</span>
              </label>
              <label class="radio-option" style="flex:1;justify-content:center;">
                <input type="radio" name="direction" value="Backtesting">
                <span style="color:var(--ash-light);font-weight:600;">Backtesting</span>
              </label>
            </div>
          </div>

        <!-- MAIN NOTEPAD -->
        <div class="form-group">
          <label class="form-label">Session Notes</label>
          <div class="notepad-wrapper">
            <div class="notepad-toolbar">
              <span class="notepad-hint">
                Write everything — what you saw, what you did,
                what you felt, what you learned. Be completely honest.
                Kaizen AI reads this to understand how you trade.
              </span>
            </div>
            <textarea
              name="notes"
              class="form-input notepad-textarea"
              placeholder="Start writing about your session...

What market did you analyze? What did you see on the chart?
Did you take a trade? Why or why not?
What was your entry, stop loss, and target?
How did you feel during the session?
Did anything make you anxious, greedy, or uncertain?
Did you follow your rules? If not, where did you break them?
What is the one thing you will do differently next session?"
              required></textarea>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Did you follow ALL your trading rules this session?</label>
          <div class="radio-group" style="flex-direction:row;gap:12px;">
            <label class="radio-option" style="flex:1;justify-content:center;">
              <input type="radio" name="ruleCompliance" value="true" required>
              <span style="color:var(--green);font-weight:600;">Yes — Fully Compliant</span>
            </label>
            <label class="radio-option" style="flex:1;justify-content:center;">
              <input type="radio" name="ruleCompliance" value="false">
              <span style="color:var(--red);font-weight:600;">No — Rules Violated</span>
            </label>
          </div>
        </div>

        <input type="hidden" name="timeframe" value="N/A">
        <input type="hidden" name="outcome" value="Pending">
        <input type="hidden" name="emotion" value="Logged">
        <input type="hidden" name="sessionScore" value="50">

        <button type="submit" class="btn-primary btn-full">
          Save Session Entry
        </button>

      </form>
    </div>

    <!-- PAST ENTRIES -->
    <div style="margin-top:32px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h2 style="font-size:1rem;font-weight:700;color:var(--text-primary);">
          Past Sessions
        </h2>
        <span style="font-family:var(--font-mono);font-size:0.65rem;color:var(--ash);letter-spacing:0.1em;text-transform:uppercase;">
          <%= typeof journals !== 'undefined' ? journals.length : 0 %> entries
        </span>
      </div>

      <% if (typeof journals !== 'undefined' && journals.length === 0) { %>
        <div class="card">
          <div class="empty-state">
            <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">
              No sessions logged yet.
            </p>
            <p>
              Traders who journal consistently outperform those who don't.
              Write your first entry above.
            </p>
          </div>
        </div>
      <% } else if (typeof journals !== 'undefined') { %>
        <div style="display:flex;flex-direction:column;gap:2px;">
          <% journals.forEach(function(journal) { %>
            <div class="journal-entry-card">
              <div class="journal-entry-top">
                <div style="display:flex;align-items:center;gap:12px;">
                  <span class="journal-asset"><%= journal.asset %></span>
                  <span class="journal-tag"><%= journal.direction %></span>
                </div>
                <div style="display:flex;align-items:center;gap:12px;">
                  <% if (journal.ruleCompliance) { %>
                    <span class="compliance-good">Rules Followed</span>
                  <% } else { %>
                    <span class="compliance-bad">Rules Violated</span>
                  <% } %>
                  <span class="journal-date">
                    <%= new Date(journal.createdAt).toLocaleDateString('en-US', {
                      month: 'short', day: 'numeric', year: 'numeric'
                    }) %>
                  </span>
                </div>
              </div>
              <div class="journal-entry-body">
                <p><%= journal.notes %></p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card">
          <div class="empty-state">
            <p>Could not load journal entries.</p>
            <a href="/dashboard" class="btn-outline"
              style="margin-top:16px;display:inline-block;">
              Back to Dashboard
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>

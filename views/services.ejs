<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.services') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-page-main">

    <!-- HEADER -->
    <div class="k-page-header k-grid-bg" data-reveal>
      <div class="k-eyebrow k-eyebrow--center"><%= t('svc.eyebrow') %></div>
      <h1 class="k-page-h1"><%= t('svc.what') %><span class="k-gold"><%= t('brand.kaizen') %></span><%= t('svc.gives') %></h1>
      <p class="k-page-sub"><%= t('svc.sub') %></p>
    </div>

    <!-- THE IMPROVEMENT ENGINE -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.engine') %></div>
    </div>
    <div class="k-feat-grid" style="margin-bottom:56px;">

      <div class="k-feat-card k-card k-card--featured" data-reveal>
        <div class="k-icon-badge"><i data-feather="sliders" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.sysH') %></div>
          <p><%= t('svc.sysB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="edit-3" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.aiH') %></div>
          <p><%= t('svc.aiB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:120ms;">
        <div class="k-icon-badge"><i data-feather="activity" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.behH') %></div>
          <p><%= t('svc.behB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:180ms;">
        <div class="k-icon-badge"><i data-feather="brain" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.psychH') %></div>
          <p><%= t('svc.psychB') %></p>
        </div>
      </div>

    </div>

    <!-- YOUR PROGRESS -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.progH') %></div>
    </div>
    <div class="k-feat-grid" style="margin-bottom:56px;">

      <div class="k-feat-card k-feat-card--col k-card k-card--featured" data-reveal>
        <div style="display:flex;align-items:center;gap:14px;">
          <div class="k-icon-badge"><i data-feather="bar-chart-2" width="18" height="18"></i></div>
          <div class="k-feat-title" style="margin-bottom:0;"><%= t('dash.score') %></div>
        </div>
        <div class="k-score-demo">
          <%- include('partials/k-dial', { value: 84, size: 120 }) %>
          <%- include('partials/k-meters', { meters: [
            [t('dash.dimProcess'), 88],
            [t('dash.dimRisk'), 81],
            [t('dash.dimExecution'), 85],
            [t('dash.dimBehavior'), 79],
            [t('dash.dimLearning'), 90]
          ] }) %>
        </div>
        <p><%= t('svc.scoreB') %></p>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="trending-up" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('dash.myProgress') %></div>
          <p><%= t('svc.myProgB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:120ms;">
        <div class="k-icon-badge"><i data-feather="award" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.mileH') %></div>
          <p><%= t('svc.mileB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:180ms;">
        <div class="k-icon-badge"><i data-feather="archive" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.memH') %></div>
          <p><%= t('svc.memB') %></p>
        </div>
      </div>

    </div>

    <!-- TOOLS -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.tools') %></div>
    </div>
    <div class="k-feat-grid" style="margin-bottom:56px;">

      <div class="k-feat-card k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="bar-chart-2" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.chartH') %></div>
          <p><%= t('svc.chartB') %></p>
        </div>
      </div>

      <div class="k-feat-card k-card k-card--hover" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge"><i data-feather="mail" width="18" height="18"></i></div>
        <div>
          <div class="k-feat-title"><%= t('svc.weekH') %></div>
          <p><%= t('svc.weekB') %></p>
        </div>
      </div>

    </div>

    <!-- IDENTITY & VERIFICATION (OPTIONAL) -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.idH') %></div>
      <h2 class="k-title"><%= t('svc.idSub') %></h2>
      <p class="k-sub k-sub--left"><%= t('svc.idIntro') %></p>
    </div>

    <div class="k-verify-grid" style="margin-bottom:56px;">

      <div class="k-verify-card k-card k-card--hover" data-reveal>
        <div class="k-icon-badge"><i data-feather="link" width="18" height="18"></i></div>
        <h3 class="k-verify-title"><%= t('svc.walletsH') %></h3>
        <p><%= t('svc.walletsB') %></p>
        <span class="k-tag"><%= t('svc.stacks') %></span>
      </div>

      <div class="k-verify-card k-card k-card--featured" data-reveal style="transition-delay:80ms;">
        <div class="k-seal">認</div>
        <h3 class="k-verify-title"><%= t('svc.credH') %></h3>
        <p><%= t('svc.credB') %></p>
        <span class="k-tag"><%= t('svc.mantle') %></span>
      </div>

      <div class="k-verify-card k-card k-card--hover" data-reveal style="transition-delay:160ms;">
        <div class="k-icon-badge"><i data-feather="globe" width="18" height="18"></i></div>
        <h3 class="k-verify-title"><%= t('svc.repH') %></h3>
        <p><%= t('svc.repB') %></p>
        <span class="k-tag"><%= t('svc.optional') %></span>
      </div>

    </div>

    <!-- COMING SOON -->
    <div data-reveal>
      <div class="k-eyebrow"><%= t('svc.coming') %></div>
    </div>
    <div class="k-soon-grid" style="margin-bottom:56px;">

      <div class="k-soon-card" data-reveal>
        <div class="k-icon-badge" style="margin-bottom:10px;"><i data-feather="user" width="14" height="14"></i></div>
        <div class="k-soon-title"><%= t('svc.tpH') %></div>
        <p><%= t('svc.tpB') %></p>
      </div>

      <div class="k-soon-card" data-reveal style="transition-delay:60ms;">
        <div class="k-icon-badge" style="margin-bottom:10px;"><i data-feather="credit-card" width="14" height="14"></i></div>
        <div class="k-soon-title"><%= t('svc.tcH') %></div>
        <p><%= t('svc.tcB') %></p>
        <span class="k-soon-seal">認</span>
      </div>

      <div class="k-soon-card" data-reveal style="transition-delay:120ms;">
        <div class="k-icon-badge" style="margin-bottom:10px;"><i data-feather="mic" width="14" height="14"></i></div>
        <div class="k-soon-title"><%= t('svc.voiceH') %></div>
        <p><%= t('svc.voiceB') %></p>
      </div>

      <div class="k-soon-card" data-reveal style="transition-delay:180ms;">
        <div class="k-icon-badge" style="margin-bottom:10px;"><i data-feather="smartphone" width="14" height="14"></i></div>
        <div class="k-soon-title"><%= t('svc.mobileH') %></div>
        <p><%= t('svc.mobileB') %></p>
      </div>

      <div class="k-soon-card" data-reveal style="transition-delay:240ms;">
        <div class="k-icon-badge" style="margin-bottom:10px;"><i data-feather="dollar-sign" width="14" height="14"></i></div>
        <div class="k-soon-title"><%= t('svc.proH') %></div>
        <p><%= t('svc.proB') %></p>
      </div>

    </div>

    <!-- FINAL CTA -->
    <div class="k-final-cta" data-reveal>
      <h2 class="k-cta-h"><%= t('svc.ctaH') %></h2>
      <p class="k-cta-sub"><%= t('svc.ctaB') %></p>
      <div class="k-cta-btns">
        <a href="/auth/register" class="btn-primary k-btn-lg"><%= t('svc.cta') %></a>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script src="/js/v2-reveal.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

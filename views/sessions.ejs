<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.sessions') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-page-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:8px;">
      <div>
        <div class="k-eyebrow" style="margin-bottom:8px;">Sessions</div>
        <h1 class="k-page-h1" style="font-size:clamp(1.7rem,4vw,2.4rem);margin-bottom:8px;"><%= t('sessions.sub') %></h1>
        <p style="font-size:0.9rem;color:var(--text-secondary);max-width:560px;line-height:1.75;margin:0;"><%= t('sessions.sub2') %></p>
      </div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <button type="button" class="btn-outline k-btn-lg" onclick="var b=document.getElementById('broker-import-panel');if(b)b.style.display=b.style.display==='none'?'block':'none';">
          Sync Broker History<% if (typeof brokerTradesCount === 'number' && brokerTradesCount > 0) { %> (<%= brokerTradesCount %>)<% } %>
        </button>
        <a href="/dashboard/sessions/new" class="btn-primary k-btn-lg">+ <%= t('sessions.new') %></a>
      </div>
    </div>

    <% if (typeof importedCount === 'number') { %>
      <div class="k-card" style="margin:16px 0;padding:14px 18px;border-color:rgba(245,197,24,0.45);background:rgba(245,197,24,0.06);font-size:0.86rem;color:var(--text-primary);">
        <% if (importedCount > 0) { %>
          Synced <%= importedCount %> broker trade<%= importedCount === 1 ? '' : 's' %> (sensitive account numbers, logins, and dollar balances stripped automatically). Matching live sessions have been verified.
        <% } else { %>
          No new trade rows detected in the uploaded file. Export your Trade History Report (.html or .csv) from MT4, MT5, cTrader, or TradingView and try again.
        <% } %>
      </div>
    <% } %>

    <div id="broker-import-panel" class="k-card" style="display:none;margin:18px 0;padding:22px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px;">
        <div class="k-panel-title"><span class="k-kanji k-kanji--sm">改</span>PRIVACY-FIRST BROKER HISTORY SYNC</div>
        <span style="font-family:var(--font-mono);font-size:0.56rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);">MT5 Mobile · MT4/MT5 Desktop · cTrader · TradingView</span>
      </div>
      <p style="font-size:0.84rem;color:var(--text-secondary);line-height:1.7;margin:0 0 14px;">
        Using the <strong>MT5 Mobile App</strong> (where there is no HTML export button)? Enter the closed trade from your mobile History tab below, or upload an exported Desktop Trade History (<strong>.html</strong> / <strong>.csv</strong>). KAIZEN never collects account numbers, logins, deposits, or dollar balances.
      </p>
      <form action="/dashboard/sessions/import-broker" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="returnTo" value="/dashboard/sessions">
        <div style="font-family:var(--font-mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:700;">
          OPTION 1: QUICK MT5 MOBILE APP TRADE SYNC
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:10px;margin-bottom:14px;">
          <div>
            <label class="k-fieldlabel">PAIR / SYMBOL</label>
            <input type="text" name="mt5Symbol" class="k-input" placeholder="e.g. AUDJPY, XAUUSD">
          </div>
          <div>
            <label class="k-fieldlabel">BUY / SELL</label>
            <select name="mt5Direction" class="k-input">
              <option value="Buy">Buy</option>
              <option value="Sell">Sell</option>
            </select>
          </div>
          <div>
            <label class="k-fieldlabel">ENTRY PRICE</label>
            <input type="text" name="mt5Entry" class="k-input" placeholder="e.g. 101.420">
          </div>
          <div>
            <label class="k-fieldlabel">EXIT PRICE</label>
            <input type="text" name="mt5Exit" class="k-input" placeholder="e.g. 100.820">
          </div>
          <div>
            <label class="k-fieldlabel">STOP LOSS (OPT)</label>
            <input type="text" name="mt5Stop" class="k-input" placeholder="e.g. 101.720">
          </div>
          <div>
            <label class="k-fieldlabel">TRADE DATE</label>
            <input type="date" name="mt5Date" class="k-input" value="<%= new Date().toISOString().slice(0,10) %>">
          </div>
        </div>
        <div style="border-top:1px solid var(--border);padding-top:12px;margin-bottom:14px;">
          <div style="font-family:var(--font-mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-secondary);margin-bottom:8px;">
            OPTION 2: DESKTOP REPORT UPLOAD (.HTML / .CSV) OR BULK PASTE
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div>
              <label class="k-fieldlabel">UPLOAD BROKER REPORT (.HTML / .CSV)</label>
              <input type="file" name="brokerFile" accept=".html,.htm,.csv,.txt" class="k-input">
            </div>
            <div>
              <label class="k-fieldlabel">OR PASTE TRADE HISTORY ROWS</label>
              <input type="text" name="brokerText" class="k-input" placeholder="e.g. 2026-10-29 09:15, buy, AUDJPY, 101.20, 100.90, 101.85, 101.80">
            </div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
          <button type="submit" class="btn-primary">Verify &amp; Sync Trades</button>
          <a href="/za/reputation/<%= user.id || user._id %>#traders-card" style="font-family:var(--font-mono);font-size:0.64rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);text-decoration:underline;">View Branded Trader's Card &amp; Dossier</a>
        </div>
      </form>
    </div>

    <% if (openPlan) { %>
      <div class="k-card k-card--featured" style="margin:24px 0;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <span class="k-tag" style="color:var(--gold);border-color:var(--gold-border);margin-bottom:8px;"><%= t('sessions.awaiting') %></span>
          <div style="font-weight:700;color:var(--text-primary);margin-top:8px;">
            <%= openPlan.plan.skipped ? 'Unplanned session in progress' : (openPlan.plan.setup || 'Planned session in progress') %>
          </div>
        </div>
        <a href="/dashboard/sessions/<%= openPlan._id %>/record" class="btn-primary"><%= t('sessions.recordIt') %></a>
      </div>
    <% } %>

    <% if (!sessions || sessions.length === 0) { %>
      <div class="k-card" style="text-align:center;padding:56px 24px;margin-top:24px;">
        <span class="k-kanji k-kanji--md" style="margin:0 auto 16px;">改</span>
        <p style="font-size:0.9rem;color:var(--text-secondary);line-height:1.8;margin:0 0 20px;">
          <%= t('sessions.empty') %>
        </p>
        <a href="/dashboard/sessions/new" class="btn-primary"><%= t('sessions.firstPlan') %></a>
      </div>
    <% } else { %>

      <div style="display:flex;flex-direction:column;gap:10px;margin-top:28px;">
        <% sessions.forEach(function(s) { %>
          <a href="/dashboard/sessions/<%= s._id %>" class="k-card k-card--hover" style="display:flex;align-items:center;gap:14px;padding:18px 20px;">
            <div style="min-width:64px;">
              <div style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-primary);font-weight:500;"><%= s.asset %></div>
              <div style="font-family:var(--font-mono);font-size:0.55rem;color:var(--text-faint);letter-spacing:0.08em;margin-top:3px;">
                <%= new Date(s.createdAt).toLocaleDateString(({en:'en-US',fr:'fr-FR',zh:'zh-CN',ja:'ja-JP',af:'af-ZA'})[lang]||'en-US',{month:'short',day:'numeric'}) %>
              </div>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span class="k-chip" style="padding:3px 9px;font-size:0.52rem;"><%= labels.state(s.state) %></span>
                <span class="k-type-tag k-type-tag--<%= String(s.sessionType||'LIVE').toLowerCase() %>"><%= labels.type(s.sessionType || 'LIVE') %></span>
                <% if (s.outcome && s.outcome !== 'Pending') { %>
                  <span style="font-family:var(--font-mono);font-size:0.6rem;color:<%= s.outcome === 'Win' ? 'var(--green)' : s.outcome === 'Loss' ? 'var(--red)' : 'var(--ash)' %>;"><%= labels.outcome(s.outcome) %></span>
                <% } %>
              </div>
              <div style="font-size:0.82rem;color:var(--text-secondary);margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <%= (s.notes || (s.plan && !s.plan.skipped ? 'Planned: ' + (s.plan.setup || '') : 'No notes yet')).substring(0,110) %>
              </div>
            </div>
            <span class="k-gold" style="font-family:var(--font-mono);">→</span>
          </a>
        <% }); %>
      </div>

    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <title><%= t('title.sessions') %></title>
</head>
<body class="app-page">
  <%- include('partials/navbar') %>

  <main class="k-page-main">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:8px;">
      <div>
        <div class="k-eyebrow" style="margin-bottom:8px;">Sessions</div>
        <h1 class="k-page-h1" style="font-size:clamp(1.7rem,4vw,2.4rem);margin-bottom:8px;"><%= t('sessions.sub') %></h1>
        <p style="font-size:0.9rem;color:var(--text-secondary);max-width:560px;line-height:1.75;margin:0;"><%= t('sessions.sub2') %></p>
      </div>
      <a href="/dashboard/sessions/new" class="btn-primary k-btn-lg">+ <%= t('sessions.new') %></a>
    </div>

    <% if (openPlan) { %>
      <div class="k-card k-card--featured" style="margin:24px 0;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <span class="k-tag" style="color:var(--gold);border-color:var(--gold-border);margin-bottom:8px;"><%= t('sessions.awaiting') %></span>
          <div style="font-weight:700;color:var(--text-primary);margin-top:8px;">
            <%= openPlan.plan.skipped ? 'Unplanned session in progress' : (openPlan.plan.setup || 'Planned session in progress') %>
          </div>
        </div>
        <a href="/dashboard/sessions/<%= openPlan._id %>/record" class="btn-primary"><%= t('sessions.recordIt') %></a>
      </div>
    <% } %>

    <% if (!sessions || sessions.length === 0) { %>
      <div class="k-card" style="text-align:center;padding:56px 24px;margin-top:24px;">
        <span class="k-kanji k-kanji--md" style="margin:0 auto 16px;">改</span>
        <p style="font-size:0.9rem;color:var(--text-secondary);line-height:1.8;margin:0 0 20px;">
          <%= t('sessions.empty') %>
        </p>
        <a href="/dashboard/sessions/new" class="btn-primary"><%= t('sessions.firstPlan') %></a>
      </div>
    <% } else { %>

      <div style="display:flex;flex-direction:column;gap:10px;margin-top:28px;">
        <% sessions.forEach(function(s) { %>
          <a href="/dashboard/sessions/<%= s._id %>" class="k-card k-card--hover" style="display:flex;align-items:center;gap:14px;padding:18px 20px;">
            <div style="min-width:64px;">
              <div style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-primary);font-weight:500;"><%= s.asset %></div>
              <div style="font-family:var(--font-mono);font-size:0.55rem;color:var(--text-faint);letter-spacing:0.08em;margin-top:3px;">
                <%= new Date(s.createdAt).toLocaleDateString(({en:'en-US',fr:'fr-FR',zh:'zh-CN',ja:'ja-JP',af:'af-ZA'})[lang]||'en-US',{month:'short',day:'numeric'}) %>
              </div>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span class="k-chip" style="padding:3px 9px;font-size:0.52rem;"><%= labels.state(s.state) %></span>
                <span class="k-type-tag k-type-tag--<%= String(s.sessionType||'LIVE').toLowerCase() %>"><%= labels.type(s.sessionType || 'LIVE') %></span>
                <% if (s.outcome && s.outcome !== 'Pending') { %>
                  <span style="font-family:var(--font-mono);font-size:0.6rem;color:<%= s.outcome === 'Win' ? 'var(--green)' : s.outcome === 'Loss' ? 'var(--red)' : 'var(--ash)' %>;"><%= labels.outcome(s.outcome) %></span>
                <% } %>
              </div>
              <div style="font-size:0.82rem;color:var(--text-secondary);margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <%= (s.notes || (s.plan && !s.plan.skipped ? 'Planned: ' + (s.plan.setup || '') : 'No notes yet')).substring(0,110) %>
              </div>
            </div>
            <span class="k-gold" style="font-family:var(--font-mono);">→</span>
          </a>
        <% }); %>
      </div>

    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <script>if (window.feather) feather.replace();</script>
</body>
</html>

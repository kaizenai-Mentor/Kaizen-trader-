<script>
(function(){
  // gentle fade-in on scroll
  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    els.forEach(function(el){io.observe(el)});
  }else{els.forEach(function(el){el.classList.add('in')})}

  // showcase: real-looking UI panels
  var S=[
   {t:'Sessions',h:'Session reflection',tag:'London Session',rows:[['London session','3 trades'],['Rules followed','2 of 3'],['Mood before','Calm']],bar:67,note:'Write what went well and what was hard while it is fresh.'},
   {t:'KAIZEN AI',h:'Coach feedback',tag:'Behavioral Read',rows:[['Blind spot detected','Revenge entry within 15m of a loss'],['First trade win rate','68% (when following plan)'],['Post loss win rate','18% (when chasing recovery)']],bar:0,note:'KAIZEN AI: "You do not have a strategy problem. Your first trade of the day is disciplined and profitable. You are giving back your edge in the 15 minutes after a stop out."'},
   {t:'Goals',h:'Active goals',tag:'Accountability',rows:[['Journal after every session','3 of 5'],['No trades after two losses','4 of 5'],['Risk under 1% per trade','5 of 5']],bar:80,note:'One habit at a time. Each goal shows if you are on track.'},
   {t:'Progress',h:'Last 8 weeks',tag:'Consistency',rows:[['Rules followed','58% to 72%'],['Reflection streak','12 days'],['Stage','Learning Trader']],bar:72,note:'Your growth, week by week.'},
   {t:'Weekly Review',h:'This week',tag:'Sun to Sat Synthesis',rows:[['Improved','Patience at entries'],['Needs work','Moving stops'],['Next week','Keep stops fixed']],bar:0,note:'A short review that tells you what to do next.'}
  ];
  var tabs=document.getElementById('tabs'),track=document.getElementById('track');
  if(tabs && track){
    S.forEach(function(s,i){
      var b=document.createElement('button');b.type='button';b.className='tab'+(i?'':' on');b.textContent=s.t;b.setAttribute('role','tab');
      b.onclick=function(){track.children[i].scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'})};
      tabs.appendChild(b);
      var d=document.createElement('div');d.className='slide';
      var rows=s.rows.map(function(r){return '<div class="blk"><div class="kv"><span>'+r[0]+'</span><strong>'+r[1]+'</strong></div></div>'}).join('');
      d.innerHTML='<div class="panel"><div><div class="panel-head"><h4>'+s.h+'</h4><span class="panel-tag">'+s.tag+'</span></div>'+rows+(s.bar?'<div class="bar"><i style="width:'+s.bar+'%"></i></div>':'')+'</div><p class="blk" style="border:0;padding-bottom:0"><span style="color:var(--mute-d);font-size:.92rem">'+s.note+'</span></p></div>';
      track.appendChild(d);
    });
    function idx(){
      if(!track.children[0]) return 0;
      var w=track.children[0].offsetWidth+20;
      return Math.min(S.length-1,Math.max(0,Math.round(track.scrollLeft/w)));
    }
    track.addEventListener('scroll',function(){
      var i=idx();
      [].forEach.call(tabs.children,function(t,j){t.classList.toggle('on',i===j)});
    });
    var nextBtn=document.getElementById('next');
    var prevBtn=document.getElementById('prev');
    if(nextBtn){
      nextBtn.onclick=function(){
        track.children[Math.min(S.length-1,idx()+1)].scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'});
      };
    }
    if(prevBtn){
      prevBtn.onclick=function(){
        track.children[Math.max(0,idx()-1)].scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'});
      };
    }
  }
})();
</script>

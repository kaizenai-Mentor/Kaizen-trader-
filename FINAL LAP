<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>KAIZEN | Trader Development Platform</title>
<meta name="description" content="KAIZEN is a Trader Development Platform. Set goals, reflect after every session, and build the habits of a consistent trader.">
<link rel="icon" href="images/kaizen-icon.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@400;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--black:#0A0A0A;--white:#F4F8FB;--gold:#F5C518;--blue:#1A2F4A;--mute:#A3B1BF;--mute-d:#41566B;--line:#232B33;color-scheme:dark}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,-apple-system,sans-serif;background:var(--black);color:var(--white);line-height:1.65;font-size:17px;font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,h4,.logo{font-family:Sora,system-ui,-apple-system,sans-serif;letter-spacing:-.02em;line-height:1.12}
a{color:inherit;text-decoration:none}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
section{padding:130px 0}
.light{background:var(--white);color:var(--black)}
.light .sub{color:var(--mute-d)}
.sub{color:var(--mute);max-width:32em}
h2{font-size:clamp(2rem,4.2vw,3rem);font-weight:600;margin-bottom:22px}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
::selection{background:rgba(245,197,24,.26);color:var(--white)}
.light ::selection{background:rgba(245,197,24,.38);color:var(--black)}

.eyebrow{font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:inline-flex;align-items:center;gap:8px}
.eyebrow::before{content:"";width:18px;height:1.5px;background: currentColor;display:inline-block}
.light .eyebrow{color:var(--blue)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 26px;border-radius:12px;font-family:Sora,system-ui,sans-serif;font-weight:600;border:1.5px solid transparent;transition:background .25s,color .25s,border-color .25s,transform .2s,box-shadow .25s;cursor:pointer;font-size:.96rem;line-height:1.2}
.btn.gold{background:var(--gold);color:var(--black);border-color:var(--gold)}
.btn.gold:hover{background:var(--white);border-color:var(--white);color:var(--black);transform:translateY(-1px);box-shadow:0 10px 28px rgba(245,197,24,.24)}
.light .btn.gold:hover{background:var(--black);border-color:var(--black);color:var(--white)}
.btn.blue{background:var(--blue);color:var(--white);border-color:var(--blue)}
.btn.blue:hover{border-color:var(--white);background:#223D60;transform:translateY(-1px)}

/* nav */
nav{position:sticky;top:0;z-index:50;background:rgba(10,10,10,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:70px;gap:20px}
.logo{font-weight:700;font-size:1.25rem;display:inline-flex;align-items:center;gap:10px;letter-spacing:.02em}
.logo-kanji{color:var(--gold);font-weight:700}
.beta-pill{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;padding:3px 9px;border-radius:99px;background:var(--blue);color:var(--white);border:1px solid rgba(244,248,251,.16)}
.links{display:flex;gap:28px;align-items:center;font-size:.95rem;color:var(--mute)}
.links a:hover,.links a.on{color:var(--gold)}
.links a.btn.gold{color:var(--black)}
.links a.btn.gold:hover{color:var(--black)}
nav .btn{padding:10px 20px;font-size:.9rem}

/* hero */
.hero{min-height:86vh;display:flex;align-items:center;padding:84px 0 64px;position:relative}
.hero::before{content:"";position:absolute;top:8%;right:6%;width:480px;height:480px;background:radial-gradient(circle,rgba(26,47,74,.38) 0%,rgba(245,197,24,.06) 45%,transparent 72%);pointer-events:none;z-index:0}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;position:relative;z-index:1}
.hero h1{font-size:clamp(2.5rem,5.2vw,4.15rem);font-weight:700;margin-bottom:24px;line-height:1.14}
.hero h1 span{color:var(--gold)}
.hero .sub{margin-bottom:34px;font-size:1.1rem;line-height:1.72}
.cta{display:flex;gap:12px;flex-wrap:wrap}

/* UI mock panels */
.panel{background:var(--white);color:var(--black);border-radius:20px;padding:28px;box-shadow:0 30px 60px rgba(0,0,0,.48);border:1px solid #DCE6EE}
.light .panel{box-shadow:0 24px 50px rgba(26,47,74,.16);border:1px solid #DCE6EE;background:#FFFFFF}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:14px;margin-bottom:4px;border-bottom:1px solid #DCE6EE}
.panel-tag{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;padding:4px 10px;border-radius:99px;background:var(--blue);color:var(--white)}
.panel h4{font-family:Sora,sans-serif;font-size:.95rem;font-weight:600;margin-bottom:6px;color:var(--black)}
.blk{padding:14px 0;border-top:1px solid #DCE6EE}
.blk:first-child{border-top:0;padding-top:0}
.blk p{font-size:.92rem;color:var(--mute-d);line-height:1.55}
.blk b{color:var(--black);font-weight:600}
.bar{height:8px;border-radius:9px;background:#DCE6EE;margin:8px 0 6px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--gold);border-radius:9px;transition:width .6s ease}
.bar.b i{background:var(--blue)}
.kv{display:flex;justify-content:space-between;align-items:baseline;font-size:.88rem;color:var(--mute-d)}
.kv strong{color:var(--black);font-family:Sora,sans-serif;font-weight:600}

.trust{padding:0 24px 48px;text-align:center;color:var(--mute);font-size:.98rem;letter-spacing:.01em}

/* problem */
.problem{border-top:1px solid var(--line)}
.problem .wrap{max-width:760px}
.chain{list-style:none;margin:48px 0}
.chain li{font-family:Sora,sans-serif;font-size:clamp(1.7rem,4vw,2.6rem);font-weight:600;padding-bottom:34px;position:relative;padding-left:36px;color:var(--white)}
.chain li::before{content:"";position:absolute;left:5px;top:.85em;width:2px;bottom:-.5em;background:var(--line)}
.chain li::after{content:"";position:absolute;left:0;top:.55em;width:12px;height:12px;border-radius:50%;background:var(--mute-d)}
.chain li:last-child{color:var(--gold);padding-bottom:8px}
.chain li:last-child::before{display:none}
.chain li:last-child::after{background:var(--gold);box-shadow:0 0 14px rgba(245,197,24,.6)}
.problem .intro{font-family:Sora,sans-serif;font-size:1.4rem;font-weight:600;color:var(--white);padding:24px 28px;border-radius:16px;background:rgba(26,47,74,.38);border:1px solid rgba(245,197,24,.28)}

/* meet */
.two{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}
.sess .q{font-size:.94rem;padding:13px 16px;border-radius:12px;background:#E8EFF5;margin-top:10px;color:var(--black);font-weight:500}
.sess .a{font-size:.92rem;padding:15px 18px;border-radius:12px;background:var(--blue);color:var(--white);margin-top:12px;line-height:1.65;border-left:4px solid var(--gold)}

/* how */
.steps{list-style:none;display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:56px;position:relative}
.steps::before{content:"";position:absolute;top:20px;left:8%;right:8%;height:2px;background:var(--line);z-index:0}
.steps li{text-align:center;position:relative;z-index:1;padding:0 8px}
.steps .n{width:42px;height:42px;border-radius:50%;margin:0 auto 14px;background:var(--black);border:2px solid var(--mute-d);display:flex;align-items:center;justify-content:center;font-family:Sora,sans-serif;font-weight:600;font-size:.95rem;color:var(--white);transition:border-color .25s,transform .25s}
.steps li:hover .n{border-color:var(--gold);transform:scale(1.06)}
.steps li:last-child .n{border-color:var(--gold);color:var(--gold);background:rgba(245,197,24,.1)}
.steps strong{display:block;font-family:Sora,sans-serif;font-size:.98rem;font-weight:600;color:var(--white);margin-bottom:6px}
.steps span{display:block;font-size:.84rem;color:var(--mute);line-height:1.5}

/* toolkit */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.card{background:var(--white);color:var(--black);border-radius:18px;padding:30px;border:1px solid #DCE6EE;box-shadow:0 24px 48px rgba(0,0,0,.38);transition:transform .22s ease,box-shadow .22s ease}
.card:hover{transform:translateY(-3px);box-shadow:0 30px 60px rgba(0,0,0,.5)}
.card-role{font-family:'DM Mono',monospace;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);font-weight:600;margin-bottom:8px}
.card h3{font-size:1.22rem;font-weight:600;margin-bottom:10px;color:var(--black)}
.card p{font-size:.95rem;color:var(--mute-d);line-height:1.6}

/* quote */
.quote{text-align:center;padding:160px 0;border-top:1px solid var(--line)}
.quote p{font-family:Sora,sans-serif;font-weight:700;font-size:clamp(2.2rem,6vw,4.6rem);line-height:1.1;letter-spacing:-.03em}
.quote p:first-child{color:var(--mute);margin-bottom:10px}
.quote p+p{color:var(--white)}
.quote p+p span{color:var(--gold)}

/* journey */
.stages{list-style:none;display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin:52px 0 36px;position:relative}
.stages li{padding-top:34px;position:relative;border-top:2px solid #C9D6E2}
.stages li::before{content:"";position:absolute;top:-8px;left:0;width:14px;height:14px;border-radius:50%;background:var(--white);border:2px solid var(--blue)}
.stages li.done{border-top-color:var(--gold)}
.stages li.done::before{background:var(--gold);border-color:var(--gold)}
.stages h3{font-size:1.05rem;font-weight:600;margin-bottom:6px;color:var(--black)}
.stages p{font-size:.9rem;color:var(--mute-d);line-height:1.55}
.stronger{font-family:Sora,sans-serif;font-weight:600;font-size:1.25rem;color:var(--black)}

/* showcase */
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:34px 0 22px}
.tab{background:none;border:1.5px solid var(--line);color:var(--mute);padding:9px 18px;border-radius:99px;font-family:Sora,sans-serif;font-weight:500;font-size:.9rem;cursor:pointer;transition:all .22s}
.tab:hover{border-color:var(--blue);background:var(--blue);color:var(--white)}
.tab.on{border-color:var(--gold);color:var(--gold);background:rgba(245,197,24,.08)}
.track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:20px;scrollbar-width:none;padding-bottom:8px}
.track::-webkit-scrollbar{display:none}
.slide{flex:0 0 min(660px,90%);scroll-snap-align:start}
.slide .panel{min-height:320px;display:flex;flex-direction:column;justify-content:space-between}
.nav2{display:flex;gap:10px;margin-top:22px}
.nav2 .btn{padding:10px 20px;font-size:.9rem}

/* faq */
.faq .wrap{max-width:780px}
details{border-top:1px solid #C9D6E2;padding:22px 0}
details:last-child{border-bottom:1px solid #C9D6E2}
summary{cursor:pointer;font-family:Sora,sans-serif;font-weight:600;font-size:1.12rem;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;color:var(--black)}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--blue);font-size:1.4rem;line-height:1;font-weight:600}
details[open] summary::after{content:"–"}
details p{margin-top:12px;color:var(--mute-d);max-width:42em;line-height:1.68}

/* final + early-user beta pipeline */
.final{text-align:center;padding:150px 0;border-top:1px solid var(--line)}
.final h2{font-size:clamp(2.4rem,6vw,4.6rem);font-weight:700;margin-bottom:22px;line-height:1.08}
.final h2 span{display:block;color:var(--gold)}
.final .sub{margin:0 auto 42px;font-size:1.08rem}
.beta-pipeline{max-width:560px;margin:0 auto;text-align:left}
.beta-form{display:flex;flex-direction:column;gap:14px;margin-top:16px}
.beta-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.beta-field label{display:block;font-family:Sora,sans-serif;font-size:.8rem;font-weight:600;color:var(--mute-d);margin-bottom:6px}
.beta-input{width:100%;padding:12px 14px;border-radius:10px;border:1.5px solid #DCE6EE;background:#FFFFFF;color:var(--black);font-family:Inter,system-ui,sans-serif;font-size:.94rem;outline:none;transition:border-color .2s,box-shadow .2s}
.beta-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,47,74,.14)}

footer{border-top:1px solid var(--line);padding:70px 0 40px;font-size:.93rem;color:var(--mute)}
.fgrid{display:grid;grid-template-columns:1.4fr repeat(5,1fr);gap:28px}
footer h5{font-family:Sora,sans-serif;color:var(--white);font-size:.95rem;margin-bottom:12px;font-weight:600}
footer li{list-style:none;margin-bottom:8px}
footer a:hover{color:var(--gold)}
.fine{margin-top:50px;padding-top:24px;border-top:1px solid var(--line);font-size:.82rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}

/* motion: fade + slide, very subtle */
.rv{opacity:0;transform:translateY(18px);transition:opacity .75s ease,transform .75s ease}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}

@media (max-width:900px){
  section{padding:76px 0}.quote,.final{padding:96px 0}
  .links a:not(.btn){display:none}
  .hero{min-height:0;padding:44px 0 56px}
  .hero .wrap,.two{grid-template-columns:1fr;gap:40px}
  .grid{grid-template-columns:1fr 1fr}
  .stages{grid-template-columns:1fr;gap:26px}
  .steps{grid-template-columns:repeat(3,1fr);gap:20px}
  .steps::before{display:none}
  .fgrid{grid-template-columns:1fr 1fr}
}
@media (max-width:560px){
  .grid,.beta-row,.steps{grid-template-columns:1fr}
  .panel{padding:22px}
}
</style>
</head>

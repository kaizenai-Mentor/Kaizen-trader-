&lt;style&gt;

:root{--black:#0A0A0A;--white:#F4F8FB;--gold:#F5C518;--blue:#1A2F4A;--mute:#A3B1BF;--mute-d:#41566B;--line:#232B33;color-scheme:dark}

*{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}

body{font-family:Inter,system-ui,sans-serif;background:var(--black);color:var(--white);line-height:1.65;font-size:17px;font-variant-numeric:tabular-nums}

h1,h2,h3,.logo{font-family:Sora,system-ui,sans-serif;letter-spacing:-.02em;line-height:1.12}

a{color:inherit;text-decoration:none}

.wrap{max-width:1120px;margin:0 auto;padding:0 24px}

section{padding:130px 0}

.light{background:var(--white);color:var(--black)}

.light .sub{color:var(--mute-d)}

.sub{color:var(--mute);max-width:32em}

h2{font-size:clamp(2rem,4.2vw,3rem);font-weight:600;margin-bottom:22px}

:focus-visible{outline:3px solid var(--gold);outline-offset:3px}



/* buttons */

.btn{display:inline-block;padding:14px 26px;border-radius:12px;font-weight:500;border:1.5px solid transparent;transition:background .25s,color .25s,border-color .25s;cursor:pointer;font-family:inherit;font-size:1rem}

.btn.gold{background:var(--gold);color:var(--black)}

.btn.gold:hover{background:var(--white)}

.btn.blue{background:var(--blue);color:var(--white);border-color:var(--blue)}

.btn.blue:hover{border-color:var(--white)}



/* nav */

nav{position:sticky;top:0;z-index:20;background:rgba(10,10,10,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}

nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}

.logo{font-weight:700;font-size:1.3rem}

.links{display:flex;gap:30px;align-items:center;font-size:.95rem;color:var(--mute)}

.links a:hover,.links a.on{color:var(--gold)}

nav .btn{padding:10px 20px}



/* hero */

.hero{min-height:88vh;display:flex;align-items:center;padding:80px 0}

.hero .wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}

.hero h1{font-size:clamp(2.5rem,5.4vw,4.2rem);font-weight:700;margin-bottom:24px}

.hero .sub{margin-bottom:34px;font-size:1.1rem}

.cta{display:flex;gap:12px;flex-wrap:wrap}



/* UI mock panels */

.panel{background:var(--white);color:var(--black);border-radius:20px;padding:28px;box-shadow:0 30px 60px rgba(0,0,0,.45)}

.light .panel{box-shadow:0 24px 50px rgba(26,47,74,.18);border:1px solid #DCE6EE}

.panel h4{font-family:Sora,sans-serif;font-size:.95rem;font-weight:600;margin-bottom:6px}

.blk{padding:14px 0;border-top:1px solid #DCE6EE}

.blk:first-child{border-top:0;padding-top:0}

.blk p{font-size:.92rem;color:var(--mute-d);line-height:1.5}

.blk b{color:var(--black);font-weight:500}

.bar{height:8px;border-radius:9px;background:#DCE6EE;margin:8px 0 4px;overflow:hidden}

.bar i{display:block;height:100%;background:var(--gold);border-radius:9px}

.bar.b i{background:var(--blue)}

.kv{display:flex;justify-content:space-between;font-size:.88rem;color:var(--mute-d)}

.kv strong{color:var(--black);font-family:Sora,sans-serif}



.trust{padding:0 0 40px;text-align:center;color:var(--mute);font-size:1rem}



/* problem */

.problem .wrap{max-width:760px}

.chain{list-style:none;margin:48px 0}

.chain li{font-family:Sora,sans-serif;font-size:clamp(1.7rem,4vw,2.6rem);font-weight:600;padding-bottom:34px;position:relative;padding-left:34px}

.chain li::before{content:"";position:absolute;left:5px;top:.85em;width:2px;bottom:-.5em;background:var(--line)}

.chain li::after{content:"";position:absolute;left:0;top:.55em;width:12px;height:12px;border-radius:50%;background:var(--mute-d)}

.chain li:last-child::before{display:none}

.chain li:last-child::after{background:var(--gold)}

.problem .intro{font-family:Sora,sans-serif;font-size:1.4rem;font-weight:600}



/* meet */

.two{display:grid;grid-template-columns:1.25fr .85fr;gap:64px;align-items:center}

.sess .q{font-size:.95rem;padding:12px 14px;border-radius:12px;background:#E8EFF5;margin-top:10px;color:var(--black)}

.sess .a{font-size:.9rem;padding:12px 14px;border-radius:12px;background:var(--blue);color:var(--white);margin-top:10px}



/* how */

.steps{list-style:none;display:grid;grid-template-columns:repeat(6,1fr);gap:0;margin-top:56px;position:relative}

.steps::before{content:"";position:absolute;top:19px;left:8%;right:8%;height:2px;background:var(--line)}

.steps li{text-align:center;position:relative;padding:0 6px}

.steps .n{width:40px;height:40px;border-radius:50%;margin:0 auto 14px;background:var(--black);border:2px solid var(--mute-d);display:flex;align-items:center;justify-content:center;font-family:Sora,sans-serif;font-weight:600;font-size:.95rem}

.steps li:last-child .n{border-color:var(--gold);color:var(--gold)}

.steps span{font-size:.95rem;color:var(--mute)}



/* toolkit */

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}

.card{background:var(--white);color:var(--black);border-radius:18px;padding:30px}

.card h3{font-size:1.2rem;font-weight:600;margin-bottom:10px}

.card p{font-size:.95rem;color:var(--mute-d);line-height:1.55}



/* quote */

.quote{text-align:center;padding:170px 0}

.quote p{font-family:Sora,sans-serif;font-weight:700;font-size:clamp(2.2rem,6.4vw,5rem);line-height:1.08;letter-spacing:-.03em}

.quote p+p{color:var(--white)}

.quote p:first-child{color:var(--mute-d)}



/* journey */

.stages{list-style:none;display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin:52px 0 36px;position:relative}

.stages li{padding-top:34px;position:relative;border-top:2px solid #C9D6E2}

.stages li::before{content:"";position:absolute;top:-8px;left:0;width:14px;height:14px;border-radius:50%;background:var(--white);border:2px solid var(--blue)}

.stages li.done{border-top-color:var(--gold)}

.stages li.done::before{background:var(--gold);border-color:var(--gold)}

.stages h3{font-size:1.05rem;font-weight:600;margin-bottom:6px}

.stages p{font-size:.9rem;color:var(--mute-d);line-height:1.5}

.stronger{font-family:Sora,sans-serif;font-weight:600;font-size:1.25rem}



/* showcase */

.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:34px 0 22px}

.tab{background:none;border:1.5px solid var(--line);color:var(--mute);padding:9px 18px;border-radius:99px;font-family:inherit;font-size:.92rem;cursor:pointer;transition:all .25s}

.tab:hover{border-color:var(--blue);background:var(--blue);color:var(--white)}

.tab.on{border-color:var(--gold);color:var(--gold)}

.track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:20px;scrollbar-width:none}

.track::-webkit-scrollbar{display:none}

.slide{flex:0 0 min(640px,88%);scroll-snap-align:start}

.slide .panel{min-height:320px}

.nav2{display:flex;gap:10px;margin-top:22px}

.nav2 .btn{padding:10px 20px}



/* faq */

.faq .wrap{max-width:780px}

details{border-top:1px solid #C9D6E2;padding:22px 0}

details:last-child{border-bottom:1px solid #C9D6E2}

summary{cursor:pointer;font-family:Sora,sans-serif;font-weight:600;font-size:1.12rem;list-style:none;display:flex;justify-content:space-between;gap:16px}

summary::-webkit-details-marker{display:none}

summary::after{content:"+";color:var(--blue);font-size:1.4rem;line-height:1}

details[open] summary::after{content:"–"}

details p{margin-top:12px;color:var(--mute-d);max-width:38em}



/* final */

.final{text-align:center;padding:170px 0}

.final h2{font-size:clamp(2.4rem,6.2vw,4.8rem);font-weight:700;margin-bottom:26px}

.final h2 span{display:block;color:var(--mute-d)}

.final .sub{margin:0 auto 38px}



footer{border-top:1px solid var(--line);padding:70px 0 40px;font-size:.93rem;color:var(--mute)}

.fgrid{display:grid;grid-template-columns:1.4fr repeat(5,1fr);gap:28px}

footer h5{font-family:Sora,sans-serif;color:var(--white);font-size:.95rem;margin-bottom:12px;font-weight:600}

footer li{list-style:none;margin-bottom:8px}

footer a:hover{color:var(--gold)}

.fine{margin-top:50px;font-size:.82rem}



/* motion: fade + slide, very subtle */

.rv{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}

.rv.in{opacity:1;transform:none}

@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}



@media (max-width:900px){

  section{padding:76px 0}.quote,.final{padding:96px 0}

  .links a:not(.btn){display:none}

  .hero{min-height:0;padding:44px 0 56px}

  .hero .wrap,.two{grid-template-columns:1fr;gap:40px}

  .grid{grid-template-columns:1fr 1fr}

  .stages{grid-template-columns:1fr;gap:26px}

  .steps{grid-template-columns:repeat(6,120px);overflow-x:auto;padding-bottom:10px}

  .steps::before{left:60px;right:60px;width:auto}

  .fgrid{grid-template-columns:1fr 1fr}

}

@media (max-width:560px){.grid{grid-template-columns:1fr}.panel{padding:22px}}


.tab:hover{border-color:var(--blue);background:var(--blue);color:var(--white)}
.tab.on{border-color:var(--gold);color:var(--gold)}
.track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:20px;scrollbar-width:none}
.track::-webkit-scrollbar{display:none}
.slide{flex:0 0 min(640px,88%);scroll-snap-align:start}

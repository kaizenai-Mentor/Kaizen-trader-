# ============================================================================
# KAIZEN environment template
# Copy to .env for local development. NEVER commit real secrets.
# On Render, set these in the service's Environment settings.
# ============================================================================

# --- Core ---
MONGODB_URI=mongodb+srv://...
SESSION_SECRET=change-me

# --- Stacks wallet verification (Phase 1) ---
# 32-byte encryption key for wallet address storage (AES-256-GCM).
# Generate: openssl rand -hex 32
KAIZEN_WALLET_ENCRYPTION_KEY=

# Keyed HMAC secret used for wallet lookup fingerprints (min 16 chars).
# Generate: openssl rand -hex 24
KAIZEN_WALLET_HMAC_SECRET=

# mainnet (default) or testnet
STACKS_NETWORK=mainnet

# --- Hiro API (Phase 1B activity ingestion) ---
# Optional: a Hiro API key raises rate limits. Unauthenticated works too.
HIRO_API_KEY=
# Optional override, defaults to https://api.hiro.so (or testnet equivalent)
# HIRO_BASE_URL=https://api.hiro.so

# --- Integrations (existing) ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZA_API_KEY=
ZA_BASE_URL=https://zeroauthoritydao.com/api
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CONTRACT_ADDRESS=
MANTLE_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
APP_URL=https://kaizen-trader.onrender.com
TWELVE_DATA_API_KEY=
MARKETAUX_KEY=
CRON_KEY=

# ============================================================================
# KAIZEN environment template
# Copy to .env for local development. NEVER commit real secrets.
# On Render, set these in the service's Environment settings.
# ============================================================================

# --- Core ---
MONGODB_URI=mongodb+srv://...
SESSION_SECRET=change-me

# --- Stacks wallet verification (Phase 1) ---
# 32-byte encryption key for wallet address storage (AES-256-GCM).
# Generate: openssl rand -hex 32
KAIZEN_WALLET_ENCRYPTION_KEY=

# Keyed HMAC secret used for wallet lookup fingerprints (min 16 chars).
# Generate: openssl rand -hex 24
KAIZEN_WALLET_HMAC_SECRET=

# mainnet (default) or testnet
STACKS_NETWORK=mainnet

# --- Hiro API (Phase 1B activity ingestion) ---
# Optional: a Hiro API key raises rate limits. Unauthenticated works too.
HIRO_API_KEY=
# Optional override, defaults to https://api.hiro.so (or testnet equivalent)
# HIRO_BASE_URL=https://api.hiro.so

# --- AI providers (response generation + streaming) ---
# Priority: ANTHROPIC -> GEMINI -> OPENROUTER. The first key set wins; if a
# call fails, the next configured provider takes over. ANY ONE key is enough.
# Keys live ONLY here (local .env) or in the Render dashboard - never in chat.
ANTHROPIC_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional base-URL overrides (proxies, restricted networks, testing):
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# OPENROUTER_BASE_URL=

# --- Integrations (existing) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZA_API_KEY=
# API base URL; a host-only value is normalized to /api automatically.
ZA_BASE_URL=https://zeroauthoritydao.com/api
# ── Mantle (KaizenBenchmark.sol) ──────────────────────────────────────
# Reads need ONLY the contract address. Recording ALSO needs a private key.
# IMPORTANT: the deployer of the contract is its OWNER (onlyOwner guards
# every record function). Deploy with contracts/deploy-quick.js, then set
# MANTLE_CONTRACT_ADDRESS to the printed address and use the DEPLOYER key
# as MANTLE_PRIVATE_KEY. The deployed contract has NO transferOwnership
# function, so the key itself must match — run contracts/check-owner.js
# to confirm. Otherwise every record transaction reverts "Not authorized"
# — reverted transactions still appear in the explorer but record nothing.
# Full walkthrough: docs/MANTLE-GUIDE.md
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CONTRACT_ADDRESS=
MANTLE_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
APP_URL=https://kaizen-trader.onrender.com
TWELVE_DATA_API_KEY=
MARKETAUX_KEY=
CRON_KEY=
